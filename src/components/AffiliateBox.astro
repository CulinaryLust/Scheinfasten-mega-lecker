---
// Gekennzeichnete Affiliate-Empfehlungen. Nie auf der Krebs-Seite und nicht im Wissen-Bereich einsetzen.
// show: Wie viele Produkte sichtbar sind. Enthält items mehr, wählt der Browser bei jedem Seitenaufruf zufällig aus
// (ohne JavaScript bleiben die ersten sichtbar). show = 0 zeigt alle.
import { icon } from '../lib/icons.js';
import { amazonUrl } from '../data/affiliate.js';
import { u } from '../lib/url.js';
interface Props { items: any[]; title?: string; lead?: string; compact?: boolean; show?: number }
const { items, title = 'Das hilft dabei', lead, compact = false, show = 3 } = Astro.props;
const rot = show > 0 && items.length > show;
---
<aside class:list={['aff', 'noprint', { compact }]} aria-label="Anzeige: Produktempfehlungen" data-aff-show={rot ? show : undefined}>
  <div class="aff-head">
    <h2>{title}</h2>
    <span class="ad">Anzeige</span>
  </div>
  {lead && <p class="muted small">{lead}</p>}
  <ul>
    {items.map((p, i) => (
      <li hidden={rot && i >= show ? true : undefined}>
        <span class="ph"><img src={u(`img/produkte/${p.img || p.key}.jpg`)} alt="" loading="lazy" width="600" height="450" /><span class="ic" set:html={icon(p.icon || 'cart', 'i')} /></span>
        <span class="tx"><b>{p.title}</b><span class="muted small">{p.why}</span></span>
        <a class="btn small soft" href={amazonUrl(p)} target="_blank" rel="sponsored nofollow noopener" data-goatcounter-click={`partner-amazon-${p.key || "produkt"}`} data-goatcounter-title={p.title}>Hier entdecken<span class="sr-only"> bei Amazon: {p.title}</span></a>
      </li>
    ))}
  </ul>
  <p class="muted tiny">Die Links führen zu Amazon. Als Amazon-Partner verdienen wir an qualifizierten Verkäufen. Für Dich bleibt der Preis gleich. Fotos sind Symbolbilder. <a href={u('transparenz/')}>Mehr dazu</a></p>
</aside>
<style>
  .aff { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; display: grid; gap: 14px; }
  .aff-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .aff-head h2 { min-width: 0; overflow-wrap: anywhere; }
  .aff-head .ad { flex: none; margin-top: 6px; }
  .aff h2 { font-size: 1.35rem; }
  .ad { font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  li { display: grid; grid-template-rows: auto 1fr auto; gap: 10px; padding: 0 0 14px; border-radius: 16px; background: var(--bg); border: 1px solid var(--line); overflow: hidden; transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  li:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .ph { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--band); }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s var(--ease); }
  li:hover .ph img { transform: scale(1.05); }
  .ic { position: absolute; left: 10px; bottom: 10px; width: 34px; height: 34px; border-radius: 10px; background: var(--glass-strong); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); color: var(--green); display: grid; place-items: center; }
  .tx { display: grid; gap: 4px; min-width: 0; padding-inline: 14px; align-content: start; }
  .tx b { line-height: 1.25; }
  li .btn { margin-inline: 14px; background: var(--tomato); color: var(--on-tomato); }
  li .btn:hover { background: var(--tomato-d); }
  .compact ul { grid-template-columns: 1fr; gap: 10px; }
  .compact li { grid-template-columns: 96px minmax(0, 1fr); grid-template-rows: auto auto; padding: 0; gap: 0 12px; }
  .compact .ph { grid-row: 1 / 3; aspect-ratio: auto; height: 100%; min-height: 96px; }
  .compact .ic { display: none; }
  .compact .tx { padding: 10px 12px 4px 0; }
  .compact li .btn { margin: 4px 12px 10px 0; justify-self: start; }
  .tiny { font-size: .78rem; }
  li[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { li, .ph img { transition: none; } }
</style>

<script>
  // Wechselnde Anzeigen: aus allen passenden Produkten bei jedem Aufruf zufällig auswählen.
  document.querySelectorAll<HTMLElement>('[data-aff-show]').forEach((box) => {
    const n = Number(box.dataset.affShow);
    const lis = [...box.querySelectorAll('li')];
    const order = lis.map((_, i) => i);
    for (let i = order.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }
    // Möglichst keine zwei gleichen Symbolbilder nebeneinander
    const on = new Set<number>(), bilder = new Set<string>();
    const src = (i: number) => lis[i].querySelector('img')?.getAttribute('src') || '';
    order.forEach((i) => { if (on.size < n && !bilder.has(src(i))) { on.add(i); bilder.add(src(i)); } });
    order.forEach((i) => { if (on.size < n) on.add(i); });
    const ul = box.querySelector('ul')!;
    order.forEach((i) => ul.appendChild(lis[i]));
    lis.forEach((li, i) => { li.hidden = !on.has(i); });
  });
</script>
