---
// Studieneffekte (Wei 2017, Brandhorst 2024). compact: Startseite mit CRP und drei Kennzahlen, sonst alle.
import Icon from './Icon.astro';
import { u } from '../lib/url.js';
interface Props { compact?: boolean; tint?: boolean }
const { compact = false, tint = false } = Astro.props;
// CRP: Wei 2017, Tabelle 4 (Ausgangs-CRP über 1 mg/l, n = 26)
const crp = { value: '−1,6', unit: 'mg/l' };
// Effekte aus Wei et al. 2017 (Sci Transl Med, Tabelle 2 und 4) und Brandhorst et al. 2024
const effects = [
  { icon: 'scale', value: '−2,6', unit: 'kg', label: 'Körpergewicht', note: 'im Schnitt nach drei Zyklen, vor allem Fett' },
  { icon: 'tape', value: '−4', unit: 'cm', label: 'Taillenumfang', note: 'weniger Bauchfett, das als besonders ungünstig gilt' },
  { icon: 'pulse', value: '−6,7', unit: 'mmHg', label: 'Blutdruck', note: 'oberer Wert bei Teilnehmenden mit erhöhtem Blutdruck' },
  { icon: 'water', value: '−12', unit: 'mg/dl', label: 'Nüchtern\u00ADblutzucker', note: 'bei Teilnehmenden mit erhöhten Ausgangswerten' },
  { icon: 'cell', value: '−22', unit: 'ng/ml', label: 'Wachstums\u00ADfaktor IGF-1', note: 'ein Blutwert, den die Forschung mit Alterung verbindet' },
  { icon: 'hourglass', value: '−2,5', unit: 'Jahre', label: 'biologisches Alter', note: 'erster Hinweis aus einer Nachauswertung, noch kein Beweis', weak: true },
];
const shown = compact ? effects.slice(0, 3) : effects;
---
<section class:list={['band', 'effects', { tint, compact }]} id="studien">
  <div class="in">
    <div class="head"><p class="kicker">Was Studien zeigen</p><h2>Das hat Longos Studie gemessen</h2>{!compact && <p class="muted">In der wichtigsten Studie von Prof. Dr. Valter Longo aßen 100 gesunde Erwachsene drei Monate lang jeweils fünf Tage nach dem Scheinfasten-Prinzip. Danach normal. Das kam heraus:</p>}</div>
    <div class="card crp">
      <span class="fxi big"><Icon name="inflam" /></span>
      <div class="crptext">
        <p class="kicker">Im Fokus</p>
        <h3>Entzündungswert CRP</h3>
        {!compact && <p>Stille Entzündungen im Körper gelten als einer der Treiber von Alterung und vielen Zivilisationskrankheiten. Bei Teilnehmenden mit erhöhtem Entzündungswert CRP sank dieser nach drei Zyklen deutlich, um durchschnittlich <b>{crp.value} {crp.unit}</b>. Wer ohnehin niedrige Werte hatte, sah kaum eine Veränderung.</p>}
        {compact && <p>Bei erhöhtem Entzündungswert CRP sank er nach drei Zyklen im Schnitt um <b>{crp.value} {crp.unit}</b>.</p>}
      </div>
      <b class="fxv crpv"><span class="n">{crp.value}<small>{crp.unit}</small></span><span class="l">CRP</span></b>
    </div>
    <div class="fx">
      {shown.map((e) => (
        <div class:list={['card', 'fxcard', { weak: e.weak }]}>
          <span class="fxi"><Icon name={e.icon} /></span>
          <b class="fxv">{e.value}<small>{e.unit}</small></b>
          <span class="fxl">{e.label}</span>
          <span class="muted small">{e.note}</span>
        </div>
      ))}
    </div>
    {!compact && <p class="persist"><Icon name="check" /><span>Die meisten Effekte waren auch rund <b>drei Monate nach</b> dem letzten Durchgang noch messbar, obwohl wieder normal gegessen wurde.</span></p>}
    <p class="muted small fine">Durchschnittswerte, kein Heilversprechen. Die Studien nutzten das Fertigprodukt ProLon; selbst gekochtes Scheinfasten mit gleichen Nährwerten ist nicht eigens untersucht. Quellen: Wei M et al., Sci Transl Med 2017 · Brandhorst S et al., Nat Commun 2024. <a href={u(compact ? 'wissen/#studien' : 'wissen/')}>{compact ? 'Alle Effekte und Studien' : 'Alle Studien einordnen'}</a></p>
  </div>
</section>

<style>
  .fx { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 820px) { .fx { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .fx .card { padding: 14px; } .fxi { width: 38px; height: 38px; } }
  .crp { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 22px; align-items: center; margin-bottom: 16px; border: 2px solid var(--green); background: linear-gradient(120deg, var(--card) 55%, var(--tomato-soft)); padding: clamp(18px, 3vw, 30px); }
  .crp h3 { font-family: var(--display); font-size: clamp(1.5rem, 3vw, 2rem); margin: 4px 0 8px; }
  .crp p { margin: 0; }
  .fxi.big { width: 64px; height: 64px; border-radius: 18px; }
  .fxi.big :global(.i) { width: 34px; height: 34px; }
  .crpv { font-size: clamp(2.6rem, 6vw, 3.6rem) !important; display: grid; justify-items: end; }
  .crpv .n { white-space: nowrap; }
  .crpv .l { font-family: var(--body); font-size: .9rem; color: var(--muted); font-weight: 700; letter-spacing: .08em; }
  @media (max-width: 820px) { .crp { grid-template-columns: auto minmax(0, 1fr); gap: 14px; } .crptext { grid-column: 1 / -1; grid-row: 2; } .crpv { justify-items: end; } }
  .fxcard { display: grid; gap: 4px; align-content: start; }
  .fxi { width: 46px; height: 46px; border-radius: 14px; background: var(--tomato-soft); color: var(--tomato); display: grid; place-items: center; margin-bottom: 6px; }
  .fxi :global(.i) { width: 24px; height: 24px; }
  .fxv { font-family: var(--display); font-size: clamp(1.9rem, 4vw, 2.4rem); line-height: 1.05; color: var(--green); }
  .fxv small { font-size: .45em; margin-left: .25em; font-family: var(--body, inherit); font-weight: 700; }
  .fxl { font-weight: 700; }
  .fxcard.weak { border-style: dashed; }
  .fxcard.weak .fxv { color: var(--muted); }
  .persist { display: flex; gap: 10px; align-items: flex-start; margin-top: 22px; font-size: 1.05rem; }
  .persist :global(.i) { color: var(--green); flex: none; margin-top: 3px; }
  .fine { margin-top: 10px; max-width: 80ch; }
  @media (max-width: 820px) {
    .compact .fx { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .compact .fx .card { padding: 12px 10px; }
    .compact .fxcard .small { display: none; }
    .compact .fxv { font-size: 1.5rem; }
  }
</style>
