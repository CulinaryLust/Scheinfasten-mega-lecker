---
// Zwei Wege im Scheinfastenrechner: fertiger Plan (/planer/) und Do it yourself (/rechner/).
import Icon from './Icon.astro';
import { u } from '../lib/url.js';
interface Props { current: 'plan' | 'diy' }
const { current } = Astro.props;
const modes = [
  { key: 'plan', href: u('planer/'), icon: 'calendar', label: 'Fertiger 5-Tage-Plan', sub: 'mit wenig Aufwand' },
  { key: 'diy', href: u('rechner/'), icon: 'pot', label: 'Do it yourself', sub: 'aus Deinen Lebensmitteln' },
];
---
<nav class="in modenav" aria-label="Scheinfastenrechner">
  {modes.map((m) => (
    <a href={m.href} data-mode={m.key} aria-current={m.key === current ? 'page' : undefined}><Icon name={m.icon} /><span><b>{m.label}</b><small>{m.sub}</small></span></a>
  ))}
</nav>
<style>
  .modenav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding: 6px; background: var(--band); border-radius: 18px; margin-bottom: 18px; }
  .modenav a { display: flex; gap: 10px; align-items: center; justify-content: center; border-radius: 13px; padding: 10px 12px; min-height: 52px; text-decoration: none; color: var(--muted); }
  .modenav a span { display: grid; gap: 1px; }
  .modenav b { font-size: .98rem; line-height: 1.2; }
  .modenav small { font-size: .76rem; }
  .modenav a[aria-current="page"] { background: var(--card); color: var(--green); box-shadow: var(--shadow); }
  .modenav a:hover:not([aria-current="page"]) { color: var(--fg); }
  .modenav a:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .modenav :global(.i) { width: 1.3em; height: 1.3em; flex: none; }
  @media (max-width: 640px) { .modenav a { flex-direction: column; gap: 4px; text-align: center; padding: 8px 4px; } .modenav small { display: none; } .modenav b { font-size: .82rem; } }
</style>
