---
// Auffälliger Einstieg in den Rechner: kleine Live-Vorschau mit Tagesknöpfen und Kalorienbalken.
import Icon from './Icon.astro';
import { u } from '../lib/url.js';
const days = [
  { d: 1, st: 'hit', p: 100, txt: '1.090 kcal' },
  { d: 2, st: 'hit', p: 100, txt: '725 kcal' },
  { d: 3, st: 'under', p: 62, txt: '450 kcal' },
  { d: 4, st: '', p: 0, txt: 'offen' },
  { d: 5, st: '', p: 0, txt: 'offen' },
];
---
<section class="rteaser">
  <div class="in rt-in">
    <div class="rt-text">
      <p class="kicker rt-kick"><Icon name="scale" />Der Scheinfasten-Rechner</p>
      <h2>Wie viel geht heute noch?</h2>
      <p>Trag ein, was Du gegessen hast, und sieh sofort, wie viel von Deinem Tag nach Prof. Dr. Longo noch übrig ist. Triffst Du Dein Kalorienziel, leuchtet der Tag grün auf. Dazu gibt es Rezeptideen für den Rest.</p>
      <ul class="rt-pts">
        <li><Icon name="check" />Über 300 Lebensmittel und alle Rezepte</li>
        <li><Icon name="check" />Kalorien, Eiweiß, Fett und Kohlenhydrate auf einen Blick</li>
        <li><Icon name="check" />Ohne Anmeldung, alles bleibt auf Deinem Gerät</li>
      </ul>
      <a class="btn rt-btn" href={u('rechner/')}><Icon name="scale" />Rechner öffnen <Icon name="arrow" /></a>
    </div>
    <a class="rt-demo" href={u('rechner/')} aria-label="Zum Rechner">
      <div class="rt-card" aria-hidden="true">
        <p class="rt-label">Deine Fastenwoche</p>
        <div class="rt-days">
          {days.map((x, i) => <span class={`rt-day ${x.st}`} style={`--p:${x.p}%;--i:${i}`}><b>Tag {x.d}</b><small>{x.st === 'hit' ? '✓ ' : ''}{x.txt}</small></span>)}
        </div>
        <p class="rt-label">Heute, Tag 3</p>
        <div class="rt-bar"><span class="rt-fill"></span></div>
        <p class="rt-num"><b>450</b> von 725 kcal · noch 275 kcal</p>
        <div class="rt-sug"><Icon name="pot" /><span>Passt noch rein: <b>Pilz-Miso-Brühe</b></span></div>
      </div>
    </a>
  </div>
</section>

<style>
  .rteaser { padding-block: clamp(44px, 7vw, 84px); background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--sun) 22%, transparent), transparent 55%), linear-gradient(135deg, var(--green-d), var(--green)); color: #fff; }
  .rt-in { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  @media (max-width: 820px) { .rt-in { grid-template-columns: 1fr; } }
  .rt-kick { color: var(--sun); display: inline-flex; gap: 8px; align-items: center; }
  .rt-text h2 { font-size: clamp(2rem, 4.6vw, 3rem); margin: 6px 0 14px; color: #fff; }
  .rt-text p { color: rgba(255, 255, 255, .9); max-width: 52ch; }
  .rt-pts { list-style: none; padding: 0; margin: 18px 0 26px; display: grid; gap: 8px; }
  .rt-pts li { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .rt-pts :global(.i) { color: var(--sun); flex: none; }
  .rt-btn { background: var(--sun); color: #1e2a1c; font-size: 1.08rem; padding: 16px 26px; box-shadow: 0 12px 30px -12px rgba(0, 0, 0, .5); }
  .rt-btn:hover { background: #ffc95e; }
  .rt-demo { text-decoration: none; color: inherit; display: block; }
  .rt-card { background: var(--card); color: var(--fg); border-radius: var(--r-xl); padding: clamp(18px, 3vw, 28px); box-shadow: 0 30px 60px -28px rgba(0, 0, 0, .6); display: grid; gap: 12px; transform: rotate(-1.2deg); transition: transform .5s var(--ease); }
  .rt-demo:hover .rt-card { transform: rotate(0) translateY(-4px); }
  .rt-label { margin: 0; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .rt-days { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .rt-day { position: relative; overflow: hidden; isolation: isolate; display: grid; gap: 2px; text-align: center; padding: 10px 4px; border-radius: 12px; border: 1.5px solid var(--line); font-size: .85rem; }
  .rt-day small { font-size: .68rem; color: var(--muted); white-space: nowrap; }
  @media (max-width: 480px) { .rt-day { padding: 8px 2px; font-size: .78rem; } .rt-day small { font-size: .56rem; } }
  .rt-day::before { content: ""; position: absolute; inset: auto 0 0 0; height: 0; z-index: -1; background: var(--tone, transparent); animation: rtfill 1s var(--ease) forwards; animation-delay: calc(var(--i) * .25s + .3s); }
  .rt-day.hit { --tone: var(--green); border-color: var(--green); color: var(--bg); animation: rtglow 1s var(--ease) both; animation-delay: calc(var(--i) * .25s + 1.1s); }
  .rt-day.hit small { color: var(--bg); }
  .rt-day.under { --tone: color-mix(in srgb, color-mix(in oklab, var(--green) 62%, var(--sun)) 42%, transparent); }
  @keyframes rtfill { to { height: var(--p); } }
  @keyframes rtglow { 0% { color: var(--fg); } 40% { transform: scale(1.08); box-shadow: 0 0 22px 4px color-mix(in srgb, var(--sun) 60%, transparent); } 100% { transform: scale(1); } }
  .rt-day.hit small { animation: rtsmall 1s both; animation-delay: inherit; }
  @keyframes rtsmall { 0% { color: var(--muted); } 100% { color: var(--bg); } }
  .rt-bar { height: 14px; border-radius: 999px; background: var(--band); overflow: hidden; }
  .rt-fill { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--sun), var(--c-kcal)); animation: rtbar 1.4s var(--ease) .8s forwards; }
  @keyframes rtbar { to { width: 62%; } }
  .rt-num { margin: 0; font-size: .92rem; font-variant-numeric: tabular-nums; }
  .rt-num b { font-size: 1.3rem; font-family: var(--display); font-weight: 400; }
  .rt-sug { display: flex; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 14px; background: var(--ok-bg); font-size: .9rem; }
  .rt-sug :global(.i) { color: var(--green); flex: none; }
  @media (prefers-reduced-motion: reduce) {
    .rt-day::before { animation: none; height: var(--p); }
    .rt-day.hit, .rt-day.hit small { animation: none; }
    .rt-fill { animation: none; width: 62%; }
    .rt-card { transform: none; }
  }
</style>
