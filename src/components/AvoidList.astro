---
// Auf einen Blick: Was beim Scheinfasten wegbleibt, was nur in kleinen Mengen passt und was auf den Teller darf.
// Die Beispiele kommen aus der Lebensmitteldatenbank des Rechners, damit Ampel und Liste nie auseinanderlaufen.
import Icon from './Icon.astro';
import { u } from '../lib/url.js';
import foods from '../data/foods.json';
// compact: nur die roten Kategorien als Chipzeile (Startseite); die volle Liste steht auf „Wissen“.
interface Props { id?: string; tint?: boolean; compact?: boolean }
const { id = 'weglassen', tint = false, compact = false } = Astro.props;
const BY = Object.fromEntries(foods.map((f) => [f.name, f]));
const pick = (names: string[], light: string) => names.map((n) => {
  if (!BY[n]) throw new Error(`AvoidList: "${n}" fehlt in foods.json`);
  if (BY[n].light !== light) throw new Error(`AvoidList: "${n}" hat Ampel ${BY[n].light}, erwartet ${light}`);
  return n;
});
const red = [
  { title: 'Fleisch, Fisch und Eier', why: 'Prof. Dr. Longos Scheinfasten ist rein pflanzlich und eiweißarm (Wei 2017).', ex: pick(['Hähnchen', 'Rindfleisch', 'Salami', 'Lachs', 'Thunfisch', 'Eier'], 'r') },
  { title: 'Milchprodukte', why: 'Auch Käse und Joghurt machen fünf Tage Pause.', ex: pick(['Milch', 'Käse', 'Joghurt', 'Quark', 'Butter', 'Sahne'], 'r') },
  { title: 'Zucker und Süßes', why: 'Prof. Dr. Longos Vorgabe: wenig Zucker. Auch Honig und Trockenobst zählen dazu.', ex: pick(['Zucker', 'Honig', 'Schokolade', 'Kuchen', 'Datteln', 'Müsli'], 'r') },
  { title: 'Brot, Nudeln und Weißmehl', why: 'Viele Kalorien, wenig Sättigung. Gemüse bringt Dir mehr auf den Teller.', ex: pick(['Weißbrot', 'Mischbrot', 'Nudeln', 'Pizza', 'Croissant', 'Kartoffelchips'], 'r') },
  { title: 'Alkohol, Säfte und Softdrinks', why: 'Bringen Zucker oder Alkohol mit. Wasser und ungesüßter Tee sind jetzt Deine Getränke.', ex: pick(['Bier', 'Wein', 'Orangensaft', 'Cola', 'Smoothie'], 'r') },
  { title: 'Fleischersatz', why: 'Fast reines Eiweiß, und genau das hält Prof. Dr. Longo niedrig.', ex: pick(['Seitan', 'Tempeh', 'Sojagranulat', 'Veggie-Burger'], 'r') },
];
const yellow = pick(['Kartoffeln', 'Kichererbsen (gegart)', 'Linsen (gegart)', 'Hirse (gegart)', 'Reis (gegart)', 'Tofu', 'Apfel', 'Heidelbeeren', 'Knäckebrot', 'Kaffee', 'Schwarzer Tee'], 'y');
const green = ['Gemüse', 'Salat', 'Pilze', 'Olivenöl', 'Nüsse', 'Oliven', 'Avocado', 'Kräuter', 'Kräutertee', 'Wasser'];
---
{compact ? (
<section class:list={['band', 'avoid', 'compact', { tint }]} id={id}>
  <div class="in">
    <div class="head"><p class="kicker">Auf einen Blick</p><h2>Das lässt Du 5 Tage weg</h2></div>
    <ul class="redchips">{red.map((g) => <li><Icon name="ban" />{g.title}</li>)}</ul>
    <p class="okline"><span><span class="dot g"></span><b>Dafür auf dem Teller:</b>{' '}{green.join(', ')}.</span>{' '}<a href={u('wissen/#weglassen')}>Ganze Liste mit Beispielen</a></p>
  </div>
</section>
) : (
<section class:list={['band', 'avoid', { tint }]} id={id}>
  <div class="in">
    <div class="head">
      <p class="kicker">Auf einen Blick</p>
      <h2>Das lässt Du 5 Tage weg</h2>
      <p class="muted">Die Regel ist einfach: pflanzlich, wenig Eiweiß, wenig Zucker. Alles in Rot bleibt fünf Tage im Schrank, Gelbes gibt es in kleinen Mengen, Grünes darf auf den Teller. Der <a href={u('rechner/')}>Scheinfastenrechner</a> sagt Dir bei jedem Lebensmittel sofort, ob es passt, und schlägt einen leckeren Tausch vor.</p>
    </div>
    <div class="redgrid">
      {red.map((g) => (
        <article class="rcard">
          <span class="ri"><Icon name="ban" /></span>
          <div class="stack" style="gap:6px">
            <h3>{g.title}</h3>
            <p class="ex">{g.ex.join(' · ')}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="lights">
      <div class="lrow y"><span class="ltag"><span class="dot y"></span>Nur wenig</span><p>{yellow.join(' · ')}</p><p class="small muted">Sättigt gut, aber bringt Zucker oder Eiweiß mit. Der Rechner gibt Dir die genaue Menge. Kaffee: höchstens eine kleine Tasse schwarz am Tag, so empfiehlt es der ProLon-Hersteller; schwarzer oder grüner Tee statt Kaffee, nicht zusätzlich.</p></div>
      <div class="lrow g"><span class="ltag"><span class="dot g"></span>Darf auf den Teller</span><p>{green.join(' · ')}</p></div>
    </div>
  </div>
</section>
)}

<style>
  .redgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 900px) { .redgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
  @media (max-width: 520px) { .redgrid { grid-template-columns: 1fr; } }
  .rcard { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 14px; align-items: start; background: var(--bad-bg); border: 1.5px solid color-mix(in srgb, var(--bad) 35%, transparent); border-radius: var(--radius); padding: 16px 18px; }
  .rcard h3 { font-size: 1.15rem; }
  .ri { width: 40px; height: 40px; border-radius: 50%; background: var(--bad); color: #fff; display: grid; place-items: center; }
  .ri :global(.i) { width: 24px; height: 24px; stroke-width: 2.4; }
  .ex { font-weight: 700; font-size: .9rem; color: var(--bad); }
  .lights { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  @media (max-width: 820px) { .lights { grid-template-columns: 1fr; } }
  .lrow { border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 6px; align-content: start; }
  .lrow.y { background: var(--warn-bg); }
  .lrow.g { background: var(--ok-bg); }
  .lrow p:not(.small) { font-weight: 700; }
  .ltag { display: inline-flex; gap: 8px; align-items: center; font-size: .78rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; }
  .dot.g { background: var(--ok); } .dot.y { background: var(--sun); }
  .compact .head { margin-bottom: 18px; }
  .redchips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .redchips li { display: inline-flex; gap: 8px; align-items: center; background: var(--bad-bg); color: var(--bad); border: 1.5px solid color-mix(in srgb, var(--bad) 35%, transparent); border-radius: 999px; padding: 8px 14px; font-weight: 800; }
  .redchips :global(.i) { stroke-width: 2.4; }
  .okline { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; }
  .okline .dot { margin-right: 8px; vertical-align: 1px; }
  .okline a { font-weight: 700; }
</style>
