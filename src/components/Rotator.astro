---
// Wechselnde Fotos mit sanfter Überblendung. mode="bg": füllt den Elternblock (Hero), mode="card": abgerundetes Bild mit Rahmen.
// Fotos von Unsplash, IDs in tools/images.txt. Wechsel alle 5,5 s, pausiert bei reduzierter Bewegung und im Hintergrund-Tab.
import { u, webp } from '../lib/url.js';
interface Props { images: { src: string; alt: string }[]; mode?: 'bg' | 'card' | 'wide'; sizes?: string; badge?: string; first?: 'eager' | 'lazy' }
const { images, mode = 'card', sizes = '(max-width: 820px) 92vw, 520px', badge, first = 'lazy' } = Astro.props;
const [w, h] = mode === 'bg' ? [1800, 1000] : [1100, 825];
---
<div class:list={['rot', mode]} data-rot>
  {images.map((im, i) => (
    <picture class:list={{ on: i === 0 }}>
      <source type="image/webp" srcset={webp(im.src)} sizes={sizes} />
      <img src={u(im.src)} alt={i === 0 ? im.alt : ''} width={w} height={h} loading={i === 0 ? first : 'lazy'} fetchpriority={i === 0 && first === 'eager' ? 'high' : undefined} decoding="async" />
    </picture>
  ))}
  {badge && <span class="rbadge"><i></i>{badge}</span>}
</div>

<style>
  .rot { position: relative; }
  .rot picture { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s ease, transform 1.4s var(--ease); }
  .rot picture.on { opacity: 1; }
  .rot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rot.bg { position: absolute; inset: 0; }
  .rot.bg picture img { transform: scale(1.06); transition: transform 7s linear; }
  .rot.bg picture.on img { transform: scale(1); }
  .rot.card { aspect-ratio: 4 / 3; max-width: 100%; }
  .rot.card picture { transform: translateY(10px); }
  .rot.card picture.on { transform: none; }
  .rot.card img { border-radius: var(--r-lg); box-shadow: 0 24px 44px -26px rgba(20, 30, 16, .55); }
  .rot.wide { width: 100%; height: clamp(190px, 30vw, 320px); }
  .rot.wide img { border-radius: var(--r-lg); object-position: center 30%; }
  .rbadge { position: absolute; left: -10px; bottom: 18px; z-index: 2; background: var(--card); color: var(--fg); border-radius: 14px; padding: 10px 14px; font-weight: 700; font-size: .88rem; box-shadow: 0 14px 30px -18px rgba(0, 0, 0, .5); display: flex; gap: 8px; align-items: center; }
  .rbadge i { width: 10px; height: 10px; border-radius: 99px; background: var(--green); display: inline-block; }
  @media (max-width: 560px) { .rbadge { left: 10px; } }
  @media (prefers-reduced-motion: reduce) { .rot picture, .rot.bg picture img { transition: none; transform: none; } }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-rot]').forEach((root) => {
    const pics = [...root.querySelectorAll('picture')];
    if (pics.length < 2 || reduce) return;
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      const next = (i + 1) % pics.length;
      const img = pics[next].querySelector('img')!;
      if (!img.complete) { img.loading = 'eager'; return; }
      pics[i].classList.remove('on'); pics[next].classList.add('on'); i = next;
    }, 5500);
    // Nächstes Bild früh laden, damit der erste Wechsel nicht ruckelt
    setTimeout(() => pics.forEach((p) => { p.querySelector('img')!.loading = 'eager'; }), 1500);
  });
</script>
