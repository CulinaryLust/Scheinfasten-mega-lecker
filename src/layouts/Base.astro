---
import '@fontsource/young-serif/400.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url.js';

import { SITE_NAME } from '../data/site.js';
import { GOATCOUNTER_CODE } from '../data/statistik.js';
interface Props { title: string; description?: string; active?: string; image?: string; jsonLd?: object; noindex?: boolean; noCommerce?: boolean; ogType?: string }
const { title, description = 'Scheinfasten nach Prof. Dr. Valter Longo selbst kochen: über 50 pflanzliche Rezepte, auf das Gramm nach Prof. Dr. Longos Vorgaben berechnet, dazu ein kostenloser 5-Tage-Plan mit Einkaufsliste.', active = '', image = 'img/hero.jpg', jsonLd, noindex = false, noCommerce = false, ogType = 'website' } = Astro.props;
// Startseite: Suchbegriffe vorne, Marke hinten. Unterseiten: Seitentitel | Marke.
const fullTitle = title === 'Start' ? `Scheinfasten selbst kochen: Rezepte und 5-Tage-Plan | ${SITE_NAME}` : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(image), Astro.site);
const nav = [
  { key: 'start', href: u(''), label: 'Start', icon: 'home' },
  { key: 'rechner', href: u('planer/'), label: 'Scheinfastenrechner', short: 'Rechner', icon: 'scale' },
  { key: 'rezepte', href: u('rezepte/'), label: 'Rezepte', icon: 'pot' },
  { key: 'wissen', href: u('wissen/'), label: 'Wissen', icon: 'book' },
];
// Auf der Krebs-Seite keine Verweise auf Produktempfehlungen (HWG).
const cur = (k: string) => active === k || (k === 'rechner' && active === 'planer');
const extra = noCommerce ? [] : [{ key: 'ausstattung', href: u('ausstattung/'), label: 'Ausstattung' }];
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href={u('sitemap.xml')} />
  <meta name="theme-color" content="#3d7a2e" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: Rezepte`} href={u('pins.xml')} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="sr-only" href="#main">Zum Inhalt springen</a>
  <header class="top">
    <div class="in">
      <a class="logo" href={u('')}><span class="mark"><Icon name="leaf" /></span>Scheinfasten <span class="tag">einfach lecker fasten</span></a>
      <nav class="nav" aria-label="Hauptnavigation">
        {[...nav.slice(1), ...extra].map((n) => <a href={n.href} aria-current={cur(n.key) ? 'page' : undefined}>{n.label}</a>)}
        <a class="btn small" href={u('planer/')}>Plan erstellen</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="in">
      <p><b>{SITE_NAME}</b> · Rechner, Rezepte und Planer für das Scheinfasten nach Prof. Dr. Valter Longo.</p>
      <p>Unsere Rezepte folgen den Werten aus Prof. Dr. Longos Studien, die Nährwerte sind berechnet. Die Seite ersetzt keine ärztliche Beratung und ist kein Angebot von L-Nutra oder ProLon.</p>
      <nav aria-label="Rechtliches">
        <a href={u('ratgeber/')}>Ratgeber</a>
        <a href={u('fuer-wen-nicht/')}>Für wen nicht?</a>
        <a href={u('krebs/')}>Scheinfasten bei Krebs</a>
        {!noCommerce && <a href={u('ausstattung/')}>Ausstattung</a>}
        {!noCommerce && <a href={u('prolon-oder-selbst-kochen/')}>ProLon oder selbst kochen?</a>}
        <a href={u('impressum/')}>Impressum</a>
        <a href={u('datenschutz/')}>Datenschutz</a>
        <a href={u('so-arbeiten-wir/')}>So arbeiten wir</a>
        <a href={u('transparenz/')}>Transparenz</a>
      </nav>
      {!noCommerce && <p class="small">Diese Seite ist kostenlos und finanziert sich über gekennzeichnete Affiliate-Links. Als Amazon-Partner verdienen wir an qualifizierten Verkäufen.</p>}
      <p class="small">Fotos: Unsplash (Unsplash-Lizenz), Symbolbilder.</p>
      <p class="small">Prof. Dr. Valter Longo hat diese Seite weder geprüft noch unterstützt.{!noCommerce && <> ProLon® und Fasting Mimicking Diet® sind eingetragene Marken der L-Nutra Inc. Wir nennen sie nur, um auf das Produkt und die Studien zu verweisen.</>}</p>
    </div>
  </footer>
  <nav class="tabbar" aria-label="Schnellnavigation">
    {nav.map((n) => <a href={n.href} aria-current={cur(n.key) ? 'page' : undefined}><Icon name={n.icon} /><span>{n.short || n.label}</span></a>)}
  </nav>
  {GOATCOUNTER_CODE && <script is:inline data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
</body>
</html>
