---
import '@fontsource/young-serif/400.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url.js';

interface Props { title: string; description?: string; active?: string; image?: string; jsonLd?: object; noindex?: boolean }
const { title, description = 'Scheinfasten nach Prof. Dr. Valter Longo, aber mega lecker: durchgerechnete Rezepte und ein persönlicher 5-Tage-Planer.', active = '', image = 'img/hero.jpg', jsonLd, noindex = false } = Astro.props;
const fullTitle = title === 'Start' ? 'Scheinfasten mega lecker' : `${title} | Scheinfasten mega lecker`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(image), Astro.site);
const nav = [
  { key: 'start', href: u(''), label: 'Start', icon: 'home' },
  { key: 'planer', href: u('planer/'), label: 'Planer', icon: 'calendar' },
  { key: 'rezepte', href: u('rezepte/'), label: 'Rezepte', icon: 'pot' },
  { key: 'wissen', href: u('wissen/'), label: 'Wissen', icon: 'book' },
];
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="theme-color" content="#3d7a2e" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="sr-only" href="#main">Zum Inhalt springen</a>
  <header class="top">
    <div class="in">
      <a class="logo" href={u('')}><span class="mark"><Icon name="leaf" /></span>Scheinfasten <span>mega lecker</span></a>
      <nav class="nav" aria-label="Hauptnavigation">
        {nav.slice(1).map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
        <a class="btn small" href={u('ebook/')}>E-Book</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="in">
      <p><b>Scheinfasten mega lecker</b> · Rezepte und Planer, angelehnt an die Fasting Mimicking Diet nach Prof. Dr. Valter Longo.</p>
      <p>Diese Seite informiert und ersetzt keine ärztliche Beratung. Die Rezepte orientieren sich an den in Studien veröffentlichten Kalorien- und Nährstoffvorgaben, wurden selbst aber nicht in Studien getestet. Kein Angebot von L-Nutra oder ProLon. Nährwerte sind berechnet, nicht im Labor gemessen.</p>
      <nav aria-label="Rechtliches">
        <a href={u('fuer-wen-nicht/')}>Für wen nicht?</a>
        <a href={u('krebs/')}>Scheinfasten bei Krebs</a>
        <a href={u('ebook/')}>E-Book</a>
        <a href={u('impressum/')}>Impressum</a>
        <a href={u('datenschutz/')}>Datenschutz</a>
        <a href={u('transparenz/')}>Transparenz</a>
      </nav>
      <p class="small">Fotos: Unsplash (Unsplash-Lizenz), Symbolbilder.</p>
    </div>
  </footer>
  <nav class="tabbar" aria-label="Schnellnavigation">
    {nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}><Icon name={n.icon} /><span>{n.label}</span></a>)}
  </nav>
</body>
</html>
