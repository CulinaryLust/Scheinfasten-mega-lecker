---
import Rotator from '../components/Rotator.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u, webp } from '../lib/url.js';
import FastCompare from '../components/FastCompare.astro';
import AvoidList from '../components/AvoidList.astro';
import Effects from '../components/Effects.astro';
import { ARTIKEL } from '../data/ratgeber.js';
const studies = [
  { lv: 'ok', tag: 'Mensch · randomisiert', title: '100 Gesunde, 3 Zyklen', text: 'Körpergewicht, Bauchfett, Blutdruck und der Wachstumsfaktor IGF-1 sanken. Bei Menschen mit erhöhten Ausgangswerten war der Effekt größer.', src: 'Wei M et al. Science Translational Medicine 2017;9:eaai8700', doi: '10.1126/scitranslmed.aai8700' },
  { lv: 'warn', tag: 'Mensch · explorativ', title: 'Biologisches Alter', text: 'Eine Nachauswertung zweier Studien berechnete nach drei Zyklen ein im Median um 2,5 Jahre niedrigeres biologisches Alter. Ein Hinweis, noch kein Beweis.', src: 'Brandhorst S et al. Nature Communications 2024;15:1309', doi: '10.1038/s41467-024-45260-9' },
  { lv: 'bad', tag: 'Maus und kleine Pilotstudie', title: 'Der Ursprung', text: 'Bei Mäusen verbesserten regelmäßige Fastenzyklen viele Gesundheitsmarker. Eine kleine Pilotstudie am Menschen folgte.', src: 'Brandhorst S et al. Cell Metabolism 2015;22:86-99', doi: '10.1016/j.cmet.2015.05.012' },
  { lv: 'bad', tag: 'Tier und Zelle', title: 'Erste Spuren', text: 'Bei Mäusen regenerierten insulinbildende Zellen, und Symptome eines MS-Modells besserten sich. Ob das beim Menschen genauso ist, ist offen.', src: 'Cheng CW et al. Cell 2017 · Choi IY et al. Cell Reports 2016', doi: '10.1016/j.cell.2017.01.040' },
];
const faq = [
  ['Warum funktioniert Scheinfasten mit normalem Essen?', 'Beim Fasten reagiert der Körper nicht auf den leeren Teller an sich, sondern auf bestimmte Signale. Die wichtigsten sind wenig Zucker im Blut, wenig Eiweiß, vor allem bestimmte Aminosäuren, und insgesamt deutlich weniger Energie. Fehlen diese Nährstoffe, schaltet der Stoffwechsel auf Sparbetrieb: Er nutzt mehr Fett als Brennstoff, bildet Ketonkörper, und Wachstumssignale wie der Botenstoff IGF-1 gehen zurück.\n\nGenau hier setzt das Scheinfasten an. Die Mahlzeiten sind so zusammengesetzt, dass sie diese Signale möglichst wenig stören: rein pflanzlich, mit wenig Eiweiß und wenig Zucker, dafür mit Gemüse und gesunden Fetten aus Olivenöl, Nüssen und Oliven. Fett meldet dem Körper kaum Überfluss, macht aber satt. So isst Du jeden Tag kleine, echte Mahlzeiten, und Dein Stoffwechsel verhält sich trotzdem ähnlich wie beim Fasten.\n\nIn Prof. Dr. Longos Studien sanken dabei Blutzucker und IGF-1, und Ketonkörper stiegen. Direkt mit reinem Wasserfasten verglichen wurde das am Menschen bisher nicht. Wichtig ist deshalb, die Vorgaben einzuhalten: Schon eine Scheibe Käse oder ein Glas Saft bringt Eiweiß oder Zucker mit und schwächt den Effekt. Dafür ist der Scheinfastenrechner da.'],
  ['Ist Scheinfasten dasselbe wie Heilfasten?', 'Nein. Beim Heilfasten isst man tagelang fast nichts. Beim Scheinfasten isst Du fünf Tage lang kleine, genau zusammengesetzte Mahlzeiten mit rund 700 bis 1.100 kcal.'],
  ['Wie oft sollte ich scheinfasten?', 'In der wichtigsten Studie aßen die Teilnehmenden drei Monate lang einmal im Monat fünf Tage nach dem Scheinfasten-Prinzip, dazwischen normal (Wei 2017). Danach wurde nicht weiter untersucht, wie oft es auf Dauer sinnvoll ist.\n\nProf. Dr. Longo hat in Interviews eine Faustregel genannt: Wer gesund ist, sich viel bewegt und normalgewichtig ist, braucht es vermutlich nur etwa zweimal im Jahr. Wer Übergewicht oder erhöhte Werte hat, macht es eher häufiger, in der Studie zum Beispiel drei Monate lang einmal im Monat.\n\nFür den Einstieg heißt das: ein Durchgang, dann schauen, wie es Dir ging. Zwischen zwei Durchgängen sollten mindestens drei bis vier Wochen normale Ernährung liegen, damit Dein Körper alles wieder auffüllen kann. Öfter als einmal im Monat ist nicht untersucht.'],
  ['Für wen ist Scheinfasten nicht geeignet?', 'Nicht für Schwangere und Stillende, bei Untergewicht oder Essstörungen, Diabetes mit Insulin oder Tabletten, die den Blutzucker senken, und bei schweren Erkrankungen. Nimmst Du regelmäßig Medikamente, klär es vorher kurz ab. Bei Schwindel oder Herzrasen während der fünf Tage einfach abbrechen und normal essen. Mehr dazu unter „Für wen es nicht passt“.'],
  ['Darf ich Kaffee trinken?', 'Eine kleine Tasse schwarz am Tag ist okay, wenn es ohne nicht geht. Das empfiehlt der Hersteller des Fertigprodukts ProLon: außer Wasser nichts zusätzlich, höchstens eine kleine Tasse Kaffee ohne Zucker oder Zusätze. In den Studienpaketen war Tee enthalten (Brandhorst 2015: Kamillentee), zu Kaffee sagen die Studien nichts. Unser Tipp, ohne Studienbeleg: Wer sonst viel Kaffee trinkt, reduziert schon vor dem Start, damit Kopfschmerzen ausbleiben.'],
  ['Warum so wenig Eiweiß?', 'Wenig Eiweiß und wenig Zucker sind Kernbestandteile des Konzepts. Sie sollen die Stoffwechselsignale des Fastens nachahmen. Deshalb sind die Rezepte rein pflanzlich und die Hülsenfrüchte klein portioniert.'],
  ['Funktioniert die selbst gekochte Variante genauso wie das Fertigprodukt?', 'Das ist nicht untersucht. Die Studien wurden mit dem Fertigprodukt ProLon gemacht. Unsere Rezepte halten dieselben Kalorien- und Nährstoffvorgaben ein, sind aber nicht in Studien getestet.'],
  ['Brauche ich Nahrungsergänzungsmittel?', 'Das Fertigprodukt der Studien enthielt ein Präparat mit Vitaminen, Mineralstoffen und essenziellen Fettsäuren (Wei 2017). Ob Du für fünf Tage etwas ergänzen solltest, klärst Du am besten mit Deiner Ärztin oder Deinem Arzt.'],
];
---
<Base title="Scheinfasten nach Prof. Dr. Longo: Ablauf, Studien und Wirkung" active="wissen" description="Was die Forschung zur Fasting Mimicking Diet von Prof. Dr. Valter Longo zeigt, mit Evidenzstufe und Quellen.">
  <div class="in page-head narrow">
    <p class="kicker">Wissen</p>
    <h1>Was steckt hinter dem Scheinfasten?</h1>
  </div>
  <section class="band" style="padding-top:20px">
    <div class="in person">
      <Rotator images={[{ src: 'img/markt.jpg', alt: 'Gemüsestand auf einem Markt' }, { src: 'img/szenen/markt-stand.jpg', alt: '' }, { src: 'img/szenen/markt-paprika.jpg', alt: '' }]} />
      <div class="prose">
        <p class="kicker">Der Kopf hinter dem Scheinfasten</p>
        <h2>Prof. Dr. Valter Longo</h2>
        <p>Ohne ihn gäbe es diese Seite nicht. Valter Longo, 1967 in Genua geboren, verbrachte als Kind die Sommer bei seinen Großeltern im kalabrischen Molochio, einem Dorf, in dem auffallend viele Menschen über 100 Jahre alt werden. Mit 16 ging er in die USA, eigentlich um Jazzgitarre zu studieren. Die Frage, warum manche Menschen so lange gesund bleiben, ließ ihn aber nicht mehr los: Er wechselte zur Biochemie, promovierte an der University of California in Los Angeles und forschte im Labor des Kalorienrestriktions-Pioniers Roy Walford.</p>
        <p>Heute ist er Professor für Gerontologie und Biologie an der University of Southern California, leitet dort das Longevity Institute und zusätzlich ein Labor am IFOM in Mailand. Aus seiner Forschung an Zellen, Tieren und Menschen ist die Fasting Mimicking Diet entstanden, auf Deutsch meist Scheinfasten genannt. Seine Idee: den Stoffwechsel in einen fastenähnlichen Zustand bringen, ohne ganz auf Essen zu verzichten. So einfach das klingt, hat es das Fasten für viele Menschen deutlich leichter gemacht. Sein Buch ist auf Deutsch unter dem Titel „Iss dich jung“ erschienen.</p>
        <p class="muted">Gut zu wissen: Prof. Dr. Longo ist Gründer der Firma L-Nutra, die das Fertigprodukt ProLon verkauft. In den Studien wurde dieses Produkt verwendet. Diese Seite ist unabhängig und steht in keiner Verbindung zu Prof. Dr. Longo oder L-Nutra.</p>
      </div>
    </div>
  </section>
  <FastCompare tint />
  <section class="band">
    <div class="in">
      <div class="head"><h2>Die Vorgaben aus Prof. Dr. Longos Studien</h2><p class="muted">Diese Werte nutzen Rechner und Planer als Referenz (Brandhorst et al., Cell Metabolism 2015, Methoden). Die spätere Studie von Wei et al. 2017 nennt für Tag 1 ca. 1.100 kcal mit leicht anderen Anteilen (11 % Eiweiß, 46 % Fett, 43 % KH) und für Tag 2 bis 5 ca. 717 kcal mit denselben Anteilen. Zucker begrenzen wir zusätzlich auf höchstens 15 % der Kalorien, weil Prof. Dr. Longo nur „wenig Zucker“ ohne Zahl angibt. <a href={u('transparenz/')}>Alle Quellen</a></p></div>
      <div class="grid3">
        <div class="card"><p class="kicker">Tag 1</p><p class="big">1.090 kcal</p><div class="mbar"><i class="p" style="width:10%"></i><i class="f" style="width:56%"></i><i class="c" style="width:34%"></i></div><div class="legend"><span style="--dot:var(--c-protein)">10 % Eiweiß</span><span style="--dot:var(--c-fat)">56 % Fett</span><span style="--dot:var(--c-carbs)">34 % KH</span></div></div>
        <div class="card"><p class="kicker">Tag 2 bis 5</p><p class="big">725 kcal</p><div class="mbar"><i class="p" style="width:9%"></i><i class="f" style="width:44%"></i><i class="c" style="width:47%"></i></div><div class="legend"><span style="--dot:var(--c-protein)">9 % Eiweiß</span><span style="--dot:var(--c-fat)">44 % Fett</span><span style="--dot:var(--c-carbs)">47 % KH</span></div></div>
        <div class="card"><p class="kicker">Tag 6</p><p class="big">Übergang</p><p class="muted">In den Studien ging es danach direkt mit normaler Ernährung weiter. Unser Tipp: am ersten Tag leicht und pflanzlich starten.</p></div>
      </div>
    </div>
  </section>
  <AvoidList tint />
  <Effects />
  <section class="band tint">
    <div class="in">
      <div class="head"><h2>Wie belastbar ist das?</h2><p class="muted">Die Farbe zeigt, wie belastbar ein Ergebnis ist: grün für randomisierte Studien am Menschen, gelb für erste Daten am Menschen, rot für Tier- und Zellversuche.</p></div>
      <div class="grid3">
        {studies.map((s) => (
          <div class="card">
            <span class={`chip ${s.lv}`} style="justify-self:start">{s.tag}</span>
            <h3>{s.title}</h3><p>{s.text}</p>
            <p class="muted small"><a href={`https://doi.org/${s.doi}`} target="_blank" rel="noopener">{s.src}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="band">
    <div class="in narrow">
      <div class="head"><h2>Häufige Fragen</h2></div>
      <div class="faq">
        {faq.map(([q, a]) => <details><summary>{q}</summary>{a.split('\n\n').map((t) => <p>{t}</p>)}</details>)}
      </div>
      <div class="ctas" style="margin-top:24px"><a class="btn" href={u('planer/')}><Icon name="calendar" />Plan erstellen</a><a class="btn soft" href={u('prolon-oder-selbst-kochen/')}>ProLon oder selbst kochen?</a><a class="btn soft" href={u('fuer-wen-nicht/')}><Icon name="shield" />Für wen nicht?</a></div>
    </div>
  </section>
  <section class="band tint">
    <div class="in narrow">
      <div class="head"><h2>Praktisches aus dem Ratgeber</h2></div>
      <ul class="ratlist">{ARTIKEL.map((a) => <li><a href={u(`ratgeber/${a.slug}/`)}>{a.title}</a><span class="muted small">{a.teaser}</span></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .person { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 40px; align-items: center; }
  @media (max-width: 820px) { .person { grid-template-columns: 1fr; } }
  .person img { border-radius: 24px; aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  .big { font-family: var(--display); font-size: 2rem; }
  .faq { display: grid; gap: 10px; }
  .faq details { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 18px; }
  .faq summary { cursor: pointer; font-weight: 700; }
  .faq p { margin-top: 10px; }
  .ratlist { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .ratlist li { display: grid; gap: 2px; }
  .ratlist a { font-weight: 700; font-size: 1.05rem; }
</style>
