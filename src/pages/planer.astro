---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url.js';
import { icon } from '../lib/icons.js';
import foods from '../data/foods.json';
import { RECIPES } from '../lib/nutrition.js';
// Gruppe und Nährwerte nur für Zutaten, die in Rezepten vorkommen (für Kategorien und Makro-Symbole der Einkaufsliste)
const used = new Set(RECIPES.flatMap((r) => r.ingredients.map((i) => i.name)));
const foodMeta = Object.fromEntries(foods.filter((f) => used.has(f.name)).map((f) => [f.name, { group: f.group, n: f.n.slice(0, 4) }]));
const icons = Object.fromEntries(['kcal', 'protein', 'fat', 'carbs', 'oil', 'swap', 'check', 'close', 'cart', 'calendar', 'time', 'arrow', 'info', 'water', 'pot', 'leaf', 'nut', 'apple', 'herb', 'cup', 'ban'].map((k) => [k, icon(k)]));
import AffiliateBox from '../components/AffiliateBox.astro';
import Erinnerung from '../components/Erinnerung.astro';
import Rotator from '../components/Rotator.astro';
import { pick } from '../data/affiliate.js';
---
<Base title="Scheinfasten-Plan für 5 Tage mit Einkaufsliste" active="planer" description="Persönlicher Scheinfasten-Planer: Rezepte, Mengen und Nährwerte für jeden Tag, abgeglichen mit den Vorgaben von Prof. Dr. Valter Longo.">
  <div class="in page-head split">
    <div class="ph-text">
      <p class="kicker">Planer</p>
      <h1>Dein persönlicher 5-Tage-Plan</h1>
      <p class="muted">Ein paar Angaben, dann steht Dein Plan: jeden Tag leckere Gerichte, auf das Gramm genau nach den Werten von Prof. Dr. Valter Longo berechnet.</p>
    </div>
    <Rotator badge="Gemeinsam fasten macht mehr Spaß" images={[
      { src: 'img/menschen/freunde-tisch.jpg', alt: 'Freunde essen gemeinsam Salate am Tisch' },
      { src: 'img/menschen/kueche-zusammen.jpg', alt: '' },
      { src: 'img/menschen/genuss-kuechentisch.jpg', alt: '' },
      { src: 'img/menschen/schale-gemuese.jpg', alt: '' },
    ]} />
  </div>

  <section class="in wizard" id="wizard" data-base={u('')} data-icons={JSON.stringify(icons)} data-foods={JSON.stringify(foodMeta)}>

    <form id="f" class="card wcard" novalidate>
      <fieldset class="step" data-step="1">
        <legend class="sr-only">Über Dich</legend>
        <div class="field"><span class="lbl">Geschlecht</span>
          <div class="seg three">
            <label><input type="radio" name="sex" value="w" checked /><span>Weiblich</span></label>
            <label><input type="radio" name="sex" value="m" /><span>Männlich</span></label>
            <label><input type="radio" name="sex" value="d" /><span>Divers</span></label>
          </div>
        </div>
        <div class="row3">
          <div class="field"><label for="age" class="lbl">Alter</label><div class="unit"><input id="age" name="age" type="number" inputmode="numeric" min="10" max="100" value="42" required /><span>Jahre</span></div></div>
          <div class="field"><label for="h" class="lbl">Größe</label><div class="unit"><input id="h" name="h" type="number" inputmode="numeric" min="120" max="220" value="168" required /><span>cm</span></div></div>
          <div class="field"><label for="w" class="lbl">Gewicht</label><div class="unit"><input id="w" name="w" type="number" inputmode="decimal" min="35" max="250" step="0.5" value="70" required /><span>kg</span></div></div>
        </div>
        <div class="field"><span class="lbl">Wie aktiv ist Dein Alltag?</span>
          <div class="seg three">
            <label><input type="radio" name="pal" value="1.4" /><span>Eher sitzend<small>Büro, wenig Bewegung</small></span></label>
            <label><input type="radio" name="pal" value="1.6" checked /><span>Normal<small>viel auf den Beinen</small></span></label>
            <label><input type="radio" name="pal" value="1.8" /><span>Sehr aktiv<small>körperliche Arbeit, Sport</small></span></label>
          </div>
        </div>
        <div class="field"><span class="lbl">Fastet noch jemand mit?</span>
          <div class="seg four">
            <label><input type="radio" name="ppl" value="1" checked /><span>Nur ich</span></label>
            <label><input type="radio" name="ppl" value="2" /><span>2 Personen</span></label>
            <label><input type="radio" name="ppl" value="3" /><span>3 Personen</span></label>
            <label><input type="radio" name="ppl" value="4" /><span>4 Personen</span></label>
          </div>
        </div>
        <div class="others" id="others">
          {[2, 3, 4].map((n) => (
            <div class="other" data-p={n} hidden>
              <p class="lbl">Person {n}</p>
              <div class="row4">
                <div class="field"><label for={`p${n}sex`} class="sr-only">Geschlecht Person {n}</label>
                  <select id={`p${n}sex`} name={`p${n}sex`}><option value="w">Weiblich</option><option value="m">Männlich</option><option value="d">Divers</option></select></div>
                <div class="field"><div class="unit"><input aria-label={`Alter Person ${n}`} name={`p${n}age`} type="number" inputmode="numeric" min="10" max="100" value="42" /><span>Jahre</span></div></div>
                <div class="field"><div class="unit"><input aria-label={`Größe Person ${n}`} name={`p${n}h`} type="number" inputmode="numeric" min="120" max="220" value="175" /><span>cm</span></div></div>
                <div class="field"><div class="unit"><input aria-label={`Gewicht Person ${n}`} name={`p${n}w`} type="number" inputmode="decimal" min="35" max="250" step="0.5" value="75" /><span>kg</span></div></div>
              </div>
            </div>
          ))}
          <p class="muted small" id="others-note" hidden>Jede Person bekommt ihre eigene Portionsgröße. Einkaufsliste und Kochmengen rechnen wir für alle zusammen. Für Mitfastende nehmen wir einen normal aktiven Alltag an.</p>
        </div>
        <h3 class="sub">Termine</h3>
        <p class="muted small">Gefastet wird immer 5 Tage. Dazu kommen ein Vorbereitungstag davor und ein Übergangstag danach.</p>
        <div class="field"><label for="start" class="lbl">Wann startest Du? (Tag 1)</label><input id="start" name="start" type="date" required /></div>
        <div class="field"><span class="lbl">Wie viele Durchgänge planst Du?</span>
          <div class="seg three">
            <label><input type="radio" name="cyc" value="1" /><span>1 Durchgang<small>zum Ausprobieren</small></span></label>
            <label><input type="radio" name="cyc" value="3" checked /><span>3 Durchgänge<small>wie in der Studie</small></span></label>
            <label><input type="radio" name="cyc" value="6" /><span>6 Durchgänge<small>übers Jahr verteilt</small></span></label>
          </div>
        </div>
        <div class="field"><label for="gap" class="lbl">Abstand zwischen den Durchgängen</label>
          <select id="gap" name="gap"><option value="1">monatlich (wie in der Studie)</option><option value="2">alle 2 Monate</option><option value="3" selected>alle 3 Monate</option><option value="4">alle 4 Monate</option></select>
        </div>
        <p class="hint"><Icon name="heart" /><span>Kurz zur Sicherheit: Wenn Du schwanger bist, stillst, Medikamente nimmst oder eine ernste Erkrankung hast, sprich vorher kurz mit Deiner Ärztin oder Deinem Arzt. <a href={u('fuer-wen-nicht/')}>Mehr dazu</a></span></p>
        <p class="err" id="err1" role="alert" hidden></p>
        <div class="nav-btns"><span></span><button type="submit" class="btn">Plan erstellen <Icon name="check" /></button></div>
      </fieldset>

    </form>
  </section>

  <section class="in result" id="result" hidden aria-live="polite"></section>
  <Erinnerung />
  <div class="in narrow" style="padding-block:24px 56px"><AffiliateBox items={pick('waage', 'dosen', 'thermo')} title="Für Deine Fastenwoche" lead="Mit diesen drei Helfern klappen Einkauf und Vorkochen leichter." /></div>
</Base>

<style is:global>
  .wizard { display: grid; gap: 18px; max-width: 760px; padding-bottom: 60px; }
  .progress { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .progress li { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: .9rem; color: var(--muted); padding-bottom: 10px; border-bottom: 4px solid var(--line); }
  .progress li span { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--line); color: var(--fg); font-size: .85rem; flex: none; }
  .progress li.on { color: var(--fg); border-color: var(--tomato); }
  .progress li.on span { background: var(--tomato); color: var(--on-tomato); }
  .wcard { padding: clamp(18px, 4vw, 30px); }
  .seg.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 560px) { .seg.four { grid-template-columns: 1fr 1fr; } }
  .others { display: grid; gap: 14px; }
  .other { display: grid; gap: 8px; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
  .other .lbl { margin: 0; }
  .row4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 560px) { .row4 { grid-template-columns: 1fr 1fr; } }
  .meal li small { color: var(--muted); }
  .step { border: 0; padding: 0; margin: 0; display: grid; gap: 20px; min-width: 0; }

  .result { display: grid; gap: 26px; padding-bottom: 70px; }
  .bftoggle { grid-column: 1 / -1; display: flex; gap: 12px; align-items: flex-start; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; margin-block: 14px; cursor: pointer; }
  .bftoggle input { width: 22px; height: 22px; margin-top: 2px; flex: none; accent-color: var(--green); }
  .bftoggle span { display: grid; gap: 4px; }
  .rhead { display: flex; justify-content: space-between; align-items: end; gap: 14px; flex-wrap: wrap; }
  .tabs { display: flex; gap: 8px; overflow-x: auto; padding-block: 10px; position: sticky; top: calc(64px + env(safe-area-inset-top, 0px)); background: var(--glass); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); z-index: 5; scrollbar-width: none; }
  .tab { flex: none; display: grid; gap: 1px; text-align: left; font: inherit; color: var(--fg); background: var(--card); border: 1.5px solid var(--line); border-radius: var(--r-sm); padding: 8px 14px; min-height: 48px; cursor: pointer; min-width: 92px; transition: background var(--dur) var(--ease), color var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .tab:active { transform: scale(.96); }
  .tab b { font-size: .95rem; } .tab span { font-size: .75rem; color: var(--muted); }
  .tab[aria-selected="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .tab[aria-selected="true"] span { color: inherit; opacity: .75; }
  .daycard { display: grid; gap: 16px; }
  .daytop { display: grid; gap: 12px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
  .daytop .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .meal { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; }
  @media (max-width: 560px) { .meal { grid-template-columns: 76px minmax(0, 1fr); gap: 12px; } }
  .meal img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; }
  .meal .when { font-size: .75rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: var(--tomato); }
  .meal h3 { font-size: 1.12rem; }
  .meal h3 a { color: inherit; text-decoration: none; } .meal h3 a:hover { text-decoration: underline; }
  .meal .info { display: grid; gap: 8px; min-width: 0; }
  .meal .por { font-size: .8rem; color: var(--muted); }
  .meal details summary { cursor: pointer; font-weight: 700; color: var(--green); font-size: .92rem; }
  .meal ul { margin: 8px 0 0; padding-left: 18px; columns: 2; column-gap: 22px; font-size: .9rem; }
  @media (max-width: 560px) { .meal ul { columns: 1; } }
  .meal .acts { display: flex; gap: 8px; flex-wrap: wrap; }
  .swapbox { grid-column: 1 / -1; display: grid; gap: 8px; border-top: 1px dashed var(--line); padding-top: 12px; }
  .alt { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 12px; align-items: center; text-align: left; font: inherit; color: var(--fg); background: var(--bg); border: 1.5px solid var(--line); border-radius: 14px; padding: 8px; cursor: pointer; }
  .alt:hover { border-color: var(--green); }
  a.alt { text-decoration: none; }
  .alt img { width: 56px; height: 56px; object-fit: cover; border-radius: 10px; }
  .alt b { display: block; font-size: .95rem; } .alt small { color: var(--muted); }
  .plain { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; display: grid; gap: 12px; }
  .plain ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .shopcats { columns: 2; column-gap: 28px; margin-top: 10px; }
  @media (max-width: 600px) { .shopcats { columns: 1; } }
  .shopcat { break-inside: avoid; margin-bottom: 18px; }
  .shopcat h4 { display: flex; gap: 8px; align-items: center; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding-bottom: 6px; border-bottom: 2px solid var(--line); margin: 0; }
  .shopcat h4 .i { color: var(--green); }
  .maclegend { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .maclegend .mac:not(:first-child) { margin-left: 6px; }
  .shop { list-style: none; padding: 0; margin: 0; }
  .shop li { break-inside: avoid; border-bottom: 1px solid var(--line); }
  .shop label { display: flex; gap: 10px; padding: 9px 0; cursor: pointer; align-items: center; }
  .shop input { width: 20px; height: 20px; min-height: 0; accent-color: var(--green); }
  .shop input:checked + span { opacity: .45; text-decoration: line-through; }
  .step h3.sub { font-size: 1.25rem; margin-top: 8px; }
  .nextcyc { margin-top: 16px; }
  .nextcyc ul { margin: 8px 0 0; }
  @media print {
    .tabs, .wizard, .acts, .swapbox { display: none !important; }
    .daycard[hidden] { display: grid !important; }
    .meal { break-inside: avoid; }
    .meal details { display: block; } .meal details > * { display: block; }
  }
</style>

<script>
  import { RECIPES, BY_SLUG, PLAN, nutrition, add, check, shares, amountLabel, fmt } from '../lib/nutrition.js';
  import { groupByCat, macroOf, MACROS } from '../lib/foodmeta.js';
  import { thumb } from '../lib/url.js';

  const root = document.getElementById('wizard')!;
  const base = root.dataset.base!;
  const I = JSON.parse(root.dataset.icons!);
  const FM: Record<string, any> = JSON.parse(root.dataset.foods!);
  const mac = (name: string) => {
    const m = macroOf(FM[name]);
    if (!m) return '<span class="mac none" aria-hidden="true"></span>';
    const lbl = MACROS[m.key as keyof typeof MACROS];
    return `<span class="mac ${m.key}" title="Liefert vor allem ${lbl} (${m.share} % der Kalorien)">${I[m.key]}<span class="sr-only">${lbl}:</span></span>`;
  };
  const form = document.getElementById('f') as HTMLFormElement;
  const result = document.getElementById('result')!;
  const STORE = 'smlPlaner';
  const ZERO = nutrition({ ingredients: [] } as any);

  // Startdatum: nächster Montag
  const d0 = new Date(); d0.setDate(d0.getDate() + ((8 - d0.getDay()) % 7 || 7));
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  (form.start as HTMLInputElement).value = iso(d0);

  let state: any = { swaps: {} };
  try { const s = JSON.parse(localStorage.getItem(STORE) || 'null'); if (s) state = s; } catch {}
  if (state.inputs) {
    for (const [k, v] of Object.entries(state.inputs)) {
      const el = form.elements.namedItem(k) as any;
      if (!el) continue;
      if (el instanceof RadioNodeList) { for (const r of Array.from(el) as HTMLInputElement[]) r.checked = r.value === v; } else el.value = v;
    }
  }
  const save = () => { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch {} };

  function go(step: number) {
    if (step > 1 && !valid1()) return;
    form.querySelectorAll<HTMLElement>('.step').forEach((s) => (s.hidden = s.dataset.step !== String(step)));
    root.querySelectorAll<HTMLElement>('.progress li').forEach((li) => li.classList.toggle('on', Number(li.dataset.s) <= step));
    root.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function valid1() {
    const age = +form.age.value, h = +form.h.value, w = +form.w.value;
    const e = document.getElementById('err1')!;
    let msg = '';
    if (!age || age < 10 || age > 100) msg = 'Bitte gib ein Alter zwischen 10 und 100 Jahren ein.';
    else if (!h || h < 120 || h > 220) msg = 'Bitte gib eine Größe zwischen 120 und 220 cm ein.';
    else if (!w || w < 35 || w > 250) msg = 'Bitte gib ein Gewicht zwischen 35 und 250 kg ein.';
    const ppl = Number((form.elements.namedItem('ppl') as RadioNodeList).value || 1);
    for (let n = 2; n <= ppl && !msg; n++) {
      const a = +(form.elements.namedItem(`p${n}age`) as HTMLInputElement).value, hh = +(form.elements.namedItem(`p${n}h`) as HTMLInputElement).value, ww = +(form.elements.namedItem(`p${n}w`) as HTMLInputElement).value;
      if (!a || a < 10 || a > 100 || !hh || hh < 120 || hh > 220 || !ww || ww < 35 || ww > 250) msg = `Bitte prüfe die Angaben für Person ${n}: Alter 10 bis 100 Jahre, Größe 120 bis 220 cm, Gewicht 35 bis 250 kg.`;
    }
    e.textContent = msg; e.hidden = !msg;
    if (msg) go1();
    return !msg;
  }
  function go1() { form.querySelectorAll<HTMLElement>('.step').forEach((s) => (s.hidden = s.dataset.step !== '1')); root.querySelectorAll<HTMLElement>('.progress li').forEach((li) => li.classList.toggle('on', li.dataset.s === '1')); }
  const syncPeople = () => {
    const n = Number((form.elements.namedItem('ppl') as RadioNodeList).value || 1);
    root.querySelectorAll<HTMLElement>('.other').forEach((el) => (el.hidden = Number(el.dataset.p) > n));
    document.getElementById('others-note')!.hidden = n < 2;
  };
  form.querySelectorAll<HTMLInputElement>('input[name="ppl"]').forEach((r) => r.addEventListener('change', syncPeople));
  syncPeople();
  form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.next))));

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (!valid1()) return;
    const fd = new FormData(form);
    state.inputs = Object.fromEntries(fd.entries());
    save();
    render();
  });

  // Portionsfaktor = geschätzter Bedarf (Mifflin-St Jeor × Aktivität) / 2000, begrenzt auf 0,9 bis 1,15
  function person(sex: string, age: number, h: number, w: number, pal: number) {
    const bmi = w / Math.pow(h / 100, 2);
    const off = sex === 'm' ? 5 : sex === 'w' ? -161 : -78;
    const tdee = (10 * w + 6.25 * h - 5 * age + off) * pal;
    const raw = tdee / 2000;
    return { age, bmi, tdee, raw, f: Math.min(1.15, Math.max(0.9, raw)) };
  }
  function profile() {
    const v = state.inputs;
    const me = person(v.sex, +v.age, +v.h, +v.w, +v.pal);
    const ppl = Math.min(4, Math.max(1, +(v.ppl || 1)));
    const others = [];
    for (let n = 2; n <= ppl; n++) others.push({ n, ...person(v[`p${n}sex`], +v[`p${n}age`], +v[`p${n}h`], +v[`p${n}w`], 1.6) });
    const fAll = me.f + others.reduce((s, o) => s + o.f, 0);
    return { ...me, ppl, others, fAll };
  }

  // Tagesplan inkl. Tauschungen. Variante „Mit Frühstück“ hat eigene Tauschungen, weil die Mahlzeiten andere sind.
  const bf = () => !!state.breakfast && !!PLAN.breakfastDays;
  const swapKey = () => (bf() ? 'swapsBf' : 'swaps');
  function items(day: number) {
    return (bf() ? PLAN.breakfastDays : PLAN.days)[day].map((it: any, idx: number) => {
      const s = state[swapKey()]?.[day]?.[idx];
      return s ? { ...it, recipe: s.recipe, portion: s.portion, swapped: true } : { ...it };
    });
  }
  const total = (list: any[], f: number) => list.reduce((acc, it) => add(acc, nutrition(BY_SLUG[it.recipe], it.portion * f)), ZERO);
  const r5 = (x: number) => Math.round(x * 20) / 20;

  function candidates(day: number, idx: number, f: number) {
    const list = items(day); const cur = list[idx];
    const curK = nutrition(BY_SLUG[cur.recipe], cur.portion).kcal;
    const used = new Set(list.map((x: any) => x.recipe));
    const pool = RECIPES.filter((r: any) => r.slot === cur.type && !used.has(r.slug) && !['nussmix', 'oliven'].includes(r.slug));
    return pool.map((r: any) => {
      const portion = r5(Math.min(1.4, Math.max(0.7, cur.portion * curK / nutrition(r).kcal)));
      const next = list.map((x: any, i: number) => (i === idx ? { ...x, recipe: r.slug, portion } : x));
      const c = check(day, total(next, f), f);
      const sh = c.shares; const ref = c.ref;
      const score = Math.abs(sh.protein - ref.protein) + Math.abs(sh.fat - ref.fat) + Math.abs(sh.carbs - ref.carbs);
      return { r, portion, ok: c.ok, score, kcal: nutrition(r, portion * f).kcal };
    }).sort((a: any, b: any) => (Number(b.ok) - Number(a.ok)) || a.score - b.score).slice(0, 8);
  }

  const addDays = (d: Date, n: number) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
  const addMonths = (d: Date, n: number) => { const x = new Date(d); x.setMonth(x.getMonth() + n); return x; };
  const WD = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  const ds = (d: Date) => `${WD[d.getDay()]}, ${d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' })}`;
  const dsl = (d: Date) => `${WD[d.getDay()]}, ${d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}`;
  const img = (r: any) => thumb(base, r.image);
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  let tab = 1;
  let openSwap = '';

  function render() {
    const p = profile();
    // Freundliche Hinweise statt Sperre: der Plan wird immer erstellt.
    const notes: string[] = [];
    if (p.age < 18) notes.push('Du bist unter 18. In diesem Alter wächst der Körper noch, deshalb ist Scheinfasten eher nichts für Dich. Die Rezepte kannst Du natürlich trotzdem nachkochen.');
    if (p.age > 70) notes.push('Ab 70 lohnt sich vorher ein kurzes Gespräch mit Deiner Ärztin oder Deinem Arzt.');
    if (p.bmi < 18.5) notes.push('Dein Gewicht ist für Deine Größe eher niedrig. Sprich bitte vorher mit Deiner Ärztin oder Deinem Arzt.');
    result.hidden = false;
    root.hidden = true;
    const start = new Date((state.inputs.start || iso(d0)) + 'T12:00:00');
    const cyc = +state.inputs.cyc, gap = +state.inputs.gap;
    const f = p.f;

    // Abgleich-Tabelle
    let rows = '';
    for (let d = 1; d <= 5; d++) {
      const n = total(items(d), f); const c = check(d, n, f); const ref = c.ref;
      rows += `<tr><td><b>Tag ${d}</b></td><td class="n">${fmt(n.kcal)}<br><small class="muted">Ziel ${fmt(c.target)}</small></td>
        <td class="n">${fmt(n.protein)} g<br><small class="muted">${fmt(c.shares.protein)} % · Longo ${ref.protein} %</small></td>
        <td class="n">${fmt(n.fat)} g<br><small class="muted">${fmt(c.shares.fat)} % · Longo ${ref.fat} %</small></td>
        <td class="n">${fmt(n.oil)} g</td>
        <td class="n">${fmt(n.carbs)} g<br><small class="muted">${fmt(c.shares.carbs)} % · Longo ${ref.carbs} %</small></td>
        <td class="n">${fmt(n.sugar)} g<br><small class="muted">${fmt(c.sugarPct)} % · max. ${PLAN.reference.sugarMaxPercent} %</small></td>
        <td>${c.ok ? `<span class="chip ok">${I.check} passt</span>` : '<span class="chip warn">knapp daneben</span>'}</td></tr>`;
    }
    const tabs = [[0, 'Vorbereitung', ds(addDays(start, -1))], ...[1, 2, 3, 4, 5].map((d) => [d, `Tag ${d}`, ds(addDays(start, d - 1))]), [6, 'Tag 6', ds(addDays(start, 5))]];

    result.innerHTML = `
      <div class="rhead"><div class="stack" style="gap:6px"><p class="kicker">Dein Plan</p><h2>Start am ${dsl(start)}</h2></div>
        <div class="ctas noprint"><button class="btn soft small" data-edit>Angaben ändern</button><button class="btn soft small" onclick="window.print()">Drucken</button></div></div>
      <div class="sumbar">
        <div class="stat"><span>Dein Tagesbedarf (ohne Fasten)</span><b>${fmt(p.tdee)} kcal</b></div>
        <div class="stat"><span>Tag 1 (Starttag)</span><b>${fmt(1090 * f)} kcal</b></div>
        <div class="stat"><span>Tag 2 bis 5</span><b>${fmt(725 * f)} kcal</b></div>
      <label class="bftoggle noprint"><input type="checkbox" id="bf" ${bf() ? 'checked' : ''}><span><b>Mit Frühstück</b><small class="muted">Statt Nussmix gibt es morgens ein echtes Frühstück mit etwa 150 bis 200 kcal. Mittag- und Abendessen werden dafür um 15 % kleiner. Jeder Tag bleibt in Longos Rahmen.</small></span></label>
      </div>
      ${notes.length ? `<div class="alert info">${notes.map((n) => `<p>${n}</p>`).join('')}</div>` : p.bmi < 20 ? '<div class="alert info"><p>Dein Gewicht ist eher niedrig. Hör gut auf Deinen Körper und iss normal weiter, wenn Du Dich schlapp fühlst.</p></div>' : ''}
      ${p.raw < 0.9 ? '<div class="alert info"><p>Wir verkleinern die Portionen um höchstens 10 %, damit Du genug isst.</p></div>' : ''}
      ${p.ppl > 1 ? `<details class="plain"><summary><b>Portionen für ${p.ppl} Personen</b> <span class="muted small">(so teilst Du den Topf auf)</span></summary>
        <div class="tw"><table><thead><tr><th>Person</th><th>Bedarf, geschätzt</th><th>Portionsfaktor</th><th>Anteil am Topf</th><th>Tag 1</th><th>Tag 2 bis 5</th></tr></thead><tbody>
        ${[{ n: 1, ...p }, ...p.others].map((o: any) => `<tr><td><b>${o.n === 1 ? 'Du' : `Person ${o.n}`}</b></td><td class="n">${fmt(o.tdee)} kcal</td><td class="n">×${fmt(o.f, 2)}</td><td class="n">${fmt(o.f / p.fAll * 100)} %</td><td class="n">${fmt(1090 * o.f)} kcal</td><td class="n">${fmt(725 * o.f)} kcal</td></tr>`).join('')}
        </tbody></table></div>
        <p class="muted small">Die Nährwerte im Plan gelten für Dich. Bei den anderen ändern sich nur die Mengen, die Anteile von Eiweiß, Fett und Kohlenhydraten bleiben gleich und passen damit ebenso zu Longos Vorgaben.${p.others.some((o: any) => o.age < 18 || o.age > 70 || o.bmi < 18.5) ? ' Für mindestens eine mitfastende Person gilt ein Hinweis zu Alter oder Gewicht. Lies dazu bitte <a href="' + base + 'fuer-wen-nicht/">Für wen es nicht passt</a>.' : ''}</p>
      </details>` : ''}
      <details class="plain"><summary><b>Abgleich mit Longos Vorgaben</b> <span class="muted small">(Brandhorst et al., Cell Metabolism 2015)</span></summary>
        <div class="tw"><table><thead><tr><th>Tag</th><th>kcal</th><th>Eiweiß</th><th>Fett</th><th>davon Öl</th><th>Kohlenhydrate</th><th>Zucker</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>
        <p class="muted small">„Passt“ heißt: Kalorien höchstens 5 %, Fett und Kohlenhydrate höchstens 5 und Eiweiß höchstens ${PLAN.reference.tolerance.proteinPoints} Prozentpunkte von Longos Referenz entfernt, Zucker höchstens ${PLAN.reference.sugarMaxPercent} % der Kalorien (Longo nennt dafür keine Zahl, das ist unsere Regel). Die Anpassung der Portionen an Deinen Bedarf (Faktor ${fmt(f, 2)}, berechnet mit der Mifflin-St-Jeor-Formel) ist unsere eigene Regel und nicht Teil von Longos Protokoll.</p>
      </details>
      <div class="tabs noprint" role="tablist">${tabs.map(([k, a, b]) => `<button class="tab" role="tab" data-tab="${k}" aria-selected="${k === tab}"><b>${a}</b><span>${b}</span></button>`).join('')}</div>
      <div id="panes">${[0, 1, 2, 3, 4, 5, 6].map((k) => `<div class="daycard" data-pane="${k}" ${k === tab ? '' : 'hidden'}>${pane(k, f, start, cyc, gap, p.fAll, p.ppl)}</div>`).join('')}</div>
    `;
    bindCommon();
    result.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => b.addEventListener('click', () => {
      tab = Number(b.dataset.tab);
      result.querySelectorAll<HTMLElement>('.tab').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      result.querySelectorAll<HTMLElement>('.daycard').forEach((x) => (x.hidden = x.dataset.pane !== String(tab)));
    }));
    result.querySelector<HTMLInputElement>('#bf')?.addEventListener('change', (e) => { state.breakfast = (e.target as HTMLInputElement).checked; openSwap = ''; save(); rerender(); });
    result.querySelectorAll<HTMLButtonElement>('[data-swap]').forEach((b) => b.addEventListener('click', () => { openSwap = openSwap === b.dataset.swap ? '' : b.dataset.swap!; rerender(); }));
    result.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
      const [d, i] = b.dataset.pick!.split('-').map(Number);
      const sw = (state[swapKey()] = state[swapKey()] || {});
      sw[d] = sw[d] || {}; sw[d][i] = { recipe: b.dataset.r, portion: Number(b.dataset.p) };
      openSwap = ''; save(); rerender();
    }));
    result.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach((b) => b.addEventListener('click', () => {
      const [d, i] = b.dataset.reset!.split('-').map(Number);
      const sw = state[swapKey()]; if (sw?.[d]) delete sw[d][i]; save(); rerender();
    }));
  }
  function rerender() { const y = window.scrollY; render(); window.scrollTo({ top: y }); }
  function bindCommon() {
    result.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((b) => b.addEventListener('click', () => { result.hidden = true; root.hidden = false; result.dataset.shown = ''; go(1); }));
    if (!result.dataset.shown) { result.dataset.shown = '1'; window.scrollTo({ top: 0 }); }
  }

  function pane(k: number, f: number, start: Date, cyc: number, gap: number, fAll = f, ppl = 1) {
    if (k === 0) {
      const pre = [...new Set([...items(1), ...items(2)].filter((x: any) => x.type === 'main').map((x: any) => BY_SLUG[x.recipe].title))];
      return `<div class="plain"><h3>Vorbereitung am ${dsl(addDays(start, -1))}</h3><ul>
        <li>Einkaufen (Liste unten).</li><li>Vorkochen für die ersten Tage: ${pre.map(esc).join(', ')}.</li>
        ${bf() ? '<li>Frühstück vorbereiten: Hirse vorkochen, den Chia-Pudding am Vorabend ansetzen. Die halbe Portion Nussmix für Tag 1 abwiegen.</li>' : '<li>Nussmix für fünf Tage abwiegen und in Dosen füllen.</li>'}<li>Abends leicht essen: Gemüse, etwas Reis, kein Alkohol.</li>
        <li>Viel Kaffee? Schon jetzt reduzieren, dann reicht in den fünf Tagen eine kleine Tasse.</li></ul></div>${pane(7, f, start, cyc, gap, fAll, ppl)}`;
    }
    if (k === 6) {
      return `<div class="plain"><h3>Tag 6 (Übergangstag) am ${dsl(addDays(start, 5))}</h3><ul>
        <li>Nicht direkt zu großen Portionen zurückkehren.</li><li>Gut geeignet: Suppen, gedünstetes Gemüse, Reis, Haferbrei, kleine Mengen Eiweiß.</li>
        <li>Ab Tag 7 wieder normal und ausgewogen essen.</li></ul>
        <p><b>Passt gut zum Übergang</b> <span class="muted small">(normale Portion, dazu Reis, Brot oder Haferbrei)</span></p>
        <div class="stack" style="gap:8px">${['minestrone', 'kuerbissuppe', 'spinat-dal'].filter((s) => BY_SLUG[s]).map((s) => { const r = BY_SLUG[s]; return `<a class="alt" href="${base}rezepte/${s}/"><img src="${img(r)}" alt="" loading="lazy"><span><b>${esc(r.title)}</b><small>${r.minutes} Minuten</small></span><span></span></a>`; }).join('')}</div></div>${pane(8, f, start, cyc, gap, fAll, ppl)}`;
    }
    if (k === 7 || k === -7) {
      const tot: Record<string, number> = {};
      for (let d = 1; d <= 5; d++) for (const it of items(d)) for (const ing of BY_SLUG[it.recipe].ingredients) tot[ing.name] = (tot[ing.name] || 0) + ing.amount * it.portion * fAll;
      return `<div class="plain"><h3>${I.cart} Einkaufsliste für einen Durchgang${ppl > 1 ? ` · ${ppl} Personen` : ''}</h3><p class="muted small">Mengen ohne Reserve${ppl > 1 ? ', für alle zusammen' : ''}. Dazu: Salz, Pfeffer, Kräuter, Gewürze, Kräutertee.</p>
        <p class="small muted maclegend">Hauptnährstoff: <span class="mac carbs">${I.carbs}</span>Kohlenhydrate <span class="mac protein">${I.protein}</span>Eiweiß <span class="mac fat">${I.fat}</span>Fett</p>
        <div class="shopcats">${groupByCat(Object.entries(tot).sort((a, b) => a[0].localeCompare(b[0], 'de')), ([n]: [string, number]) => FM[n]).map((c) => `<div class="shopcat"><h4>${I[c.icon]}${c.label}</h4>
        <ul class="shop">${c.items.map(([n, g]: [string, number]) => `<li><label><input type="checkbox">${mac(n)}<span><b>${amountLabel(n, g)}</b> ${esc(n)}</span></label></li>`).join('')}</ul></div>`).join('')}</div></div>`;
    }
    if (k === 8) {
      if (cyc < 2) return `<div class="plain nextcyc"><p>${I.calendar} Du hast einen Durchgang geplant. Für weitere Termine wähle unter „Angaben ändern“ mehrere Durchgänge.</p></div>`;
      const next = addMonths(start, gap);
      let li = '';
      for (let c = 1; c < cyc; c++) { const s1 = addMonths(start, c * gap); li += `<li><b>${c + 1}. Durchgang:</b> ${dsl(s1)} bis ${dsl(addDays(s1, 4))} <span class="muted">(Vorbereitung ${dsl(addDays(s1, -1))})</span></li>`; }
      return `<div class="plain nextcyc"><h3>${I.calendar} Dein nächster Scheinfastenzyklus beginnt am ${dsl(next)}</h3><ul>${li}</ul></div>`;
    }
    const list = items(k); const n = total(list, f); const c = check(k, n, f);
    const vs = (cls: string, ic: string, label: string, val: string, sub: string) => `<div class="${cls}"><span class="k">${I[ic]}${label}</span><b>${val}</b><small>${sub}</small></div>`;
    let html = `<div class="daytop"><div class="row"><h3>Tag ${k}${k === 1 ? ' (Starttag)' : ''} · ${dsl(addDays(start, k - 1))}</h3>${c.ok ? `<span class="chip ok">${I.check} passt zu Longos Vorgaben</span>` : '<span class="chip warn">knapp neben Longos Vorgaben</span>'}</div>
      <div class="vs">
        ${vs('kcal', 'kcal', 'Kalorien', `${fmt(n.kcal)} kcal`, `Ziel ${fmt(c.target)} · Longo ${c.ref.kcal}`)}
        ${vs('protein', 'protein', 'Eiweiß', `${fmt(n.protein)} g`, `${fmt(c.shares.protein)} % · Longo ${c.ref.protein} %`)}
        ${vs('fat', 'fat', 'Fett', `${fmt(n.fat)} g`, `${fmt(c.shares.fat)} % · Longo ${c.ref.fat} %`)}
        ${vs('oil', 'oil', 'davon Öl', `${fmt(n.oil)} g`, `ca. ${fmt(n.oil / 4.6)} TL`)}
        ${vs('carbs', 'carbs', 'Kohlenhydrate', `${fmt(n.carbs)} g`, `${fmt(c.shares.carbs)} % · Longo ${c.ref.carbs} %`)}
      </div>
      <div class="mbar" aria-hidden="true"><i class="p" style="width:${c.shares.protein}%"></i><i class="f" style="width:${c.shares.fat}%"></i><i class="c" style="width:${c.shares.carbs}%"></i></div>
      <p class="muted small">${I.water} Dazu über den Tag reichlich Wasser oder ungesüßten Tee.</p></div>`;
    list.forEach((it: any, idx: number) => {
      const r = BY_SLUG[it.recipe]; const por = it.portion * f; const m = nutrition(r, por);
      const agg: Record<string, number> = {};
      for (const ing of r.ingredients) agg[ing.name] = (agg[ing.name] || 0) + ing.amount * por;
      const key = `${k}-${idx}`;
      const canSwap = it.type !== 'fixed';
      let box = '';
      if (openSwap === key) {
        const cands = candidates(k, idx, f);
        box = `<div class="swapbox"><p class="small"><b>Alternative wählen.</b> Die Portion wird so angepasst, dass die Kalorien gleich bleiben.</p>
          ${cands.map((x: any) => `<button class="alt" data-pick="${key}" data-r="${x.r.slug}" data-p="${x.portion}"><img src="${img(x.r)}" alt="" loading="lazy"><span><b>${esc(x.r.title)}</b><small>${fmt(x.kcal)} kcal · Portion ×${fmt(x.portion, 2)}</small></span>${x.ok ? `<span class="chip ok">${I.check} passt</span>` : '<span class="chip warn">knapp</span>'}</button>`).join('')}
        </div>`;
      }
      html += `<article class="meal"><img src="${img(r)}" alt="" loading="lazy"><div class="info">
        <span class="when">${it.meal}</span>
        <h3>${['main', 'snack', 'breakfast'].includes(r.slot) ? `<a href="${base}rezepte/${r.slug}/">${esc(r.title)}</a>` : esc(r.title)}</h3>
        <div class="nut"><span class="kcal">${I.kcal}<b>${fmt(m.kcal)}</b> kcal</span><span class="protein">${I.protein}<b>${fmt(m.protein)} g</b></span><span class="fat">${I.fat}<b>${fmt(m.fat)} g</b></span><span class="carbs">${I.carbs}<b>${fmt(m.carbs)} g</b></span></div>
        <span class="por">Portion ×${fmt(por, 2)}${ppl > 1 ? ` · Topf für alle ×${fmt(it.portion * fAll, 2)}` : ''}${it.swapped ? ' · getauscht' : ''}</span>
        <details><summary>${ppl > 1 ? `Zutaten für alle ${ppl} Personen` : 'Zutaten in Gramm'}</summary><ul>${Object.entries(agg).map(([n2, g]) => ppl > 1 ? `<li>${amountLabel(n2, g / f * fAll)} ${esc(n2)} <small>(Deins: ${amountLabel(n2, g)})</small></li>` : `<li>${amountLabel(n2, g)} ${esc(n2)}</li>`).join('')}</ul></details>
        ${canSwap ? `<div class="acts noprint"><button class="btn soft small" data-swap="${key}" aria-expanded="${openSwap === key}">${I.swap} Tauschen</button>${it.swapped ? `<button class="btn soft small" data-reset="${key}">Original</button>` : ''}</div>` : ''}
      </div>${box}</article>`;
    });
    return html;
  }

  if (state.inputs && new URLSearchParams(location.search).has('plan')) render();
</script>
