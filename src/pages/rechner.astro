  function readInputs() {
    const fd = new FormData(pf);
    const v = Object.fromEntries(fd.entries()) as any;
    const age = +v.age, h = +v.h, w = +v.w;
    let msg = '';
    if (!age || age < 10 || age > 100) msg = 'Bitte gib ein Alter zwischen 10 und 100 Jahren ein.';
    else if (!h || h < 120 || h > 220) msg = 'Bitte gib eine Größe zwischen 120 und 220 cm ein.';
    else if (!w || w < 35 || w > 250) msg = 'Bitte gib ein Gewicht zwischen 35 und 250 kg ein.';
    const e = document.getElementById('err1')!; e.textContent = msg; e.hidden = !msg;
    return msg ? null : v;
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const v = readInputs(); if (!v) { pf.scrollIntoView({ behavior: 'smooth' }); return; }
    if (applyDay()) return;
    const fromOwn = !!(ev as SubmitEvent).submitter?.hasAttribute('data-ownsubmit');
    const e3 = document.getElementById('err3')!, e4 = document.getElementById('err4')!;
    let msg = '';
    if (!state.picks.length && !ownMeals().length) msg = fromOwn ? 'Trag noch mindestens eine Mahlzeit ein oder wähle ein Rezept.' : 'Füge noch mindestens ein Lebensmittel hinzu.';
    e3.textContent = fromOwn ? '' : msg; e3.hidden = fromOwn || !msg;
    e4.textContent = fromOwn ? msg : ''; e4.hidden = !fromOwn || !msg;
    if (msg) return;
    state.inputs = v;
    state.shown = true;
