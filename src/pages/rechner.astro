---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url.js';
import { icon } from '../lib/icons.js';
import { PLAN, fmt } from '../lib/nutrition.js';
const icons = Object.fromEntries(['kcal', 'protein', 'fat', 'carbs', 'swap', 'check', 'close', 'plus', 'time', 'arrow', 'info', 'pot', 'search', 'sugar', 'leaf', 'nut', 'oil', 'apple', 'herb', 'cup', 'ban'].map((k) => [k, icon(k)]));
const quick = ['Zucchini', 'Tomaten', 'Karotten', 'Brokkoli', 'Hokkaido-Kürbis', 'Champignons', 'Kartoffeln', 'Olivenöl', 'Walnusskerne', 'Grüne Oliven'];
const r1 = PLAN.reference.day1, r2 = PLAN.reference.day2to5;
import AffiliateBox from '../components/AffiliateBox.astro';
import Tagebuch from '../components/Tagebuch.astro';
import StandSichern from '../components/StandSichern.astro';
import Erinnerung from '../components/Erinnerung.astro';
import Rotator from '../components/Rotator.astro';
import ModeNav from '../components/ModeNav.astro';
import { pick } from '../data/affiliate.js';
---
<Base title="Scheinfasten-Rechner: Kalorien und Nährwerte pro Tag" active="rechner" description="Trag ein, was Du heute schon gegessen hast, und sieh sofort, wie viel von Deinem Scheinfasten-Tag nach Prof. Dr. Valter Longo noch übrig ist. Mit Vorschlägen, wie Du den Rest lecker füllst.">
  <div class="in page-head split">
    <div class="ph-text">
      <p class="kicker">Scheinfastenrechner</p>
      <h1 id="rh">Wie viel geht heute noch?</h1>
      <p class="lead" id="rl">Trag ein, was Du gegessen hast, und sieh, wie viel heute noch geht. Triffst Du Dein Ziel, leuchtet der Tag grün auf.</p>
    </div>
    <Rotator images={[
      { src: 'img/menschen/paar-kocht.jpg', alt: 'Paar kocht gemeinsam mit frischem Gemüse' },
      { src: 'img/rechner/pilz.jpg', alt: '' },
      { src: 'img/menschen/lachen-essen.jpg', alt: '' },
      { src: 'img/rechner/carpaccio.jpg', alt: '' },
    ]} />
  </div>
  <ModeNav current="live" />

  <section class="in calc" id="prof">
    <form id="pf" class="card wcard" novalidate>
      <fieldset class="block">
        <legend><span class="num">1</span>Über Dich</legend>
        <div class="field"><span class="lbl">Geschlecht</span>
          <div class="seg three">
            <label><input type="radio" name="sex" value="w" checked /><span>Weiblich</span></label>
            <label><input type="radio" name="sex" value="m" /><span>Männlich</span></label>
            <label><input type="radio" name="sex" value="d" /><span>Divers</span></label>
          </div>
        </div>
        <div class="row3">
          <div class="field"><label for="age" class="lbl">Alter</label><div class="unit"><input id="age" name="age" type="number" inputmode="numeric" min="10" max="100" value="42" required /><span>Jahre</span></div></div>
          <div class="field"><label for="h" class="lbl">Größe</label><div class="unit"><input id="h" name="h" type="number" inputmode="numeric" min="120" max="220" value="168" required /><span>cm</span></div></div>
          <div class="field"><label for="w" class="lbl">Gewicht</label><div class="unit"><input id="w" name="w" type="number" inputmode="decimal" min="35" max="250" step="0.5" value="70" required /><span>kg</span></div></div>
        </div>
        <div class="field"><span class="lbl">Wie aktiv ist Dein Alltag?</span>
          <div class="seg three">
            <label><input type="radio" name="pal" value="1.4" /><span>Eher sitzend</span></label>
            <label><input type="radio" name="pal" value="1.6" checked /><span>Normal</span></label>
            <label><input type="radio" name="pal" value="1.8" /><span>Sehr aktiv</span></label>
          </div>
        </div>
        <div class="field"><span class="lbl">Welcher Fastentag ist heute?</span>
          <div class="seg five" id="days">
            {[1, 2, 3, 4, 5].map((d) => <label><input type="radio" name="day" value={String(d)} checked={d === 1} /><span>Tag {d}<small data-daysum={d}>ca. {fmt(d === 1 ? r1.kcal : r2.kcal)} kcal</small></span></label>)}
          </div>
          <p class="small muted daylegend" aria-hidden="true"><span><i class="lu"></i>auf dem Weg</span><span><i class="lh"></i>Ziel getroffen</span><span><i class="lo"></i>drüber</span></p>
          <p class="small muted" id="dayhint" aria-live="polite"></p>
        </div>
        <p class="err" id="err1" role="alert" hidden></p>
      </fieldset>
    </form>
    <script is:inline>
      // Eingaben sofort beim Laden wiederherstellen, bevor die Reiter rechnen: erst eigene, sonst aus Rechner oder Planer.
      (function () {
        var get = function (k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } };
        var pf = document.getElementById('pf');
        var prof = get('smlProfil'), plan = get('smlPlaner'), old = get('smlRechner');
        var v = (prof && prof.inputs) || (old && old.inputs) || (plan && plan.inputs) || {};
        ['sex', 'age', 'h', 'w', 'pal'].forEach(function (k) {
          if (v[k] == null) return;
          var el = pf.elements.namedItem(k);
          if (!el) return;
          if (el.length && el[0] && el[0].type === 'radio') { for (var i = 0; i < el.length; i++) el[i].checked = el[i].value === String(v[k]); } else el.value = v[k];
        });
        // Zyklustag aus dem Startdatum im Planer, sonst der zuletzt gewählte Tag
        var day = null, start = plan && plan.inputs && plan.inputs.start;
        if (start) {
          var s = new Date(start + 'T12:00:00'), d = new Date(); d.setHours(12, 0, 0, 0);
          var n = Math.round((d - s) / 86400000) + 1;
          if (n >= 1 && n <= 5) { day = n; pf.dataset.fromPlan = String(n); }
        }
        if (!day && prof && prof.day) day = +prof.day;
        if (day) { var r = pf.querySelector('input[name="day"][value="' + day + '"]'); if (r) r.checked = true; }
      })();
    </script>
  </section>

  <div id="pane-log">
    <Tagebuch />
  </div>

  <div id="pane-cook" hidden>
  <section class="in calc" id="calc" data-base={u('')} data-icons={JSON.stringify(icons)}>
    <form id="f" class="card wcard" novalidate>
      <fieldset class="block">
        <legend><span class="num">2</span>Was hast Du zu Hause?</legend>
        <p class="small muted">Lebensmittel eintippen, ohne Mengen. Wir rechnen aus, wie viel Du davon heute essen kannst, und machen Rezepte daraus.</p>
        <div class="field combo">
          <label for="q" class="lbl">Lebensmittel hinzufügen</label>
          <div class="search">
            <Icon name="search" />
            <input id="q" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sug" autocomplete="off" placeholder="z. B. Zucchini, Möhre, Feta" />
          </div>
          <ul id="sug" class="sug" role="listbox" hidden></ul>
          <p class="small muted" id="qhint" aria-live="polite"></p>
        </div>
        <div class="quick" aria-label="Schnell hinzufügen">
          <span class="small muted">Schnell dazu:</span>
          {quick.map((n) => <button type="button" class="qchip" data-add={n}><Icon name="plus" />{n}</button>)}
        </div>
        <p class="taboo small"><Icon name="ban" /><span><b>Diese fünf Tage tabu:</b> Fleisch, Fisch und Eier · Milchprodukte · Zucker und Süßes · Brot, Nudeln und Weißmehl · Alkohol und Säfte. Kaffee höchstens eine kleine Tasse schwarz. <a href={u('wissen/#weglassen')}>Ganze Liste</a></span></p>
        <div class="picked" id="picked" aria-label="Deine Lebensmittel"></div>
        <p class="small muted legendline"><span class="dot g"></span>passt gut <span class="dot y"></span>nur kleine Menge <span class="dot r"></span>lieber tauschen</p>
        <p class="small muted legendline"><span>Hauptnährstoff:</span><span class="mac carbs"><Icon name="carbs" /></span>Kohlenhydrate <span class="mac protein"><Icon name="protein" /></span>Eiweiß <span class="mac fat"><Icon name="fat" /></span>Fett</p>
      </fieldset>

      <p class="err" id="err3" role="alert" hidden></p>
      <div class="nav-btns"><p class="hint"><Icon name="heart" /><span>Kurz zur Sicherheit: Wenn Du schwanger bist, stillst, Medikamente nimmst oder eine ernste Erkrankung hast, sprich vorher kurz mit Deiner Ärztin oder Deinem Arzt. <a href={u('fuer-wen-nicht/')}>Mehr dazu</a></span></p><button type="submit" class="btn">Jetzt daraus Rezepte erstellen <Icon name="arrow" /></button></div>
    </form>
  </section>

  <section class="in result" id="result" hidden aria-live="polite"></section>
  </div>
  <StandSichern />
  <Erinnerung />
  <div class="in narrow" style="padding-block:24px 56px"><AffiliateBox items={pick('waage', 'loeffel', 'oel')} title="Genau abwiegen" lead="Öl und Nüsse machen den größten Teil der Kalorien aus. Schon 5 g mehr verschieben die Werte deutlich." /></div>

  <div class="in narrow small muted srcnote">
    <p>Nährwerte: Max Rubner-Institut (2025), Bundeslebensmittelschlüssel (BLS) Version 4.0, <a href="https://doi.org/10.25826/Data20251217-134202-0" rel="noopener">DOI 10.25826/Data20251217-134202-0</a>, Lizenz <a href="https://creativecommons.org/licenses/by/4.0/deed.de" rel="noopener">CC BY 4.0</a>. Wir haben die Werte auf vier Kennzahlen reduziert. Kohlenhydrate sind inklusive Ballaststoffe angegeben. Für Dill, Minze, Paprikapulver und Currypaste gibt es keinen BLS-Eintrag, dort nutzen wir Richtwerte aus der USDA-Datenbank.</p>
    <p>Sollwerte: Brandhorst S et al., Cell Metab 2015, Methoden (Labor von Prof. Dr. Longo). Wei M et al., Sci Transl Med 2017 nennt für Tag 2 bis 5 dieselben Anteile bei ca. 3.000 kJ (ca. 717 kcal). Kaffee höchstens eine kleine Tasse: Empfehlung des ProLon-Herstellers L-Nutra, nicht aus den Studien. Die Zuckergrenze von höchstens 15 % der Kalorien ist unsere eigene Regel, weil Prof. Dr. Longo nur „wenig Zucker“ ohne Grammzahl angibt. Die Obergrenzen je Lebensmittel und die Einteilung in Ampelfarben sind unsere eigenen Richtwerte, abgeleitet aus Prof. Dr. Longos Makroverteilung. Diese Seite wird von Prof. Dr. Longo weder geprüft noch unterstützt.</p>
  </div>
</Base>

<style is:global>
  .calc { max-width: 820px; padding-bottom: 40px; }
  .calc .wcard { padding: clamp(18px, 4vw, 30px); gap: 30px; }
  .block { border: 0; padding: 0; margin: 0; display: grid; gap: 18px; min-width: 0; }
  .block legend { font-family: var(--display); font-size: 1.5rem; display: flex; align-items: center; gap: 10px; padding: 0; margin-bottom: 4px; }
  .block .num { width: 32px; height: 32px; border-radius: 50%; background: var(--tomato); color: var(--on-tomato); display: grid; place-items: center; font: 700 .95rem var(--body); flex: none; }
  .seg.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .seg.five { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  @media (max-width: 560px) { .seg.five { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  #prof { padding-bottom: 18px; }
  .tabsw { padding-bottom: 18px; }
  .tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 6px; background: var(--band); border-radius: 18px; }
  .tabs button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; border: 0; border-radius: 13px; padding: 12px 10px; min-height: 48px; font: 700 .98rem/1.2 var(--body); background: none; color: var(--muted); cursor: pointer; }
  .tabs button[aria-selected="true"] { background: var(--card); color: var(--green); box-shadow: var(--shadow); }
  .tabs button:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .tabs .i { width: 1.1em; height: 1.1em; }
  .combo { position: relative; }
  .search { position: relative; }
  .search .i { position: absolute; left: 14px; top: 50%; translate: 0 -50%; color: var(--muted); }
  .search input { padding-left: 42px; }
  .sug { list-style: none; margin: 0; padding: 6px; position: absolute; left: 0; right: 0; top: calc(100% - 22px); z-index: 20; background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); max-height: 340px; overflow-y: auto; }
  .sug li { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; cursor: pointer; }
  .sug li[aria-selected="true"], .sug li:hover { background: var(--band); }
  .sug li small { color: var(--muted); margin-left: auto; font-size: .78rem; }
  .dot { display: inline-block; width: 11px; height: 11px; border-radius: 50%; flex: none; vertical-align: -1px; }
  .dot.g { background: var(--ok); } .dot.y { background: var(--sun); } .dot.r { background: var(--bad); }
  .legendline { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .legendline .dot { margin-left: 6px; }
  .quick { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .qchip, .pchip, .alt { display: inline-flex; align-items: center; gap: 6px; font: 600 .88rem/1.2 var(--body); padding: 8px 12px; min-height: 38px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }
  .qchip:hover, .alt:hover { border-color: var(--green); color: var(--green); }
  .qchip[disabled] { opacity: .45; cursor: default; }
  .qchip .i, .alt .i { width: 1em; height: 1em; }
  .picked { display: grid; gap: 12px; }
  .pgroup { display: grid; gap: 6px; }
  .pgroup ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .catlbl { display: flex; gap: 6px; align-items: center; font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .catlbl .i { color: var(--green); }
  .taboo { display: flex; gap: 10px; align-items: flex-start; background: var(--bad-bg); border-radius: 14px; padding: 10px 14px; }
  .taboo .i { color: var(--bad); margin-top: 2px; }
  .picked:empty::before { content: "Noch nichts ausgewählt."; color: var(--muted); font-size: .92rem; }
  .pchip { cursor: default; background: var(--card); }
  .pchip button { border: 0; background: none; color: var(--muted); cursor: pointer; padding: 2px; display: grid; place-items: center; min-height: 0; }
  .pchip button .i { width: 1em; height: 1em; }
  .pchip.r { border-color: var(--bad); background: var(--bad-bg); }
  .pchip.y { border-color: var(--sun); }

  .result { display: grid; gap: 28px; padding-bottom: 50px; max-width: 980px; }
  .rtop { display: grid; gap: 14px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(16px, 3vw, 24px); }
  .rtop .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .amounts td input { width: 92px; min-height: 40px; padding: 6px 10px; text-align: right; font-weight: 700; }
  .amounts td.nm { font-weight: 600; }
  .amounts td.nm small { display: block; font-weight: 400; color: var(--muted); }
  .amounts .zero td { color: var(--muted); }
  .amounts tr.cat th { background: var(--band); color: var(--fg); font-size: .8rem; padding: 9px 14px; }
  .amounts tr.cat th .i { color: var(--green); margin-right: 8px; vertical-align: -3px; }
  .nmrow { display: flex; gap: 8px; align-items: flex-start; }
  .nmrow .mac { margin-top: 2px; }
  .meal ul.ing { list-style: none; padding-left: 0; }
  .meal ul.ing li { display: flex; gap: 8px; align-items: center; }
  .amounts .reset { border: 0; background: none; color: var(--green); font: 600 .8rem var(--body); cursor: pointer; padding: 4px; min-height: 0; }
  .gcell { display: flex; align-items: center; gap: 6px; }
  .alts { display: flex; flex-wrap: wrap; gap: 8px; }
  .badlist { display: grid; gap: 12px; }
  .badlist .alert p b { font-weight: 800; }
  .meals { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: 18px; }
  .meal ul { margin: 0; padding-left: 18px; display: grid; gap: 2px; font-size: .93rem; }
  .meal ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: .93rem; }
  .meal h3 { font-size: 1.2rem; }
  .meal .meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .rmatch { display: grid; grid-template-columns: 88px 1fr; gap: 14px; align-items: start; text-decoration: none; color: inherit; }
  .rmatch img { width: 88px; height: 66px; object-fit: cover; border-radius: 12px; }
  .rmatch h3 { font-size: 1.1rem; }
  .rmatch p { font-size: .88rem; }
  .srcnote { display: grid; gap: 8px; padding-bottom: 40px; }
  @media print { .calc, .noprint { display: none !important; } }
</style>

<script>
  import { FOODS, BY_NAME, search, profile, targets, solve, suggestAdditions, buildMeals, matchRecipes, advice, amount, unit, CAP_WHY } from '../lib/rechner.js';
  import { fmt, PLAN, amountLabel } from '../lib/nutrition.js';
  import { groupByCat, macroOf, MACROS } from '../lib/foodmeta.js';
  import { thumb } from '../lib/url.js';
  const PLAN_SUGAR = PLAN.reference.sugarMaxPercent;
  const TOL_P = PLAN.reference.tolerance.proteinPoints ?? PLAN.reference.tolerance.macroPoints;

  const root = document.getElementById('calc')!;
  const base = root.dataset.base!;
  const I = JSON.parse(root.dataset.icons!);
  const form = document.getElementById('f') as HTMLFormElement;
  const result = document.getElementById('result')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const sug = document.getElementById('sug')!;
  const qhint = document.getElementById('qhint')!;
  const picked = document.getElementById('picked')!;
  const STORE = 'smlRechner';
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const LIGHT: Record<string, string> = { g: 'passt gut', y: 'nur kleine Menge', r: 'lieber tauschen' };
  // Symbol für den Hauptnährstoff (Kohlenhydrate, Eiweiß oder Fett); Kräuter, Würzen und Kalorienfreies ohne Symbol
  const mac = (name: string) => {
    const m = macroOf(BY_NAME[name]);
    if (!m) return '<span class="mac none" aria-hidden="true"></span>';
    const lbl = MACROS[m.key as keyof typeof MACROS];
    return `<span class="mac ${m.key}" title="Liefert vor allem ${lbl} (${m.share} % der Kalorien)">${I[m.key]}<span class="sr-only">${lbl}:</span></span>`;
  };

  type Pick = { name: string; g?: number };
  let state: { inputs?: any; picks: Pick[]; shown?: boolean } = { picks: [] };
  try { const s = JSON.parse(localStorage.getItem(STORE) || 'null'); if (s && Array.isArray(s.picks)) state = s; } catch {}
  state.picks = state.picks.filter((p) => BY_NAME[p.name]);
  // Körperdaten und Fastentag stehen im gemeinsamen Formular oben (#pf), für beide Reiter.
  const pf = document.getElementById('pf') as HTMLFormElement;
  const save = () => { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch {} };

  // Suche mit Vorschlagsliste
  let hits: any[] = [];
  let active = -1;
  function showSug() {
    hits = search(q.value);
    active = hits.length ? 0 : -1;
    const t = q.value.trim();
    qhint.textContent = t.length >= 2 && !hits.length ? `„${t}“ kennen wir leider noch nicht. Probier es mit einem anderen Wort, z. B. der Grundzutat.` : '';
    sug.innerHTML = hits.map((f, i) => `<li role="option" id="s${i}" aria-selected="${i === active}" data-name="${esc(f.name)}"><span class="dot ${f.light}" aria-hidden="true"></span>${mac(f.name)}${esc(f.name)}<small>${LIGHT[f.light]}</small></li>`).join('');
    sug.hidden = !hits.length;
    q.setAttribute('aria-expanded', String(!!hits.length));
    q.setAttribute('aria-activedescendant', active >= 0 ? `s${active}` : '');
  }
  function mark() {
    sug.querySelectorAll('li').forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
    q.setAttribute('aria-activedescendant', active >= 0 ? `s${active}` : '');
    sug.querySelector(`#s${active}`)?.scrollIntoView({ block: 'nearest' });
  }
  q.addEventListener('input', showSug);
  q.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && hits.length) { e.preventDefault(); active = (active + 1) % hits.length; mark(); }
    else if (e.key === 'ArrowUp' && hits.length) { e.preventDefault(); active = (active - 1 + hits.length) % hits.length; mark(); }
    else if (e.key === 'Enter') { e.preventDefault(); if (active >= 0) addFood(hits[active].name); }
    else if (e.key === 'Escape') { sug.hidden = true; q.setAttribute('aria-expanded', 'false'); }
  });
  sug.addEventListener('mousedown', (e) => { const li = (e.target as HTMLElement).closest('li'); if (li) { e.preventDefault(); addFood(li.dataset.name!); } });
  q.addEventListener('blur', () => setTimeout(() => { sug.hidden = true; q.setAttribute('aria-expanded', 'false'); }, 120));

  function addFood(name: string, replace?: string) {
    if (!BY_NAME[name]) return;
    if (replace) state.picks = state.picks.filter((p) => p.name !== replace);
    if (!state.picks.some((p) => p.name === name)) state.picks.push({ name });
    q.value = ''; sug.hidden = true; qhint.textContent = '';
    save(); renderPicked();
    if (state.shown) render();
  }
  function removeFood(name: string) {
    state.picks = state.picks.filter((p) => p.name !== name);
    save(); renderPicked();
    if (state.shown) render();
  }
  function renderPicked() {
    picked.innerHTML = groupByCat(state.picks, (p: Pick) => BY_NAME[p.name]).map((c) => `<div class="pgroup"><p class="catlbl">${I[c.icon]}${c.label}</p><ul>${c.items.map((p: Pick) => {
      const f = BY_NAME[p.name];
      return `<li class="pchip ${f.light}"><span class="dot ${f.light}" title="${LIGHT[f.light]}"></span>${mac(f.name)}${esc(f.name)}<button type="button" data-remove="${esc(f.name)}" aria-label="${esc(f.name)} entfernen">${I.close}</button></li>`;
    }).join('')}</ul></div>`).join('');
    const have = new Set(state.picks.map((p) => p.name));
    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => (b.disabled = have.has(b.dataset.add!)));
  }
  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]'); if (add) addFood(add.dataset.add!);
    const rm = t.closest<HTMLElement>('[data-remove]'); if (rm) removeFood(rm.dataset.remove!);
  });
  renderPicked();

  function readInputs() {
    const fd = new FormData(pf);
    const v = Object.fromEntries(fd.entries()) as any;
    const age = +v.age, h = +v.h, w = +v.w;
    let msg = '';
    if (!age || age < 10 || age > 100) msg = 'Bitte gib ein Alter zwischen 10 und 100 Jahren ein.';
    else if (!h || h < 120 || h > 220) msg = 'Bitte gib eine Größe zwischen 120 und 220 cm ein.';
    else if (!w || w < 35 || w > 250) msg = 'Bitte gib ein Gewicht zwischen 35 und 250 kg ein.';
    const e = document.getElementById('err1')!; e.textContent = msg; e.hidden = !msg;
    return msg ? null : v;
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const v = readInputs(); if (!v) { pf.scrollIntoView({ behavior: 'smooth' }); return; }
    const e3 = document.getElementById('err3')!;
    let msg = '';
    if (!state.picks.length) msg = 'Füge noch mindestens ein Lebensmittel hinzu.';
    e3.textContent = msg; e3.hidden = !msg;
    if (msg) return;
    state.inputs = v;
    state.shown = true;
    save(); render();
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  // Tageswahl und Körperdaten wirken sofort, sobald ein Ergebnis da ist
  pf.addEventListener('change', () => {
    if (!state.shown) return;
    const v = readInputs(); if (!v) return;
    state.inputs = v; save(); render();
  });

  const pct = (x: number) => `${fmt(x)} %`;
  const devTxt = (d: number) => (d > 0 ? `+${fmt(d)}` : fmt(d));

  function render() {
    const v = state.inputs;
    const p = profile({ sex: v.sex, age: +v.age, h: +v.h, w: +v.w, pal: +v.pal });
    // Freundliche Hinweise statt Sperre: gerechnet wird immer.
    const notes: string[] = [];
    if (p.age < 18) notes.push('Du bist unter 18. In diesem Alter wächst der Körper noch, deshalb ist Scheinfasten eher nichts für Dich. Die Gerichte kannst Du trotzdem nachkochen.');
    if (p.age > 70) notes.push('Ab 70 lohnt sich vorher ein kurzes Gespräch mit Deiner Ärztin oder Deinem Arzt.');
    if (p.bmi < 18.5) notes.push(`Dein BMI liegt bei ${fmt(p.bmi, 1)}. Bei so wenig Gewicht sprich bitte vorher mit Deiner Ärztin oder Deinem Arzt.`);
    result.hidden = false;
    const day = v.day === '1' ? 1 : 2;
    const t = targets(day, p.f);
    const red = state.picks.filter((x) => BY_NAME[x.name].light === 'r');
    const ok = state.picks.filter((x) => BY_NAME[x.name].light !== 'r');
    const res = ok.length ? solve(ok, t) : null;
    const vd = res?.verdict;
    const adds = res ? suggestAdditions(ok, t, res) : [];
    const dayLabel = `Tag ${v.day}`;

    let tableHtml = '';
    let h = notes.length ? `<div class="alert info">${notes.map((n) => `<p>${n}</p>`).join('')}</div>` : '';
    // Kopf mit Abgleich
    if (res && vd) {
      const status = vd.ok ? `<span class="chip ok">${I.check} Passt genau zu Prof. Dr. Longo</span>` : `<span class="chip warn">${I.info} Fast geschafft</span>`;
      h += `<div class="rtop">
        <div class="row"><h2 style="font-size:1.6rem">Dein ${dayLabel}</h2>${status}</div>
        <div class="vs">
          <div class="kcal"><span class="k">${I.kcal} Kalorien</span><b>${fmt(res.sum.kcal)} kcal</b><small>Ziel ${fmt(t.kcal)} kcal (${devTxt(vd.dk)} %)</small></div>
          <div class="protein"><span class="k">${I.protein} Eiweiß</span><b>${pct(vd.shares.protein)}</b><small>Ziel ${t.ref.protein} %, ${fmt(res.sum.protein)} g</small></div>
          <div class="fat"><span class="k">${I.fat} Fett</span><b>${pct(vd.shares.fat)}</b><small>Ziel ${t.ref.fat} %, ${fmt(res.sum.fat)} g</small></div>
          <div class="carbs"><span class="k">${I.carbs} Kohlenhydrate</span><b>${pct(vd.shares.carbs)}</b><small>Ziel ${t.ref.carbs} %, ${fmt(res.sum.carbs)} g</small></div>
          <div class="sugar"><span class="k">${I.sugar} Zucker</span><b>${fmt(res.sum.sugar)} g</b><small>höchstens ${fmt(vd.sugarMax)} g</small></div>
        </div>
        <details class="small muted"><summary>Wie wir rechnen</summary><p>„Passt“ heißt: Kalorien höchstens 5 % und Fett und Kohlenhydrate höchstens 5 Prozentpunkte und Eiweiß höchstens ${TOL_P} Prozentpunkte von Prof. Dr. Longos Vorgaben entfernt (Brandhorst et al. 2015). Beim Eiweiß rechnen wir bewusst enger, weil Prof. Dr. Longo gerade das Eiweiß niedrig hält. Zucker höchstens ${PLAN_SUGAR} % der Kalorien: Prof. Dr. Longo verlangt „wenig Zucker“ ohne Grammzahl, die Grenze ist unsere Regel. Dein Ziel ist an Deinen Körper angepasst (Faktor ${fmt(p.f, 2)}, Mifflin-St-Jeor-Formel). Diese Anpassung ist unsere eigene Regel.</p></details>
      </div>`;
      if (!vd.ok) {
        const why: string[] = [];
        if (vd.dk < -5) why.push('Mit diesen Lebensmitteln wirst Du noch nicht ganz satt. Da geht noch was!');
        if (vd.dk > 5) why.push('Deine selbst eingetragenen Mengen sind etwas zu viel für heute.');
        if (vd.dev.fat < -5) why.push('Es fehlt noch etwas gutes Fett, zum Beispiel Olivenöl, Nüsse oder Oliven.');
        if (vd.dev.fat > 5) why.push('Etwas zu viel Fett. Mehr Gemüse gleicht das aus.');
        if (vd.dev.carbs < -5) why.push('Es fehlt noch etwas Sättigendes, zum Beispiel Kartoffeln, Kürbis oder Karotten.');
        if (vd.dev.carbs > 5) why.push('Etwas zu viele Kohlenhydrate. Ein Schuss Olivenöl oder ein paar Nüsse gleichen das aus.');
        if (vd.dev.protein > TOL_P) why.push('Etwas zu viel Eiweiß. Beim Scheinfasten darf es davon ruhig weniger sein.');
        if (!vd.sugarOk) why.push('Etwas zu viel Zucker, meist aus süßem Gemüse wie Kürbis, Karotten oder Roter Bete. Kartoffeln oder Hirse sättigen mit weniger Zucker.');
        h += `<div class="alert warn"><p><b>Noch ein kleiner Schritt</b></p>${why.map((w) => `<p>${w}</p>`).join('')}
          ${adds.length ? `<p>Tipp eins davon an, wir rechnen sofort neu:</p><div class="alts">${adds.map((a) => `<button type="button" class="alt" data-add="${esc(a.name)}">${I.plus} ${esc(a.name)} (ca. ${amount(a.name, a.g)})${a.ok ? ' ✓' : ''}</button>`).join('')}</div>` : ''}</div>`;
      }
      // Mengentabelle
      tableHtml = `<details class="stack plain amountsbox"><summary><b>Deine Tagesmengen im Detail</b> <span class="muted small">(ändere ruhig eine Zahl, wir passen den Rest an)</span></summary>
        <div class="tw"><table class="amounts"><thead><tr><th>Lebensmittel</th><th>Menge pro Tag</th><th>kcal</th></tr></thead>
        ${groupByCat(res.items, (it: any) => BY_NAME[it.name]).map((c) => `<tbody><tr class="cat"><th colspan="3" scope="colgroup">${I[c.icon]}${c.label}</th></tr>${c.items.map((it: any) => {
          const f = BY_NAME[it.name];
          const piece = f.piece && it.g ? `<small>etwa ${fmt(it.g / f.piece[1], it.g / f.piece[1] < 3 ? 1 : 0)} ${esc(f.piece[0])}</small>` : '';
          const capNote = f.light === 'y' || f.capWhy !== 'portion' ? `<small>höchstens ${amount(f.name, f.cap)} am Tag${CAP_WHY[f.capWhy] ? `, ${CAP_WHY[f.capWhy]}` : ''}</small>` : '';
          const zero = f.n[0] === 0 ? '<small>so viel Du magst</small>' : it.g === 0 ? '<small>heute nicht nötig</small>' : '';
          const input = f.n[0] === 0 ? '' : `<span class="gcell"><input type="number" inputmode="numeric" min="0" max="${f.cap}" step="5" value="${it.g}" data-g="${esc(f.name)}" aria-label="Menge ${esc(f.name)} in Gramm" /> ${unit(f.name)}</span>${it.fixed ? `<button type="button" class="reset" data-free="${esc(f.name)}">zurücksetzen</button>` : ''}`;
          return `<tr class="${it.g === 0 && f.n[0] > 0 ? 'zero' : ''}"><td class="nm"><span class="nmrow">${mac(f.name)}<span>${esc(f.name)} <span class="dot ${f.light}" title="${LIGHT[f.light]}"></span>${piece}${capNote}${zero}</span></span></td><td>${input}</td><td class="n">${fmt(f.n[0] * it.g / 100)}</td></tr>`;
        }).join('')}</tbody>`).join('')}
        </table></div></details>`;
      // Gelbe Hinweise
      const yellow = ok.filter((x) => BY_NAME[x.name].light === 'y');
      if (yellow.length) {
        h += `<div class="badlist">${yellow.map((x) => { const a = advice(x.name); return `<div class="alert info"><p><b>${esc(x.name)}: gern, aber nur ein bisschen.</b> ${esc(a.why)}</p>${a.alts.length ? `<div class="alts">${a.alts.map((n) => `<button type="button" class="alt" data-add="${esc(n)}" data-replace="${esc(x.name)}">${I.swap} Lieber ${esc(n)}</button>`).join('')}</div>` : ''}</div>`; }).join('')}</div>`;
      }
    }
    // Rote Lebensmittel
    if (red.length) {
      h += `<div class="stack"><h2 style="font-size:1.6rem">Lieber tauschen</h2><p class="muted small">Diese Lebensmittel heben den Fasteneffekt auf. Mit einem Tipp tauschst Du sie gegen etwas, das genauso gut schmeckt.</p><div class="badlist">${red.map((x) => { const a = advice(x.name); return `<div class="alert warn"><p><b>${esc(x.name)}</b>: ${esc(a.why)}</p><p class="small">Probier stattdessen:</p><div class="alts">${a.alts.map((n) => `<button type="button" class="alt" data-add="${esc(n)}" data-replace="${esc(x.name)}">${I.swap} ${esc(n)}</button>`).join('')}</div></div>`; }).join('')}</div></div>`;
    }
    if (res) {
      // Gerichte aus den eigenen Zutaten, nach Mahlzeit sortiert
      const meals = buildMeals(res.items);
      const SLOTS: [string, string][] = [['Mittags', 'Mittagessen'], ['Abends', 'Abendessen'], ['Snack', 'Snack']];
      if (meals.length) {
        h += `<div class="stack"><h2 style="font-size:1.6rem">Deine Rezepte für heute</h2>
          <p class="muted small">Aus Deinen Lebensmitteln, die Mengen sind genau auf Deinen Fastentag berechnet. Salz, Pfeffer und Kräuter nach Lust und Laune.</p>
          ${SLOTS.map(([k, lbl]) => { const ms = meals.filter((m) => m.slot === k); return ms.length ? `<h3 class="slot">${lbl}</h3><div class="meals">${ms.map((m) => `<article class="card meal">
            <div class="meta"><span class="kicker">${m.kind}</span><span class="chip ok">${fmt(m.sum.kcal)} kcal</span></div>
            <h3>${esc(m.title)}</h3>
            <ul class="ing">${m.items.map((i) => `<li>${mac(i.name)}<span>${amount(i.name, i.g)} ${esc(i.name)}</span></li>`).join('')}</ul>
            <ol>${m.steps.map((st) => `<li>${esc(st)}</li>`).join('')}</ol>
            <p class="small muted">${I.time} etwa ${m.minutes} Minuten</p>
          </article>`).join('')}</div>` : ''; }).join('')}</div>`;
      }
      h += tableHtml;
      // Passende Rezepte der Seite, je 1 Portion, nach Mahlzeit
      const rec = matchRecipes(ok.map((x) => x.name), 24);
      if (rec.length) {
        const RS: [string, string][] = [['breakfast', 'Frühstück'], ['main', 'Mittag- und Abendessen'], ['snack', 'Snacks']];
        const card = (m: any, hidden: boolean) => `<a class="card rmatch" href="${base}rezepte/${m.recipe.slug}/"${hidden ? ' hidden data-more' : ''}>
            <img src="${thumb(base, m.recipe.image)}" alt="" loading="lazy" width="110" height="82" />
            <div class="stack" style="gap:6px"><h3>${esc(m.recipe.title)}</h3>
            <p class="small muted">1 Portion · ${fmt(m.n.kcal)} kcal · ${m.recipe.minutes} Minuten</p>
            <ul class="ing small">${m.recipe.ingredients.filter((i: any) => m.hit.includes(i.name)).map((i: any) => `<li>${amountLabel(i.name, i.amount)} ${esc(i.name)}</li>`).join('')}</ul>
            ${m.miss.length ? `<p class="small tasty">${I.plus} Mit ${m.miss.slice(0, 3).map(esc).join(', ').replace(/, ([^,]*)$/, ' und $1')} wird es noch leckerer.</p>` : '<p class="small tasty">Du hast alles da!</p>'}
            </div></a>`;
        h += `<div class="stack"><h2 style="font-size:1.6rem">Unsere Rezepte mit Deinen Zutaten</h2>
          <p class="muted small">Fertig durchgerechnet, jeweils für 1 Portion.</p>
          ${RS.map(([k, lbl]) => { const ms = rec.filter((m) => m.recipe.slot === k); return ms.length ? `<h3 class="slot">${lbl}</h3><div class="grid">${ms.map((m, i) => card(m, i >= 3)).join('')}</div>` : ''; }).join('')}
          ${RS.some(([k]) => rec.filter((m) => m.recipe.slot === k).length > 3) ? `<button type="button" class="btn soft small" data-more-btn>Weitere Rezepte anzeigen</button>` : ''}</div>`;
      }
    } else if (!red.length) {
      h += `<div class="alert info"><p>Füge oben ein paar Lebensmittel hinzu, dann geht's los.</p></div>`;
    }
    h += `<p class="hint noprint">${I.info}<span>Fühlst Du Dich schwindelig oder sehr schlapp, iss einfach normal weiter. Dein Körper geht vor.</span></p>`;
    result.innerHTML = h;
  }

  // Interaktion im Ergebnis
  result.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const mb = t.closest<HTMLElement>('[data-more-btn]');
    if (mb) { result.querySelectorAll<HTMLElement>('[data-more]').forEach((x) => (x.hidden = false)); mb.remove(); return; }
    const b = t.closest<HTMLElement>('[data-add]');
    if (b) { addFood(b.dataset.add!, b.dataset.replace); return; }
    const fr = t.closest<HTMLElement>('[data-free]');
    if (fr) { const p = state.picks.find((x) => x.name === fr.dataset.free); if (p) delete p.g; save(); render(); }
  });
  result.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.dataset.g) return;
    const p = state.picks.find((x) => x.name === t.dataset.g);
    if (!p) return;
    const cap = BY_NAME[p.name].cap;
    const g = Math.max(0, Math.min(cap, Math.round(+t.value || 0)));
    p.g = g;
    save(); render();
  });

  if (state.shown && state.picks.length) { const v = readInputs(); if (v) { state.inputs = v; render(); } }
</script>

<script>
  // Bereiche: Live-Tracking ist Standard, #kochen öffnet Do it yourself. Umschalten über die Leiste oben (ModeNav).
  function show() {
    const diy = location.hash === '#kochen';
    document.getElementById('pane-log')!.hidden = diy;
    document.getElementById('pane-cook')!.hidden = !diy;
    document.querySelectorAll<HTMLAnchorElement>('.modenav a').forEach((a) => {
      const on = a.dataset.mode === (diy ? 'diy' : 'live');
      if (a.dataset.mode !== 'plan') a.toggleAttribute('aria-current', false);
      if (on) a.setAttribute('aria-current', 'page');
    });
    const k = document.getElementById('rk'); const h = document.getElementById('rh'); const l = document.getElementById('rl');
    if (k && h && l) { h.textContent = diy ? 'Was koche ich daraus?' : 'Wie viel geht heute noch?'; l.textContent = diy ? 'Gib ein, was Du zu Hause hast. Wir machen daraus Rezepte mit berechneten Mengen für Deinen Fastentag.' : 'Trag ein, was Du gegessen hast, und sieh, wie viel heute noch geht. Triffst Du Dein Ziel, leuchtet der Tag grün auf.'; }
  }
  document.querySelectorAll<HTMLAnchorElement>('.modenav a:not([data-mode="plan"])').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); history.replaceState(null, '', a.dataset.mode === 'diy' ? '#kochen' : location.pathname + location.search); show();
  }));
  addEventListener('hashchange', show);
  show();
</script>
