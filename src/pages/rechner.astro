---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url.js';
import { icon } from '../lib/icons.js';
import { PLAN, fmt } from '../lib/nutrition.js';
const icons = Object.fromEntries(['kcal', 'protein', 'fat', 'carbs', 'swap', 'check', 'close', 'plus', 'time', 'arrow', 'info', 'pot', 'search', 'sugar', 'leaf', 'nut', 'oil', 'apple', 'herb', 'cup', 'ban', 'calendar', 'heart'].map((k) => [k, icon(k)]));
const quick = ['Zucchini', 'Tomaten', 'Karotten', 'Brokkoli', 'Hokkaido-Kürbis', 'Champignons', 'Kartoffeln', 'Olivenöl', 'Walnusskerne', 'Grüne Oliven'];
const r1 = PLAN.reference.day1, r2 = PLAN.reference.day2to5;
import AffiliateBox from '../components/AffiliateBox.astro';
import StandSichern from '../components/StandSichern.astro';
import Erinnerung from '../components/Erinnerung.astro';
import Rotator from '../components/Rotator.astro';
import ModeNav from '../components/ModeNav.astro';
import { pick } from '../data/affiliate.js';
---
<Base title="Scheinfasten-Rechner: Rezepte aus Deinen Lebensmitteln" active="rechner" description="Gib ein, was Du zu Hause hast: Der Scheinfastenrechner macht daraus Rezepte mit Mengen für Deinen Fastentag, nach den Vorgaben von Prof. Dr. Valter Longo. Mit Vorschlägen, wie Du den Rest lecker füllst.">
  <div class="in page-head split">
    <div class="ph-text">
      <p class="kicker">Scheinfastenrechner</p>
      <h1>Do it yourself: Was koche ich heute?</h1>
      <p class="lead">Trag Deine Mahlzeiten selbst ein oder wähle Rezepte von uns. Den Rest rechnen wir passend zu Deinem Fastentag aus. Weißt Du nicht, was Du kochen sollst, macht der Rezept-Generator aus Deinen Vorräten passende Gerichte. Gegessenes hakst Du einfach ab.</p>
    </div>
    <Rotator images={[
      { src: 'img/menschen/paar-kocht.jpg', alt: 'Paar kocht gemeinsam mit frischem Gemüse' },
      { src: 'img/rechner/gemuese.jpg', alt: '' },
      { src: 'img/menschen/lachen-essen.jpg', alt: '' },
      { src: 'img/rechner/kraeuter.jpg', alt: '' },
      { src: 'img/szenen/kochen-kueche.jpg', alt: '' },
      { src: 'img/szenen/korb-gemuese.jpg', alt: '' },
      { src: 'img/szenen/paar-kueche.jpg', alt: '' },
    ]} />
  </div>
  <ModeNav current="diy" />

  <section class="in calc" id="prof">
    <form id="pf" class="card wcard" novalidate>
      <fieldset class="block">
        <legend><span class="num"><Icon name="user" /></span>Über Dich</legend>
        <div class="field"><span class="lbl">Geschlecht</span>
          <div class="seg three">
            <label><input type="radio" name="sex" value="w" checked /><span>Weiblich</span></label>
            <label><input type="radio" name="sex" value="m" /><span>Männlich</span></label>
            <label><input type="radio" name="sex" value="d" /><span>Divers</span></label>
          </div>
        </div>
        <div class="row3">
          <div class="field"><label for="age" class="lbl">Alter</label><div class="unit"><input id="age" name="age" type="number" inputmode="numeric" min="10" max="100" value="42" required /><span>Jahre</span></div></div>
          <div class="field"><label for="h" class="lbl">Größe</label><div class="unit"><input id="h" name="h" type="number" inputmode="numeric" min="120" max="220" value="168" required /><span>cm</span></div></div>
          <div class="field"><label for="w" class="lbl">Gewicht</label><div class="unit"><input id="w" name="w" type="number" inputmode="decimal" min="35" max="250" step="0.5" value="70" required /><span>kg</span></div></div>
        </div>
        <div class="field"><span class="lbl">Wie aktiv ist Dein Alltag?</span>
          <div class="seg three">
            <label><input type="radio" name="pal" value="1.4" /><span>Eher sitzend</span></label>
            <label><input type="radio" name="pal" value="1.6" checked /><span>Normal</span></label>
            <label><input type="radio" name="pal" value="1.8" /><span>Sehr aktiv</span></label>
          </div>
        </div>
        <div class="field"><span class="lbl">Welcher Fastentag ist heute?</span>
          <div class="seg six" id="days">
            {[1, 2, 3, 4, 5].map((d) => <label><input type="radio" name="day" value={String(d)} checked={d === 1} /><span>Tag {d}<small data-daysum={d}>ca. {fmt(d === 1 ? r1.kcal : r2.kcal)} kcal</small></span></label>)}
            <label><input type="radio" name="day" value="6" /><span>Übergangs&shy;tag</span></label>
          </div>
          <p class="small muted" id="dayhint" aria-live="polite"></p>
        </div>
        <input type="checkbox" name="bf" value="1" id="bfx" hidden />
        <p class="err" id="err1" role="alert" hidden></p>
      </fieldset>
    </form>
    <script is:inline>
      // Eingaben sofort beim Laden wiederherstellen, bevor die Reiter rechnen: erst eigene, sonst aus Rechner oder Planer.
      (function () {
        var get = function (k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } };
        var pf = document.getElementById('pf');
        var prof = get('smlProfil'), plan = get('smlPlaner'), old = get('smlRechner');
        var v = (prof && prof.inputs) || (old && old.inputs) || (plan && plan.inputs) || {};
        ['sex', 'age', 'h', 'w', 'pal'].forEach(function (k) {
          if (v[k] == null) return;
          var el = pf.elements.namedItem(k);
          if (!el) return;
          if (el.length && el[0] && el[0].type === 'radio') { for (var i = 0; i < el.length; i++) el[i].checked = el[i].value === String(v[k]); } else el.value = v[k];
        });
        // Zyklustag aus dem Startdatum im Planer, sonst der zuletzt gewählte Tag
        var day = null, start = plan && plan.inputs && plan.inputs.start;
        if (start) {
          var s = new Date(start + 'T12:00:00'), d = new Date(); d.setHours(12, 0, 0, 0);
          var n = Math.round((d - s) / 86400000) + 1;
          if (n >= 1 && n <= 6) { day = n; pf.dataset.fromPlan = String(n); }
        }
        if (!day && prof && prof.day) day = +prof.day;
        if (day) { var r = pf.querySelector('input[name="day"][value="' + day + '"]'); if (r) r.checked = true; }
        if (pf.dataset.fromPlan) document.getElementById('dayhint').textContent = pf.dataset.fromPlan === '6' ? 'Laut Deinem Plan ist heute der Übergangstag.' : 'Laut Deinem Plan ist heute Tag ' + pf.dataset.fromPlan + '.';
        if ((prof && prof.bf) || (plan && plan.breakfast)) document.getElementById('bfx').checked = true;
      })();
    </script>
  </section>

  <section class="in" id="uebergang" hidden aria-live="polite"></section>
  <div id="pane-cook">
  <section class="in calc" id="calc" data-base={u('')} data-icons={JSON.stringify(icons)}>
    <form id="f" class="card wcard" novalidate>
      <fieldset class="block" id="own">
        <legend><span class="num"><Icon name="cup" /></span>Deine Mahlzeiten</legend>
        <p class="small muted">Trag Dein Essen selbst ein, zum Beispiel einen Sojajoghurt oder Maiswaffeln mit Avocado, oder wähle ein Rezept von uns. Beides lässt sich mischen. Alles zählt sofort in Deinen Tag. Was offen bleibt, füllen wir mit passenden Gerichten auf.</p>
        <p class="taboo small"><Icon name="ban" /><span><b>Diese fünf Tage tabu:</b> Fleisch, Fisch und Eier · Milchprodukte · Zucker und Süßes · Brot, Nudeln und Weißmehl · Alkohol und Säfte. Kaffee höchstens eine kleine Tasse schwarz. <a href={u('wissen/#weglassen')}>Ganze Liste</a></span></p>
        <div class="omeals" id="omeals"></div>
      </fieldset>
      <p class="err" id="err4" role="alert" hidden></p>
      <div class="nav-btns"><button type="submit" class="btn" data-ownsubmit>Meinen Tag berechnen <Icon name="arrow" /></button></div>
      <details class="gen" id="gen">
        <summary><span class="genic"><Icon name="pot" /></span><span><small class="genk">Zusatzoption</small><b>Rezept-Generator: Was hast Du zu Hause?</b><small>Aus Deinen Vorräten schlagen wir passende Rezepte mit Mengen vor.</small></span></summary>
        <div class="genin">
        <p class="small muted">Tipp ein, was Du da hast, ganz ohne Mengen. Der Generator baut daraus die noch offenen Mahlzeiten Deines Tages und rechnet die Mengen passend zu Prof. Dr. Longos Vorgaben aus. Selbst eingetragene Mahlzeiten bleiben, wie sie sind.</p>
        <div class="field combo">
          <label for="q" class="lbl">Lebensmittel hinzufügen</label>
          <div class="search">
            <Icon name="search" />
            <input id="q" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sug" autocomplete="off" placeholder="z. B. Zucchini, Möhre, Feta" />
          </div>
          <ul id="sug" class="sug" role="listbox" hidden></ul>
          <p class="small muted" id="qhint" aria-live="polite"></p>
        </div>
        <div class="quick" aria-label="Schnell hinzufügen">
          <span class="small muted">Schnell dazu:</span>
          {quick.map((n) => <button type="button" class="qchip" data-add={n}><Icon name="plus" />{n}</button>)}
        </div>
        <div class="picked" id="picked" aria-label="Deine Lebensmittel"></div>
        <p class="small muted legendline"><span class="lg"><span class="dot g"></span>passt gut</span><span class="lg"><span class="dot y"></span>nur kleine Menge</span><span class="lg"><span class="dot r"></span>passt nicht</span></p>
        <p class="small muted legendline"><span>Farbe des Symbols:</span><span class="lg"><span class="mac carbs"><Icon name="carbs" /></span>Kohlenhydrate</span><span class="lg"><span class="mac protein"><Icon name="protein" /></span>Eiweiß</span><span class="lg"><span class="mac fat"><Icon name="fat" /></span>Fett</span><span class="lg"><span class="mac zero"><Icon name="leaf" /></span>kaum Kalorien</span></p>
        <p class="err" id="err3" role="alert" hidden></p>
        <div class="nav-btns"><button type="submit" class="btn soft">Rezepte vorschlagen <Icon name="arrow" /></button></div>
        </div>
      </details>
      <p class="hint"><Icon name="heart" /><span>Kurz zur Sicherheit: Wenn Du schwanger bist, stillst, Medikamente nimmst oder eine ernste Erkrankung hast, sprich vorher kurz mit Deiner Ärztin oder Deinem Arzt. <a href={u('fuer-wen-nicht/')}>Mehr dazu</a></span></p>
    </form>
  </section>

  <section class="in result" id="result" hidden aria-live="polite"></section>
  </div>
  <StandSichern />
  <Erinnerung />
  <div class="in narrow" style="padding-block:24px 56px"><AffiliateBox items={pick('waage', 'oel', 'oel_manira', 'nuesse', 'kuerbiskerne', 'tahin')} title="Gut abgewogen" lead="Öl und Nüsse machen den größten Teil der Kalorien aus. Schon 5 g mehr verschieben die Werte deutlich." /></div>

  <div class="in narrow small muted srcnote">
    <p>Nährwerte: Max Rubner-Institut (2025), Bundeslebensmittelschlüssel (BLS) Version 4.0, <a href="https://doi.org/10.25826/Data20251217-134202-0" rel="noopener">DOI 10.25826/Data20251217-134202-0</a>, Lizenz <a href="https://creativecommons.org/licenses/by/4.0/deed.de" rel="noopener">CC BY 4.0</a>. Wir haben die Werte auf vier Kennzahlen reduziert. Kohlenhydrate sind inklusive Ballaststoffe angegeben und zählen wie in Prof. Dr. Longos US-Angaben mit 4 kcal je Gramm. Die Prozente beziehen sich deshalb auf die Energie aus Eiweiß, Fett und Kohlenhydraten und ergeben zusammen 100 %. Für einige Kräuter, Gewürze und Spezialprodukte ohne BLS-Eintrag nutzen wir Richtwerte aus der USDA-Datenbank. Für pflanzliche Joghurts, Drinks und Kochcremes, die im BLS fehlen, nutzen wir Mittelwerte aus den Nährwertangaben mehrerer Hersteller. Einzelne Marken weichen davon ab, ein Blick auf die Packung lohnt sich.</p>
    <p>Sollwerte: Brandhorst S et al., Cell Metab 2015, Methoden (Labor von Prof. Dr. Longo). Wei M et al., Sci Transl Med 2017 nennt für Tag 2 bis 5 dieselben Anteile bei ca. 3.000 kJ (ca. 717 kcal). Kaffee höchstens eine kleine Tasse: Empfehlung des ProLon-Herstellers L-Nutra, nicht aus den Studien. Die Zuckergrenze von höchstens 15 % der Kalorien ist unsere eigene Regel, weil Prof. Dr. Longo nur „wenig Zucker“ ohne Grammzahl angibt. Die Obergrenzen je Lebensmittel und die Einteilung in Ampelfarben sind unsere eigenen Richtwerte, abgeleitet aus Prof. Dr. Longos Makroverteilung. Diese Seite wird von Prof. Dr. Longo weder geprüft noch unterstützt.</p>
  </div>
</Base>

<style is:global>
  .calc { max-width: 820px; padding-bottom: 40px; }
  .calc .wcard { padding: clamp(18px, 4vw, 30px); gap: 30px; }
  .block { border: 0; padding: 0; margin: 0; display: grid; gap: 18px; min-width: 0; }
  .block legend { font-family: var(--display); font-size: 1.5rem; display: flex; align-items: center; gap: 10px; padding: 0; margin-bottom: 4px; }
  .block .num { width: 32px; height: 32px; border-radius: 50%; background: var(--green); color: var(--on-green); display: grid; place-items: center; font: 700 .95rem var(--body); flex: none; }
  .seg.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .seg.six { grid-template-columns: repeat(5, minmax(0, 1fr)) minmax(0, 1.5fr); }
  .seg.six label:last-child span { padding-inline: 4px; }
  @media (max-width: 640px) { .seg.six { grid-template-columns: repeat(3, minmax(0, 1fr)); } .seg.six label:last-child span { font-size: .92rem; padding-inline: 2px; hyphens: manual; -webkit-hyphens: manual; } }
  #uebergang { max-width: 820px; padding-bottom: 40px; display: grid; gap: 0; }
  #prof { padding-bottom: 18px; }
  .tabsw { padding-bottom: 18px; }
  .tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 6px; background: var(--band); border-radius: 18px; }
  .tabs button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; border: 0; border-radius: 13px; padding: 12px 10px; min-height: 48px; font: 700 .98rem/1.2 var(--body); background: none; color: var(--muted); cursor: pointer; }
  .tabs button[aria-selected="true"] { background: var(--card); color: var(--green); box-shadow: var(--shadow); }
  .tabs button:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .tabs .i { width: 1.1em; height: 1.1em; }
  .combo { position: relative; }
  .search { position: relative; }
  .search .i { position: absolute; left: 14px; top: 50%; translate: 0 -50%; color: var(--muted); }
  .search input { padding-left: 42px; }
  .sug { list-style: none; margin: 0; padding: 6px; position: absolute; left: 0; right: 0; top: calc(100% - 22px); z-index: 20; background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); max-height: 340px; overflow-y: auto; }
  .sug li { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; cursor: pointer; }
  .sug li[aria-selected="true"], .sug li:hover { background: var(--band); }
  .sug li small { color: var(--muted); margin-left: auto; font-size: .78rem; }
  .dot { display: inline-block; width: 11px; height: 11px; border-radius: 50%; flex: none; vertical-align: -1px; }
  .dot.g { background: var(--ok); } .dot.y { background: var(--sun); } .dot.r { background: var(--bad); }
  .legendline { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .legendline .lg { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .quick { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .qchip, .pchip, .alt { display: inline-flex; align-items: center; gap: 6px; font: 600 .88rem/1.2 var(--body); padding: 8px 12px; min-height: 38px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); color: var(--fg); cursor: pointer; }
  .qchip:hover, .alt:hover { border-color: var(--green); color: var(--green); }
  .qchip[disabled] { opacity: .45; cursor: default; }
  .qchip .i, .alt .i { width: 1em; height: 1em; }
  .picked { display: grid; gap: 12px; }
  .pgroup { display: grid; gap: 6px; }
  .pgroup ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .catlbl { display: flex; gap: 6px; align-items: center; font-size: .78rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .catlbl .i { color: var(--green); }
  .taboo { display: flex; gap: 10px; align-items: flex-start; background: var(--bad-bg); border-radius: 14px; padding: 10px 14px; }
  .taboo .i { color: var(--bad); margin-top: 2px; }
  .picked:empty::before { content: "Noch nichts ausgewählt."; color: var(--muted); font-size: .92rem; }
  .pchip { cursor: default; background: var(--card); }
  .pchip button { border: 0; background: none; color: var(--muted); cursor: pointer; padding: 2px; display: grid; place-items: center; min-height: 0; }
  .pchip button .i { width: 1em; height: 1em; }
  .pchip.r { border-color: var(--bad); background: var(--bad-bg); }
  .pchip.y { border-color: var(--sun); }

  .result { display: grid; gap: 28px; padding-bottom: 50px; max-width: 980px; }
  .rtop { display: grid; gap: 14px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(16px, 3vw, 24px); }
  .rtop .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .amounts td input { width: 92px; min-height: 40px; padding: 6px 10px; text-align: right; font-weight: 700; }
  .amounts td.nm { font-weight: 600; }
  .amounts td.nm small { display: block; font-weight: 400; color: var(--muted); }
  .amounts .zero td { color: var(--muted); }
  .amounts tr.cat th { background: var(--band); color: var(--fg); font-size: .8rem; padding: 9px 14px; }
  .amounts tr.cat th .i { color: var(--green); margin-right: 8px; vertical-align: -3px; }
  .nmrow { display: flex; gap: 8px; align-items: flex-start; }
  .nmrow .mac { margin-top: 2px; }
  .meal ul.ing { list-style: none; padding-left: 0; }
  .meal ul.ing li { display: flex; gap: 8px; align-items: center; }
  .amounts .reset { border: 0; background: none; color: var(--green); font: 600 .8rem var(--body); cursor: pointer; padding: 4px; min-height: 0; }
  .gcell { display: flex; align-items: center; gap: 6px; }
  .alts { display: flex; flex-wrap: wrap; gap: 8px; }
  .badlist { display: grid; gap: 12px; }
  .badlist .alert p b { font-weight: 800; }
  .meals { display: grid; gap: 14px; }
  .meal ul { margin: 0; padding-left: 18px; display: grid; gap: 2px; font-size: .93rem; }
  .meal ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: .93rem; }
  .meal h3 { font-size: 1.2rem; }
  /* Gleiche Anordnung wie im fertigen Plan: Foto links (112 px, mobil 76 px), Inhalt rechts */
  .card.meal { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; padding: 14px; align-items: start; }
  @media (max-width: 560px) { .card.meal { grid-template-columns: 76px minmax(0, 1fr); gap: 12px; } }
  .meal .mimg { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; }
  .meal .info { display: grid; gap: 8px; min-width: 0; }
  .meal .meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .rmatch { display: grid; grid-template-columns: 88px 1fr; gap: 14px; align-items: start; text-decoration: none; color: inherit; }
  .rmatch img { width: 88px; height: 66px; object-fit: cover; border-radius: 12px; }
  .rmatch h3 { font-size: 1.1rem; }
  .rmatch p { font-size: .88rem; }
  .srcnote { display: grid; gap: 8px; padding-bottom: 40px; }
  /* Eigene Mahlzeiten */
  .omeals { display: grid; gap: 12px; }
  .omeal { border: 1.5px solid var(--line); border-radius: 16px; padding: 12px 14px; display: grid; gap: 12px; background: var(--bg); }
  .omeal.on { border-color: var(--green); }
  .ohead { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; }
  .ohead > b { font-size: 1.02rem; }
  .oseg { display: inline-grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; padding: 4px; background: var(--band); border-radius: 12px; }
  .oseg label { position: relative; cursor: pointer; }
  .oseg input { position: absolute; opacity: 0; width: 1px; height: 1px; min-height: 0; }
  .oseg span { display: block; text-align: center; padding: 8px 12px; border-radius: 9px; font: 700 .86rem/1.2 var(--body); color: var(--muted); white-space: nowrap; }
  .oseg input:checked + span { background: var(--card); color: var(--green); box-shadow: var(--shadow); }
  .oseg input:focus-visible + span { outline: 3px solid var(--sun); outline-offset: 2px; }
  .orm { border: 0; background: none; color: var(--muted); cursor: pointer; font: 600 .84rem var(--body); display: inline-flex; gap: 4px; align-items: center; padding: 6px; min-height: 0; }
  .orm .i { width: 1em; height: 1em; }
  .oedit { display: grid; gap: 10px; }
  .osaved { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .osaved .qchip { min-height: 34px; padding: 6px 10px; }
  .osaved .qchip button { border: 0; background: none; color: var(--muted); padding: 0 0 0 4px; min-height: 0; cursor: pointer; display: grid; place-items: center; }
  .oitems { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .oitems li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 10px; align-items: center; padding: 8px 10px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); }
  .oitems .onm { display: flex; gap: 8px; align-items: center; font-weight: 600; min-width: 0; }
  .oitems .onm small { color: var(--muted); font-weight: 400; white-space: nowrap; }
  .oqty { display: flex; gap: 6px; align-items: center; }
  .oqty input { width: 76px; min-height: 40px; padding: 6px 8px; text-align: right; font-weight: 700; }
  .oqty select { width: auto; min-height: 40px; padding: 6px 8px; max-width: 170px; }
  .oqty button { border: 0; background: none; color: var(--muted); cursor: pointer; padding: 6px; min-height: 0; display: grid; place-items: center; }
  .oqty button .i { width: 1.05em; height: 1.05em; }
  @media (max-width: 560px) { .oitems li { grid-template-columns: 1fr; } .oqty { justify-content: flex-end; } .ohead { align-items: stretch; flex-direction: column; } .oseg { display: grid; } }
  .osum { display: grid; gap: 6px; font-size: .9rem; }
  .osum .orow { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  .osum ul { margin: 0; padding-left: 18px; display: grid; gap: 2px; }
  .osum.g ul { display: none; }
  .osave { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .osave input { width: auto; flex: 1 1 180px; min-height: 40px; padding: 6px 10px; }
  .osave .btn { min-height: 40px; padding: 8px 16px; }
  .linkbtn { border: 0; background: none; color: var(--green); font: 700 .86rem var(--body); cursor: pointer; padding: 4px 0; min-height: 0; display: inline-flex; gap: 6px; align-items: center; }
  .linkbtn .i { width: 1em; height: 1em; }
  .calc .nav-btns { justify-content: flex-end; }
  .gen { border: 1px dashed var(--line); border-radius: 14px; background: transparent; }
  .gen[open] { background: var(--band); border-style: solid; }
  .gen > summary { display: flex; gap: 10px; align-items: center; padding: 10px 14px; cursor: pointer; list-style: none; color: var(--muted); }
  .gen > summary::-webkit-details-marker { display: none; }
  .gen > summary > span:not(.genic) { display: grid; gap: 1px; min-width: 0; }
  .gen > summary b { font-size: .95rem; color: var(--fg); }
  .gen > summary small { font-size: .82rem; }
  .gen .genk { text-transform: uppercase; letter-spacing: .08em; font-size: .7rem !important; font-weight: 700; }
  .gen .genic { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; flex: none; color: var(--muted); }
  .gen > summary::after { content: "+"; margin-left: auto; font: 700 1.2rem/1 var(--body); color: var(--muted); flex: none; }
  .gen[open] > summary::after { content: "\2212"; }
  .gen > summary:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; border-radius: 14px; }
  .gen .btn.soft { background: var(--card); border: 1px solid var(--line); }
  .genin { display: grid; gap: 16px; padding: 4px 14px 16px; min-width: 0; }
  .block .num .i { width: 18px; height: 18px; }
  .otog { border: 0; background: none; cursor: pointer; padding: 8px 12px; border-radius: 9px; font: 700 .86rem/1.2 var(--body); color: var(--muted); white-space: nowrap; min-height: 0; }
  .otog[aria-pressed="true"] { background: var(--card); color: var(--green); box-shadow: var(--shadow); }
  .otog:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
  .ok-ic { color: var(--green); display: inline-grid; vertical-align: -3px; }
  .ok-ic .i { width: 1.05em; height: 1.05em; }
  .oplus { display: flex; align-items: center; gap: 8px; margin: -4px 0; }
  .oplus::before, .oplus::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .oplus button { width: 30px; height: 30px; min-height: 0; padding: 0; border-radius: 50%; border: 1.5px solid var(--line); background: var(--bg); color: var(--green); cursor: pointer; display: grid; place-items: center; }
  .oplus button:hover, .oplus button:focus-visible { border-color: var(--green); background: var(--green-soft); }
  .oplus button .i { width: 16px; height: 16px; }
  .omeal.zw { border-style: dashed; }
  .omeal.zw .ohead { flex-direction: row; align-items: center; }
  .ofoot { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; }
  .ofin { min-height: 40px; padding: 8px 18px; background: var(--green); color: var(--on-green); }
  .ofin:hover { background: var(--green-d); }
  .odone { display: grid; gap: 6px; }
  .odone p { margin: 0; }
  .odone .linkbtn { justify-self: start; }
  .orecs { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
  .orec { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 10px; align-items: center; text-align: left; padding: 6px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--card); color: var(--fg); cursor: pointer; font: inherit; min-height: 0; }
  .orec:hover, .orec:focus-visible { border-color: var(--green); }
  .orec img, .ochosen img { width: 64px; height: 48px; object-fit: cover; border-radius: 8px; }
  .orec span { display: grid; gap: 2px; min-width: 0; }
  .orec b { font-size: .9rem; line-height: 1.25; }
  .orec small { color: var(--muted); font-size: .78rem; }
  .ochosen { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; align-items: center; }
  .ochosen > div { display: grid; gap: 6px; }
  .ochosen select { width: auto; min-height: 38px; padding: 4px 8px; margin-left: 6px; }
  .tipbox { border-radius: var(--radius); background: var(--warn-bg); border-left: 5px solid var(--warn); }
  .tipbox summary { display: flex; gap: 10px; align-items: flex-start; padding: 14px 16px; cursor: pointer; list-style: none; }
  .tipbox summary::-webkit-details-marker { display: none; }
  .tipbox summary .i { color: var(--warn); margin-top: 3px; flex: none; }
  .tipbox summary span { display: grid; gap: 2px; }
  .tipbox summary small { color: var(--muted); }
  .tipbox summary::after { content: "+"; margin-left: auto; font: 700 1.3rem/1 var(--body); color: var(--warn); }
  .tipbox[open] summary::after { content: "\2212"; }
  .tipin { padding: 0 16px 16px 46px; display: grid; gap: 8px; }
  .tipin p { margin: 0; }
  .amounts tr.fixed td { color: var(--muted); }
  .mimg.ownimg { display: grid; place-items: center; background: var(--band); color: var(--green); }
  .mimg.ownimg .i { width: 40%; height: 40%; }
  .meal .onotes { margin: 0; padding-left: 18px; font-size: .88rem; }
  @media print { .calc, .noprint { display: none !important; } }
</style>

<script>
  import { FOODS, BY_NAME, search, norm, profile, targets, solve, suggestAdditions, completeDay, buildMeals, matchRecipes, advice, amount, unit, CAP_WHY } from '../lib/rechner.js';
  import { fmt, PLAN, amountLabel, RECIPES, nutrition, NUTRIENTS as NUTRI } from '../lib/nutrition.js';
  import { groupByCat, foodBadge } from '../lib/foodmeta.js';
  import { thumb, thumbIn } from '../lib/url.js';
  import { doneHtml } from '../lib/fortschritt.js';
  import { TRANSITION_SLUGS, transitionHtml, nextCycleHtml, addDays } from '../lib/uebergang.js';
  import { searchAll, units, defaultAmount, qtyLabel, mealCheck, plural } from '../lib/tagebuch.js';
  const PLAN_SUGAR = PLAN.reference.sugarMaxPercent;
  const TOL_P = PLAN.reference.tolerance.proteinPoints ?? PLAN.reference.tolerance.macroPoints;

  const root = document.getElementById('calc')!;
  const base = root.dataset.base!;
  const I = JSON.parse(root.dataset.icons!);
  const form = document.getElementById('f') as HTMLFormElement;
  const result = document.getElementById('result')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const sug = document.getElementById('sug')!;
  const qhint = document.getElementById('qhint')!;
  const picked = document.getElementById('picked')!;
  const STORE = 'smlRechner';
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const LIGHT: Record<string, string> = { g: 'passt gut', y: 'nur kleine Menge', r: 'passt nicht' };
  // Symbol vor jedem Lebensmittel: Bild = Lebensmittelart, Farbe = Hauptnährstoff (grau = kaum Kalorien)
  const mac = (name: string) => BY_NAME[name] ? foodBadge(name, BY_NAME[name]) : '<span class="mac none" aria-hidden="true"></span>';

  type Pick = { name: string; g?: number };
  // Selbst eingetragene Mahlzeiten: Einträge wie im Tagebuch, {type: 'food', name, qty, unit} oder {type: 'recipe', slug, qty, unit: 'portion'}
  type Entry = { type: 'food' | 'recipe'; name?: string; slug?: string; qty: number; unit: string };
  type Own = { d: string; mode: Record<string, string>; items: Record<string, Entry[]>; rec: Record<string, { slug: string; qty: number }>; fin: Record<string, boolean>; zw: { id: string; pos: number; items: Entry[] }[] };
  let state: { inputs?: any; picks: Pick[]; shown?: boolean; done?: Record<string, Record<string, boolean>>; own?: Own } = { picks: [] };
  try { const s = JSON.parse(localStorage.getItem(STORE) || 'null'); if (s && Array.isArray(s.picks)) state = s; } catch {}
  state.picks = state.picks.filter((p) => BY_NAME[p.name]);
  // Körperdaten und Fastentag stehen im gemeinsamen Formular oben (#pf), für beide Reiter.
  const pf = document.getElementById('pf') as HTMLFormElement;
  const save = () => { try { localStorage.setItem(STORE, JSON.stringify(state)); } catch {} };
  const isoToday = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };

  // ---------- Eigene Mahlzeiten ----------
  // Je feste Mahlzeit: '' = wir planen (Frühstück: keins, Mittag und Abend: Gericht aus Deinen Lebensmitteln),
  // 'rezept' = Rezept der Seite auswählen, 'selbst' = selbst eintragen. Zwischenmahlzeiten über das kleine „+“.
  const bfx = document.getElementById('bfx') as HTMLInputElement;
  const omeals = document.getElementById('omeals')!;
  const SAVED = 'smlMeineMahlzeiten';
  const FIXED: [string, string, string][] = [['bf', 'Frühstück', 'Morgens'], ['mi', 'Mittagessen', 'Mittags'], ['ab', 'Abendessen', 'Abends']];
  const POS_TXT = ['vor dem Frühstück', 'zwischen Frühstück und Mittagessen', 'zwischen Mittag- und Abendessen', 'nach dem Abendessen'];
  const SHARE: Record<string, number> = { bf: 0.22, mi: 0.35, ab: 0.35 };
  const BYSLUG: Record<string, any> = Object.fromEntries(RECIPES.map((r: any) => [r.slug, r]));
  const validEntry = (e: Entry) => e && (e.type === 'recipe' ? !!BYSLUG[e.slug!] : !!BY_NAME[e.name!]);
  // Eingetragenes gilt für den Kalendertag. Am nächsten Tag startet der Bereich leer, gespeicherte „Meine Mahlzeiten“ bleiben.
  const freshOwn = (): Own => ({ d: isoToday(), mode: { bf: bfx.checked ? 'rezept' : '', mi: '', ab: '' }, items: { bf: [], mi: [], ab: [] }, rec: {}, fin: {}, zw: [] });
  if (!state.own || state.own.d !== isoToday()) state.own = freshOwn();
  const own = () => state.own!;
  {
    const o = own();
    // Ältere Stände: „Keins“ und „Rezept vorschlagen“ heißen jetzt: wir planen
    if (o.mode.bf === 'kein') o.mode.bf = '';
    for (const k of ['mi', 'ab']) if (o.mode[k] === 'rezept' && !o.rec?.[k]) o.mode[k] = '';
    o.rec = Object.fromEntries(Object.entries(o.rec || {}).filter(([, r]) => r && BYSLUG[r.slug]));
    o.fin = o.fin || {};
    for (const k of ['bf', 'mi', 'ab']) o.items[k] = (o.items[k] || []).filter(validEntry);
    o.zw = (o.zw || []).map((z) => ({ ...z, pos: z.pos ?? 3, items: (z.items || []).filter(validEntry) }));
  }
  let saved: { name: string; items: Entry[] }[] = [];
  try { const x = JSON.parse(localStorage.getItem(SAVED) || '[]'); if (Array.isArray(x)) saved = x.map((m) => ({ name: String(m.name || 'Meine Mahlzeit').slice(0, 40), items: (m.items || []).filter(validEntry) })).filter((m) => m.items.length); } catch {}
  const saveSaved = () => { try { localStorage.setItem(SAVED, JSON.stringify(saved)); } catch {} };
  const entriesOf = (k: string): Entry[] => (k.startsWith('z') ? own().zw.find((z) => z.id === k)?.items || [] : own().items[k] || []);
  const entryName = (e: Entry) => (e.type === 'recipe' ? BYSLUG[e.slug!].title : e.name!);
  const curDay = () => +((pf.elements.namedItem('day') as RadioNodeList).value || 1);
  const curProfile = () => {
    const fd = Object.fromEntries(new FormData(pf).entries()) as any;
    return profile({ sex: fd.sex, age: +fd.age || 42, h: +fd.h || 168, w: +fd.w || 70, pal: +fd.pal || 1.6 });
  };
  const curTargets = () => targets(curDay() === 1 ? 1 : 2, curProfile().f);
  // Die Kalorien an den Tag-Knöpfen sind dieselben wie das Ziel im Ergebnis: an Deinen Körper angepasst.
  function updateDaySums() {
    const f = curProfile().f;
    document.querySelectorAll<HTMLElement>('[data-daysum]').forEach((el) => {
      const ref = el.dataset.daysum === '1' ? PLAN.reference.day1 : PLAN.reference.day2to5;
      el.textContent = `ca. ${fmt(Math.round(ref.kcal * f / 10) * 10)} kcal`;
    });
  }
  const LCHIP: Record<string, [string, string]> = { g: ['ok', 'Passt gut'], y: ['warn', 'Geht, aber'], r: ['bad', 'Passt nicht'] };
  /** Einträge einer Mahlzeit, auch ein ausgewähltes Rezept (als Portionen). */
  const mealEntries = (k: string): Entry[] => {
    if (k.startsWith('z')) return entriesOf(k);
    const o = own();
    if (o.mode[k] === 'selbst') return o.items[k];
    if (o.mode[k] === 'rezept' && o.rec[k]) return [{ type: 'recipe', slug: o.rec[k].slug, qty: o.rec[k].qty, unit: 'portion' }];
    return [];
  };
  function sumHtml(k: string, short = false) {
    const es = mealEntries(k);
    if (!es.length) return '<p class="small muted">Noch nichts eingetragen.</p>';
    const c = mealCheck(es, curTargets(), curDay(), !k.startsWith('z'));
    const [cls, lbl] = LCHIP[c.light];
    const row = `<div class="orow"><span class="chip ${cls}"><span class="dot ${c.light}" aria-hidden="true"></span>${lbl}</span><b>${fmt(c.sum.kcal)} kcal</b>${short ? '' : `<span class="muted">Eiweiß ${fmt(c.shares.protein)} % · Fett ${fmt(c.shares.fat)} % · Kohlenhydrate ${fmt(c.shares.carbs)} %</span>`}</div>`;
    if (short) return row;
    return `${row}${c.notes.length ? `<ul>${c.notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>` : '<p class="small muted">Passt zu Prof. Dr. Longos Vorgaben. Fett und Kohlenhydrate gleicht der Rest des Tages aus.</p>'}`;
  }
  function itemHtml(k: string, e: Entry, i: number) {
    const us = units(e);
    const isG = us.find((u: any) => u[0] === e.unit)?.[2] === 1 && e.type !== 'recipe';
    const f = e.type === 'food' ? BY_NAME[e.name!] : null;
    const dot = f ? `<span class="dot ${f.light}" title="${LIGHT[f.light]}"></span>` : `<span class="dot g" title="Rezept der Seite"></span>`;
    const opts = us.map((u: any) => `<option value="${u[0]}"${u[0] === e.unit ? ' selected' : ''}>${u[2] === 1 ? u[1] : `${plural(u[1], e.qty)} (${fmt(u[2])} ${us[0][1]})`}</option>`).join('');
    return `<li><span class="onm">${dot}<span>${esc(entryName(e))}${e.type === 'recipe' ? ' <small>Rezept</small>' : ''}</span></span>
      <span class="oqty"><input type="number" inputmode="decimal" min="0" step="${isG ? 5 : 0.5}" value="${e.qty}" data-oq="${k}:${i}" aria-label="Menge ${esc(entryName(e))}" />
      <select data-ou="${k}:${i}" aria-label="Einheit ${esc(entryName(e))}">${opts}</select>
      <button type="button" data-orm="${k}:${i}" aria-label="${esc(entryName(e))} entfernen">${I.close}</button></span></li>`;
  }
  const finBtn = (k: string) => `<button type="button" class="btn small ofin" data-ofin="${k}">${I.check} Fertig</button>`;
  function editorHtml(k: string, label: string) {
    const es = entriesOf(k);
    return `<div class="oedit">
      ${saved.length ? `<div class="osaved"><span class="small muted">Meine Mahlzeiten:</span>${saved.map((m, i) => `<span class="qchip"><span role="button" tabindex="0" data-oload="${k}:${i}">${I.plus}${esc(m.name)}</span><button type="button" data-odel="${i}" aria-label="${esc(m.name)} aus Meine Mahlzeiten löschen">${I.close}</button></span>`).join('')}</div>` : ''}
      <div class="combo"><div class="search">${I.search}<input type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="osug-${k}" autocomplete="off" data-os="${k}" aria-label="${esc(label)}: Lebensmittel oder Rezept suchen" placeholder="Was gab es? z. B. Sojajoghurt, Maiswaffel" /></div>
      <ul class="sug" id="osug-${k}" role="listbox" hidden></ul></div>
      ${es.length ? `<ul class="oitems">${es.map((e, i) => itemHtml(k, e, i)).join('')}</ul>` : ''}
      <div class="osum" data-osum="${k}">${sumHtml(k)}</div>
      ${es.length ? `<div class="ofoot"><div class="osave" data-osave="${k}"><button type="button" class="linkbtn" data-oask="${k}">${I.heart} Als „Meine Mahlzeit“ merken</button></div>${finBtn(k)}</div>` : ''}
    </div>`;
  }
  /** Passende Portion eines Rezepts für diese Mahlzeit: ihr Anteil am Tagesziel, in Viertelschritten. */
  const portionFor = (k: string, slug: string) => {
    const kcal1 = nutrition(BYSLUG[slug]).kcal || 1;
    return Math.min(2, Math.max(0.5, Math.round(curTargets().kcal * (SHARE[k] || 0.3) / kcal1 * 4) / 4));
  };
  const portionTxt = (q: number) => `${q.toLocaleString('de-DE', { maximumFractionDigits: 2 })} ${q === 1 ? 'Portion' : 'Portionen'}`;
  const recQuery: Record<string, string> = {};
  const recMore: Record<string, boolean> = {};
  function recCards(k: string) {
    const slot = k === 'bf' ? 'breakfast' : 'main';
    const have = new Set(state.picks.map((p) => p.name));
    const tq = norm(recQuery[k] || '');
    let list = RECIPES.filter((r: any) => (tq ? norm(`${r.title} ${r.short}`).includes(tq) : r.slot === slot || (slot === 'main' && r.slot === 'side')));
    // Rezepte mit Deinen Lebensmitteln zuerst
    list = list.map((r: any) => ({ r, hit: r.ingredients.filter((i: any) => have.has(i.name)).length })).sort((a: any, b: any) => b.hit - a.hit || a.r.title.localeCompare(b.r.title, 'de')).map((x: any) => x.r);
    const shown = recMore[k] || tq ? list : list.slice(0, 6);
    if (!shown.length) return '<p class="small muted">Kein Rezept gefunden. Probier ein anderes Wort.</p>';
    return `<div class="orecs">${shown.map((r: any) => `<button type="button" class="orec" data-orec="${k}:${r.slug}"><img src="${thumb(base, r.image)}" alt="" loading="lazy" width="80" height="60" /><span><b>${esc(r.title)}</b><small>${fmt(nutrition(r).kcal)} kcal je Portion · ${r.minutes} Min.</small></span></button>`).join('')}</div>
      ${!tq && !recMore[k] && list.length > 6 ? `<button type="button" class="linkbtn" data-oremore="${k}">${I.plus} Alle ${list.length} Rezepte zeigen</button>` : ''}`;
  }
  function pickerHtml(k: string) {
    const r0 = own().rec[k];
    if (r0) {
      const r = BYSLUG[r0.slug];
      const portions = [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];
      return `<div class="oedit"><div class="ochosen"><img src="${thumb(base, r.image)}" alt="" width="80" height="60" /><div><b><a href="${base}rezepte/${r.slug}/">${esc(r.title)}</a></b>
        <label class="small">Menge <select data-oportion="${k}">${portions.map((p) => `<option value="${p}"${p === +r0.qty ? ' selected' : ''}>${portionTxt(p)}</option>`).join('')}</select></label></div></div>
        <div class="osum" data-osum="${k}">${sumHtml(k)}</div>
        <div class="ofoot"><button type="button" class="linkbtn" data-orecx="${k}">${I.swap} Anderes Rezept</button>${finBtn(k)}</div></div>`;
    }
    return `<div class="oedit">
      <p class="small muted">${k === 'bf' ? 'Tipp ein Frühstück an. Ohne Auswahl nehmen wir eins, das zu Deinen Lebensmitteln passt.' : 'Tipp ein Rezept an. Ohne Auswahl machen wir ein Gericht aus Deinen Lebensmitteln.'} Die Menge rechnen wir passend zu Deinem Tag aus.</p>
      <div class="search">${I.search}<input type="search" data-orq="${k}" value="${esc(recQuery[k] || '')}" aria-label="Rezept suchen" placeholder="Rezept suchen, z. B. Minestrone" autocomplete="off" /></div>
      <div data-orecbox="${k}">${recCards(k)}</div></div>`;
  }
  /** Kurzfassung einer abgeschlossenen Mahlzeit. */
  function doneHtml2(k: string) {
    const es = mealEntries(k);
    const what = es.map((e) => (e.type === 'recipe' ? `${portionTxt(+e.qty)} ${BYSLUG[e.slug!].title}` : `${qtyLabel(e).replace(/ \(.*\)$/, '')} ${e.name}`)).join(', ');
    return `<div class="odone"><p class="small">${esc(what)}</p><div data-osumshort="${k}">${sumHtml(k, true)}</div><button type="button" class="linkbtn" data-oedit="${k}">Bearbeiten</button></div>`;
  }
  const plusBtn = (pos: number) => `<div class="oplus"><button type="button" data-ozadd="${pos}" aria-label="Zwischenmahlzeit ${POS_TXT[pos]} einfügen" title="Zwischenmahlzeit ${POS_TXT[pos]}">${I.plus}</button></div>`;
  function renderOwn() {
    const o = own();
    const hint = (k: string) => (k === 'bf' ? 'Kein Frühstück. Wähle Rezept oder Selbst eintragen, wenn Du frühstückst.' : 'Noch offen. Wähle ein Rezept oder trag selbst ein. Sonst planen wir ein passendes Gericht für Dich.');
    const tog = (k: string, v: string, l: string) => `<button type="button" class="otog" data-om="${k}" data-v="${v}" aria-pressed="${o.mode[k] === v}">${l}</button>`;
    const zws = (pos: number) => o.zw.filter((z) => z.pos === pos).map((z) => `<div class="omeal on zw" data-k="${z.id}"><div class="ohead"><b>Zwischenmahlzeit${o.fin[z.id] && z.items.length ? ` <span class="ok-ic">${I.check}</span>` : ''}</b><button type="button" class="orm" data-ozrm="${z.id}">${I.close} Entfernen</button></div>${o.fin[z.id] && z.items.length ? doneHtml2(z.id) : editorHtml(z.id, 'Zwischenmahlzeit')}</div>`).join('');
    let h = '';
    FIXED.forEach(([k, label], idx) => {
      h += zws(idx) + plusBtn(idx);
      const m = o.mode[k];
      const fin = o.fin[k] && mealEntries(k).length;
      h += `<div class="omeal${m ? ' on' : ''}" data-k="${k}">
