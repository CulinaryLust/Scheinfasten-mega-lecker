    }
    const del = t.closest<HTMLElement>('[data-odel]');
    if (del) { saved.splice(+del.dataset.odel!, 1); saveSaved(); renderOwn(); return; }
    const ask = t.closest<HTMLElement>('[data-oask]');
    if (ask) {
      const k = ask.dataset.oask!; const box = omeals.querySelector(`[data-osave="${k}"]`)!;
      const label = k === 'bf' ? 'Mein Frühstück' : k === 'mi' ? 'Mein Mittagessen' : k === 'ab' ? 'Mein Abendessen' : 'Mein Snack';
      box.innerHTML = `<input type="text" maxlength="40" value="${label}" data-oname="${k}" aria-label="Name der Mahlzeit" /><button type="button" class="btn small soft" data-osv="${k}">Merken</button>`;
