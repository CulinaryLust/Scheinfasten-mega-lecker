  }
  // Suche je Mahlzeit (Lebensmittel und Rezepte der Seite, auch Rotes: eingetragen wird, was gegessen wurde)
  const osHits: Record<string, any[]> = {}; const osAct: Record<string, number> = {};
  function showOs(inp: HTMLInputElement) {
    const k = inp.dataset.os!;
