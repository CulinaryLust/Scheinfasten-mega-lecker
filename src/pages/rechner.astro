      const box = omeals.querySelector(`[data-osave="${k}"]`); if (box) box.innerHTML = `<span class="small" style="color:var(--green)">${I.check} Gemerkt als „${esc(name)}“.</span>`;
      return;
    }
  });
  // Ampel und Kalorien an den Tag-Knöpfen neu, wenn sich Tag oder Körperdaten ändern
  // Nur die Ampeln auffrischen, nicht neu aufbauen: sonst ginge ein Klick verloren, der gerade das Feld verlässt.
  pf.addEventListener('change', () => {
