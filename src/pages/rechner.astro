      const k = sv.dataset.osv!; const inp = omeals.querySelector(`[data-oname="${k}"]`) as HTMLInputElement;
      const name = (inp.value || 'Meine Mahlzeit').trim().slice(0, 40) || 'Meine Mahlzeit';
      const items = entriesOf(k).map((x) => ({ ...x }));
      const at = saved.findIndex((m) => m.name.toLowerCase() === name.toLowerCase());
