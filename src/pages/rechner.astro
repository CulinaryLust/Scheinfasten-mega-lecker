  renderOwn();
  /** Alle festen Mahlzeiten mit Inhalt (selbst eingetragen oder ausgewähltes Rezept), für Tagesrechnung und Ergebnis. */
  function ownMeals() {
    const o = own();
    const out: { key: string; slot: string; label: string; main: boolean; entries: Entry[]; recipe?: any }[] = [];
    for (const [k, label, slot] of FIXED) {
