  // Tageswahl und Körperdaten wirken sofort, sobald ein Ergebnis da ist
  pf.addEventListener('change', () => {
    const fd = Object.fromEntries(new FormData(pf).entries()) as any;
    try { const old = JSON.parse(localStorage.getItem('smlProfil') || 'null') || {}; localStorage.setItem('smlProfil', JSON.stringify({ ...old, inputs: { sex: fd.sex, age: fd.age, h: fd.h, w: fd.w, pal: fd.pal }, day: fd.day, bf: !!fd.bf })); } catch {}
    if (applyDay()) return;
    if (!state.shown) return;
    const v = readInputs(); if (!v) return;
    state.inputs = v; save(); render();
  });

  const pct = (x: number) => `${fmt(x)} %`;
  const devTxt = (d: number) => (d > 0 ? `+${fmt(d)}` : fmt(d));

  function render() {
    const v = state.inputs;
    const p = profile({ sex: v.sex, age: +v.age, h: +v.h, w: +v.w, pal: +v.pal });
    // Freundliche Hinweise statt Sperre: gerechnet wird immer.
    const notes: string[] = [];
    if (p.age < 18) notes.push('Du bist unter 18. In diesem Alter wächst der Körper noch, deshalb ist Scheinfasten eher nichts für Dich. Die Gerichte kannst Du trotzdem nachkochen.');
    if (p.age > 70) notes.push('Ab 70 lohnt sich vorher ein kurzes Gespräch mit Deiner Ärztin oder Deinem Arzt.');
    if (p.bmi < 18.5) notes.push(`Dein BMI liegt bei ${fmt(p.bmi, 1)}. Bei so wenig Gewicht sprich bitte vorher mit Deiner Ärztin oder Deinem Arzt.`);
    result.hidden = false;
    const day = v.day === '1' ? 1 : 2;
    const t = targets(day, p.f);
    const red = state.picks.filter((x) => BY_NAME[x.name].light === 'r');
    const ok = state.picks.filter((x) => BY_NAME[x.name].light !== 'r');
    // Mit Frühstück: passendes Frühstücksrezept (meiste eigene Zutaten) mit gut einem Fünftel der Tageskalorien, der Rest verteilt sich auf die eigenen Lebensmittel.
    const have = new Set(ok.map((x) => x.name));
    // Selbst eingetragene Mahlzeiten zählen fest mit, mit Ampel je Mahlzeit
    const owns = ownMeals().map((m) => ({ ...m, c: mealCheck(m.entries, t, +v.day, m.main) }));
    const used: Record<string, number> = {};
    for (const m of owns) for (const it of m.c.items) used[it.name] = (used[it.name] || 0) + it.g;
    const bk = own().mode.bf === 'rezept' && !own().rec.bf ? (() => {
      const r = RECIPES.filter((x: any) => x.slot === 'breakfast').map((x: any) => ({ x, sc: x.ingredients.filter((i: any) => have.has(i.name)).length })).sort((a: any, b: any) => b.sc - a.sc)[0].x;
      const portion = Math.round((t.kcal * 0.22) / nutrition(r).kcal * 20) / 20;
      return { recipe: r, portion, n: nutrition(r, portion) };
    })() : null;
    // Das Frühstück zählt als feste Menge mit, geprüft wird immer der ganze Tag gegen Longos Ziel.
    const K = ['kcal', 'protein', 'fat', 'carbs', 'sugar'] as const;
    const fixedSums = [...(bk ? [bk.n] : []), ...owns.map((m) => m.c.sum)];
    const extra = fixedSums.length ? Object.fromEntries(K.map((k) => [k, fixedSums.reduce((a, n: any) => a + (n[k] || 0), 0)])) : null;
    const sopt = extra ? { extra, used } : {};
    const res = ok.length || owns.length ? solve(ok, t, sopt) : null;
    const vd = res?.verdict;
    const adds = res ? suggestAdditions(ok, t, res, sopt) : [];
    // Reicht keine einzelne Zutat, schlagen wir ein kleines Paket aus bis zu vier Zutaten vor.
    const pack = res && !vd!.ok && !adds.some((a) => a.ok) ? completeDay(ok, t, 4, sopt) : null;
    const dayLabel = `Tag ${v.day}`;

    let tableHtml = '', tipHtml = '';
    let h = notes.length ? `<div class="alert info">${notes.map((n) => `<p>${n}</p>`).join('')}</div>` : '';
    // Kopf mit Abgleich
    if (res && vd) {
      // „Fast geschafft“ nur, wenn wirklich wenig fehlt: Kalorien höchstens 15 % daneben und Makros höchstens doppelte Toleranz
      const tolM = PLAN.reference.tolerance.macroPoints;
      const near = Math.abs(vd.dk) <= 15 && Math.abs(vd.dev.protein) <= 2 * TOL_P && Math.abs(vd.dev.fat) <= 2 * tolM && Math.abs(vd.dev.carbs) <= 2 * tolM && vd.sugarOk;
      const status = vd.ok ? `<span class="chip ok">${I.check} Passt genau zu Prof. Dr. Longo</span>` : near ? `<span class="chip warn">${I.info} Fast geschafft</span>` : vd.dk > 15 ? `<span class="chip bad">${I.info} Mehr als Dein Tagesziel</span>` : `<span class="chip warn">${I.info} Da fehlt noch etwas</span>`;
      h += `<div class="rtop">
        <div class="row"><h2 style="font-size:1.6rem">Dein ${dayLabel}</h2>${status}</div>
        <div class="vs">
          <div class="kcal"><span class="k">${I.kcal} Kalorien</span><b>${fmt(res.sum.kcal)} kcal</b><small>Ziel ${fmt(t.kcal)} kcal (${devTxt(vd.dk)} %)</small></div>
          <div class="protein"><span class="k">${I.protein} Eiweiß</span><b>${pct(vd.shares.protein)}</b><small>Ziel ${t.ref.protein} %, ${fmt(res.sum.protein)} g</small></div>
          <div class="fat"><span class="k">${I.fat} Fett</span><b>${pct(vd.shares.fat)}</b><small>Ziel ${t.ref.fat} %, ${fmt(res.sum.fat)} g</small></div>
          <div class="carbs"><span class="k">${I.carbs} Kohlenhydrate</span><b>${pct(vd.shares.carbs)}</b><small>Ziel ${t.ref.carbs} %, ${fmt(res.sum.carbs)} g</small></div>
          <div class="sugar"><span class="k">${I.sugar} Zucker</span><b>${fmt(res.sum.sugar)} g</b><small>höchstens ${fmt(vd.sugarMax)} g</small></div>
        </div>
        ${owns.length ? `<p class="small muted">Darin enthalten: ${fmt(owns.reduce((a, m) => a + m.c.sum.kcal, 0))} kcal aus Deinen eingetragenen Mahlzeiten und ausgewählten Rezepten.${ok.length ? ' Den Rest teilen wir auf Deine Lebensmittel auf.' : ''}</p>` : ''}
        <details class="small muted"><summary>Wie wir rechnen</summary><p>„Passt“ heißt: Kalorien höchstens 5 % und Fett und Kohlenhydrate höchstens 5 Prozentpunkte und Eiweiß höchstens ${TOL_P} Prozentpunkte von Prof. Dr. Longos Vorgaben entfernt (Brandhorst et al. 2015). Beim Eiweiß rechnen wir bewusst enger, weil Prof. Dr. Longo gerade das Eiweiß niedrig hält. Zucker höchstens ${PLAN_SUGAR} % der Kalorien: Prof. Dr. Longo verlangt „wenig Zucker“ ohne Grammzahl, die Grenze ist unsere Regel. Dein Ziel ist an Deinen Körper angepasst (Faktor ${fmt(p.f, 2)}, Mifflin-St-Jeor-Formel). Diese Anpassung ist unsere eigene Regel.</p></details>
      </div>`;
      if (!vd.ok) {
        const why: string[] = [];
        if (vd.dk < -5) why.push('Mit diesen Lebensmitteln wirst Du noch nicht ganz satt. Da geht noch was!');
        if (vd.dk > 5) why.push('Deine selbst eingetragenen Mengen sind etwas zu viel für heute.');
        if (vd.dev.fat < -5) why.push('Es fehlt noch etwas gutes Fett, zum Beispiel Olivenöl, Nüsse oder Oliven.');
        if (vd.dev.fat > 5) why.push('Etwas zu viel Fett. Mehr Gemüse gleicht das aus.');
        if (vd.dev.carbs < -5) why.push('Es fehlt noch etwas Sättigendes, zum Beispiel Kartoffeln, Kürbis oder Karotten.');
        if (vd.dev.carbs > 5) why.push('Etwas zu viele Kohlenhydrate. Ein Schuss Olivenöl oder ein paar Nüsse gleichen das aus.');
        if (vd.dev.protein > TOL_P) why.push('Etwas zu viel Eiweiß. Beim Scheinfasten darf es davon ruhig weniger sein.');
        if (!vd.sugarOk) why.push('Etwas zu viel Zucker, meist aus süßem Gemüse wie Kürbis, Karotten oder Roter Bete. Kartoffeln oder Hirse sättigen mit weniger Zucker.');
        if (vd.dk < -5 && !ok.length) why[0] = 'Für heute ist noch Platz. Trag eine weitere Mahlzeit ein oder lass Dir im Rezept-Generator etwas aus Deinen Vorräten vorschlagen.';
        tipHtml = `<details class="tipbox"><summary>${I.info}<span><b>Du weißt nicht, was Du noch essen könntest, oder möchtest mehr Abwechslung?</b><small>Unser Tipp, damit Dein Tag zu Prof. Dr. Longos Vorgaben passt</small></span></summary><div class="tipin">${why.map((w) => `<p>${w}</p>`).join('')}
          ${pack?.ok ? `<p>Mit ${pack.add.length === 1 ? 'dieser Zutat' : `diesen ${pack.add.length} Zutaten`} passt Dein Tag:</p><div class="alts"><button type="button" class="alt" data-addmany="${esc(pack.add.map((a) => a.name).join('|'))}">${I.plus} ${pack.add.map((a) => `${esc(a.name)} (ca. ${amount(a.name, a.g)})`).join(', ')} ✓</button></div>` : ''}
          ${adds.length ? `<p>${pack?.ok ? 'Oder einzeln, wir rechnen sofort neu:' : 'Tipp eins davon an, wir rechnen sofort neu:'}</p><div class="alts">${adds.map((a) => `<button type="button" class="alt" data-add="${esc(a.name)}">${I.plus} ${esc(a.name)} (ca. ${amount(a.name, a.g)})${a.ok ? ' ✓' : ''}</button>`).join('')}</div>` : ''}</div></details>`;
      }
      // Mengentabelle: oben die berechneten Lebensmittel, darunter fest Eingetragenes und ausgewählte Rezepte (nur lesen, ändern oben)
      const fixedBlocks = [
        ...(bk ? [{ label: `Frühstück: ${bk.recipe.title}`, items: bk.recipe.ingredients.map((i: any) => ({ name: i.name, g: i.amount * bk.portion })) }] : []),
        ...owns.map((m) => ({ label: m.recipe ? `${m.label}: ${m.recipe.title}` : `${m.label}, selbst eingetragen`, items: m.c.items })),
      ];
      const fixedRows = fixedBlocks.map((b2) => `<tbody><tr class="cat"><th colspan="3" scope="colgroup">${I.cup}${esc(b2.label)}</th></tr>${b2.items.filter((it: any) => it.g >= 0.5).map((it: any) => {
        const f = BY_NAME[it.name] || { n: (NUTRI as any)[it.name] || [0], light: 'g' };
        return `<tr class="fixed"><td class="nm"><span class="nmrow">${mac(it.name)}<span>${esc(it.name)}${BY_NAME[it.name] ? ` <span class="dot ${f.light}" title="${LIGHT[f.light]}"></span>` : ''}</span></span></td><td>${amount(it.name, it.g)}</td><td class="n">${fmt(f.n[0] * it.g / 100)}</td></tr>`;
      }).join('')}</tbody>`).join('');
      tableHtml = `<details class="stack plain amountsbox"><summary><b>Deine Tagesmengen im Detail</b> <span class="muted small">(ändere ruhig eine Zahl, wir passen den Rest an)</span></summary>
        <div class="tw"><table class="amounts"><thead><tr><th>Lebensmittel</th><th>Menge pro Tag</th><th>kcal</th></tr></thead>
        ${groupByCat(res.items, (it: any) => BY_NAME[it.name]).map((c) => `<tbody><tr class="cat"><th colspan="3" scope="colgroup">${I[c.icon]}${c.label}</th></tr>${c.items.map((it: any) => {
          const f = BY_NAME[it.name];
          const piece = f.piece && it.g ? `<small>etwa ${fmt(it.g / f.piece[1], it.g / f.piece[1] < 3 ? 1 : 0)} ${esc(f.piece[0])}</small>` : '';
          const capNote = f.light === 'y' || f.capWhy !== 'portion' ? `<small>höchstens ${amount(f.name, f.cap)} am Tag${CAP_WHY[f.capWhy] ? `, ${CAP_WHY[f.capWhy]}` : ''}</small>` : '';
          const zero = f.n[0] === 0 ? '<small>so viel Du magst</small>' : it.g === 0 ? '<small>heute nicht nötig</small>' : '';
          const input = f.n[0] === 0 ? '' : `<span class="gcell"><input type="number" inputmode="numeric" min="0" max="${f.cap}" step="5" value="${it.g}" data-g="${esc(f.name)}" aria-label="Menge ${esc(f.name)} in Gramm" /> ${unit(f.name)}</span>${it.fixed ? `<button type="button" class="reset" data-free="${esc(f.name)}">zurücksetzen</button>` : ''}`;
          return `<tr class="${it.g === 0 && f.n[0] > 0 ? 'zero' : ''}"><td class="nm"><span class="nmrow">${mac(f.name)}<span>${esc(f.name)} <span class="dot ${f.light}" title="${LIGHT[f.light]}"></span>${piece}${capNote}${zero}</span></span></td><td>${input}</td><td class="n">${fmt(f.n[0] * it.g / 100)}</td></tr>`;
        }).join('')}</tbody>`).join('')}
        ${fixedRows}
        </table></div></details>`;
      // Gelbe Hinweise
      const yellow = ok.filter((x) => BY_NAME[x.name].light === 'y');
      if (yellow.length) {
        h += `<div class="badlist">${yellow.map((x) => { const a = advice(x.name); return `<div class="alert info"><p><b>${esc(x.name)}: gern, aber nur ein bisschen.</b> ${esc(a.why)}</p></div>`; }).join('')}</div>`;
      }
    }
    // Rote Lebensmittel
    if (red.length) {
      h += `<div class="stack"><h2 style="font-size:1.6rem">Passt nicht ins Scheinfasten</h2><p class="muted small">Diese Lebensmittel heben den Fasteneffekt auf. Wir rechnen sie deshalb nicht in Deinen Tag ein.</p><div class="badlist">${red.map((x) => { const a = advice(x.name); return `<div class="alert warn"><p><b>${esc(x.name)}</b>: ${esc(a.why)}</p></div>`; }).join('')}</div></div>`;
    }
    if (res) {
      // Gerichte aus den eigenen Zutaten, nach Mahlzeit sortiert, zum Abhaken
      const meals: any[] = buildMeals(res.items).map((m: any, i: number) => ({ ...m, key: `m${i}`, kcal: m.sum.kcal }));
      // Selbst eingetragene Hauptmahlzeiten belegen ihren Platz, die berechneten Gerichte rücken auf freie Plätze.
      // Ist keiner mehr frei, landen sie als Ergänzung bei den Zwischenmahlzeiten.
      const taken = (k: string) => own().mode[k] === 'selbst' || (own().mode[k] === 'rezept' && !!own().rec[k]);
      const freeMain = (['mi', 'ab'] as const).filter((k) => !taken(k)).map((k) => (k === 'mi' ? 'Mittags' : 'Abends'));
      let gi = 0;
      for (const m of meals) {
        if (m.slot === 'Snack') { m.slot = 'Z3'; continue; }
        const s2 = freeMain[gi++]; if (s2) m.slot = s2; else { m.slot = 'Z3'; m.kind = `${m.kind}, zum Auffüllen`; }
      }
      meals.unshift(...owns.map((m) => ({ key: m.key, slot: m.slot, kind: m.recipe ? 'Dein Rezept' : 'Selbst eingetragen', title: m.recipe ? m.recipe.title : m.label, kcal: m.c.sum.kcal, sum: m.c.sum, own: m, items: [], steps: [], minutes: 0 })));
      if (bk) meals.unshift({ key: 'bf', slot: 'Morgens', kind: 'Frühstück', title: bk.recipe.title, kcal: bk.n.kcal, sum: bk.n, minutes: bk.recipe.minutes, recipe: bk.recipe,
        items: bk.recipe.ingredients.map((i: any) => ({ name: i.name, g: Math.round(i.amount * bk.portion) })), steps: [] });
      const z3gen = meals.some((m) => m.slot === 'Z3' && !m.own);
      const SLOTS: [string, string][] = [['Z0', 'Zwischenmahlzeit'], ['Morgens', 'Frühstück'], ['Z1', 'Zwischenmahlzeit'], ['Mittags', 'Mittagessen'], ['Z2', 'Zwischenmahlzeit'], ['Abends', 'Abendessen'], ['Z3', z3gen ? 'Snacks und Zwischenmahlzeiten' : 'Zwischenmahlzeit']];
      // Abgehakt gilt nur für heute: ein neuer Kalendertag (z. B. der nächste Zyklus) startet ohne Haken.
      const dk = String(v.day); const today = isoToday(); state.done = state.done || {};
      if (state.done[dk]?._d !== today) state.done[dk] = { _d: today };
      const done = state.done[dk];
      // Selbst Eingetragenes gilt als gegessen, bis jemand den Haken entfernt
      const isDone = (m: any) => (m.own && !m.own.recipe ? done[m.key] !== false : !!done[m.key]);
      const eaten = meals.filter(isDone).reduce((a2: any, m: any) => { const n2 = m.sum || (m.n as any); return { kcal: a2.kcal + m.kcal, protein: a2.protein + n2.protein, fat: a2.fat + n2.fat, carbs: a2.carbs + n2.carbs }; }, { kcal: 0, protein: 0, fat: 0, carbs: 0 });
      if (meals.length) {
        h += `<div class="stack"><h2 style="font-size:1.6rem">Deine Rezepte für heute</h2>
          <p class="muted small">Alle Mengen sind genau auf Deinen Fastentag berechnet. Salz, Pfeffer und Kräuter nach Lust und Laune. Hake ab, was Du gegessen hast. Selbst Eingetragenes zählt schon als gegessen. Der helle Teil im Balken ist eingeplant, aber noch nicht abgehakt.</p>
          ${doneHtml(eaten, t, fmt, eaten.kcal >= t.kcal * 0.95 ? ' · Tag geschafft!' : '', res.sum)}
          ${SLOTS.map(([k, lbl]) => { const ms = meals.filter((m) => m.slot === k); return ms.length ? `<h3 class="slot">${lbl}</h3><div class="meals">${ms.map((m) => m.own ? ownCard(m, isDone(m)) : `<article class="card meal${done[m.key] ? ' isdone' : ''}">
            <img class="mimg" src="${m.recipe ? thumb(base, m.recipe.image) : thumbIn(base, 'diy', m.tpl === 'fertig' ? 'suppe' : m.tpl || 'pfanne')}" alt="" loading="lazy" width="400" height="300" />
            <div class="info">
            <div class="meta"><span class="kicker">${m.kind}</span><span class="chip ok">${fmt(m.kcal)} kcal</span></div>
            <h3>${m.recipe ? `<a href="${base}rezepte/${m.recipe.slug}/">${esc(m.title)}</a>` : esc(m.title)}</h3>
            <ul class="ing">${m.items.map((i: any) => `<li>${mac(i.name)}<span>${amount(i.name, i.g)} ${esc(i.name)}</span></li>`).join('')}</ul>
            ${m.steps.length ? `<ol>${m.steps.map((st: string) => `<li>${esc(st)}</li>`).join('')}</ol>` : '<p class="small muted">Zubereitung im Rezept.</p>'}
            <p class="small muted">${I.time} etwa ${m.minutes} Minuten</p>
            <label class="tick"><input type="checkbox" data-done="${m.key}" ${done[m.key] ? 'checked' : ''}><span>Gegessen</span></label>
          </div></article>`).join('')}</div>` : ''; }).join('')}</div>`;
      }
      h += tipHtml + tableHtml;
      // Passende Rezepte der Seite, je 1 Portion, nach Mahlzeit
      const rec = matchRecipes(ok.map((x) => x.name), 24);
      if (rec.length) {
        const RS: [string, string][] = [['breakfast', 'Frühstück'], ['main', 'Mittag- und Abendessen'], ['snack', 'Snacks']];
        const card = (m: any, hidden: boolean) => `<a class="card rmatch" href="${base}rezepte/${m.recipe.slug}/"${hidden ? ' hidden data-more' : ''}>
            <img src="${thumb(base, m.recipe.image)}" alt="" loading="lazy" width="110" height="82" />
            <div class="stack" style="gap:6px"><h3>${esc(m.recipe.title)}</h3>
            <p class="small muted">1 Portion · ${fmt(m.n.kcal)} kcal · ${m.recipe.minutes} Minuten</p>
            <ul class="ing small">${m.recipe.ingredients.filter((i: any) => m.hit.includes(i.name)).map((i: any) => `<li>${amountLabel(i.name, i.amount)} ${esc(i.name)}</li>`).join('')}</ul>
            ${m.miss.length ? `<p class="small tasty">${I.plus} Mit ${m.miss.slice(0, 3).map(esc).join(', ').replace(/, ([^,]*)$/, ' und $1')} wird es noch leckerer.</p>` : '<p class="small tasty">Du hast alles da!</p>'}
            </div></a>`;
        h += `<div class="stack"><h2 style="font-size:1.6rem">Unsere Rezepte mit Deinen Zutaten</h2>
          <p class="muted small">Fertig durchgerechnet, jeweils für 1 Portion.</p>
          ${RS.map(([k, lbl]) => { const ms = rec.filter((m) => m.recipe.slot === k); return ms.length ? `<h3 class="slot">${lbl}</h3><div class="grid">${ms.map((m, i) => card(m, i >= 3)).join('')}</div>` : ''; }).join('')}
          ${RS.some(([k]) => rec.filter((m) => m.recipe.slot === k).length > 3) ? `<button type="button" class="btn soft small" data-more-btn>Weitere Rezepte anzeigen</button>` : ''}</div>`;
      }
    } else if (!red.length) {
      h += `<div class="alert info"><p>Füge oben ein paar Lebensmittel hinzu, dann geht's los.</p></div>`;
    }
    h += `<p class="hint noprint">${I.info}<span>Fühlst Du Dich schwindelig oder sehr schlapp, iss einfach normal weiter. Dein Körper geht vor.</span></p>`;
    result.innerHTML = h;
  }

  /** Karte einer selbst eingetragenen Mahlzeit im Ergebnis, mit Ampel. */
  function ownCard(m: any, isDone: boolean) {
    const c = m.own.c; const [cls, lbl] = LCHIP[c.light];
    const r = m.own.recipe;
    if (r) {
      const q = +m.own.entries[0].qty;
      return `<article class="card meal${isDone ? ' isdone' : ''}">
        <img class="mimg" src="${thumb(base, r.image)}" alt="" loading="lazy" width="400" height="300" />
        <div class="info">
          <div class="meta"><span class="kicker">${m.kind}</span><span class="chip ok">${fmt(m.kcal)} kcal</span></div>
          <h3><a href="${base}rezepte/${r.slug}/">${esc(r.title)}</a></h3>
          <p class="small muted">${portionTxt(q)}</p>
          <ul class="ing">${r.ingredients.map((i: any) => `<li>${mac(i.name)}<span>${amountLabel(i.name, i.amount * q)} ${esc(i.name)}</span></li>`).join('')}</ul>
          <p class="small muted">${I.time} etwa ${r.minutes} Minuten · Zubereitung im Rezept.</p>
          <label class="tick"><input type="checkbox" data-done="${m.key}" ${isDone ? 'checked' : ''}><span>Gegessen</span></label>
        </div></article>`;
    }
    return `<article class="card meal${isDone ? ' isdone' : ''}">
      <div class="mimg ownimg" aria-hidden="true">${I.cup}</div>
      <div class="info">
        <div class="meta"><span class="kicker">${m.kind}</span><span class="chip ok">${fmt(m.kcal)} kcal</span><span class="chip ${cls}"><span class="dot ${c.light}" aria-hidden="true"></span>${lbl}</span></div>
        <h3>${esc(m.title)}</h3>
        <ul class="ing">${m.own.entries.map((e: Entry) => `<li>${e.type === 'food' ? mac(e.name!) : '<span class="mac none" aria-hidden="true"></span>'}<span>${esc(qtyLabel(e))} ${esc(entryName(e))}</span></li>`).join('')}</ul>
        ${c.notes.length ? `<ul class="onotes">${c.notes.map((n: string) => `<li>${esc(n)}</li>`).join('')}</ul>` : ''}
        <p class="small muted">Eiweiß ${fmt(c.shares.protein)} % · Fett ${fmt(c.shares.fat)} % · Kohlenhydrate ${fmt(c.shares.carbs)} %. Ändern kannst Du sie oben bei „Deine Mahlzeiten“.</p>
        <label class="tick"><input type="checkbox" data-done="${m.key}" ${isDone ? 'checked' : ''}><span>Gegessen</span></label>
      </div></article>`;
  }

  // Interaktion im Ergebnis
  result.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const mb = t.closest<HTMLElement>('[data-more-btn]');
    if (mb) { result.querySelectorAll<HTMLElement>('[data-more]').forEach((x) => (x.hidden = false)); mb.remove(); return; }
    const many = t.closest<HTMLElement>('[data-addmany]');
    if (many) { for (const n of many.dataset.addmany!.split('|')) if (BY_NAME[n] && !state.picks.some((p) => p.name === n)) state.picks.push({ name: n }); state.done = {}; save(); renderPicked(); render(); return; }
    const b = t.closest<HTMLElement>('[data-add]');
    if (b) { addFood(b.dataset.add!); return; }
    const fr = t.closest<HTMLElement>('[data-free]');
    if (fr) { const p = state.picks.find((x) => x.name === fr.dataset.free); if (p) delete p.g; save(); render(); }
  });
  result.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.done) { const dk = String(state.inputs.day); state.done = state.done || {}; if (state.done[dk]?._d !== isoToday()) state.done[dk] = { _d: isoToday() }; state.done[dk][t.dataset.done] = t.checked; save(); const y = scrollY; render(); scrollTo({ top: y }); return; }
    if (!t.dataset.g) return;
    const p = state.picks.find((x) => x.name === t.dataset.g);
    if (!p) return;
    const cap = BY_NAME[p.name].cap;
    const g = Math.max(0, Math.min(cap, Math.round(+t.value || 0)));
    p.g = g;
    save(); render();
  });

  // Übergangstag (Tag 6): statt Rezeptrechnung die Hinweise zum Übergang und die Wahl der nächsten Durchgänge.
  const trans = document.getElementById('uebergang')!;
  const cook = document.getElementById('pane-cook')!;
  const getJ = (k: string) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch { return null; } };
  function renderTransition() {
    const plan = getJ('smlPlaner'), prof = getJ('smlProfil') || {};
    // Erster Fastentag: aus dem Plan, sonst heute minus fünf Tage (heute ist Tag 6).
    const today = new Date(); today.setHours(12, 0, 0, 0);
    const start = plan?.inputs?.start ? new Date(`${plan.inputs.start}T12:00:00`) : addDays(today, -5);
    const date = plan?.inputs?.start ? addDays(start, 5) : today;
    const cyc = +(plan?.inputs?.cyc || prof.cyc) || 1, gap = +(plan?.inputs?.gap || prof.gap) || 1;
    const bySlug = Object.fromEntries(RECIPES.map((r: any) => [r.slug, r]));
    const recs = TRANSITION_SLUGS.filter((x) => bySlug[x]).map((x) => { const r = bySlug[x]; return { href: `${base}rezepte/${x}/`, img: thumb(base, r.image), title: r.title, minutes: r.minutes }; });
    trans.innerHTML = `<div class="plain">${transitionHtml(date, recs, esc)}</div><div class="plain nextcyc">${nextCycleHtml(start, cyc, gap, I.calendar || '')}</div>`;
  }
  trans.addEventListener('change', (e) => {
    const r = e.target as HTMLInputElement; if (r.name !== 'nextcyc') return;
    const prof = getJ('smlProfil') || {}; prof.cyc = r.dataset.cyc; prof.gap = r.dataset.gap;
    try { localStorage.setItem('smlProfil', JSON.stringify(prof)); } catch {}
    const plan = getJ('smlPlaner');
    if (plan?.inputs) { plan.inputs.cyc = r.dataset.cyc; plan.inputs.gap = r.dataset.gap; try { localStorage.setItem('smlPlaner', JSON.stringify(plan)); } catch {} }
    renderTransition();
  });
  /** Zeigt am Übergangstag die Hinweise statt des Rechners; true, wenn Tag 6 gewählt ist. */
  function applyDay() {
    const six = (pf.elements.namedItem('day') as RadioNodeList).value === '6';
    trans.hidden = !six; cook.hidden = six;
    if (six) renderTransition();
    return six;
  }

  if (!applyDay() && state.shown && (state.picks.length || ownMeals().length)) { const v = readInputs(); if (v) { state.inputs = v; render(); } }
</script>

<script>
</script>
