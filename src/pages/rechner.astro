  // Suche mit Vorschlagsliste
  let hits: any[] = [];
  let active = -1;
  function showSug() {
    hits = search(q.value, 10);
    active = hits.length ? 0 : -1;
    const t = q.value.trim();
    qhint.textContent = t.length >= 2 && !hits.length ? `„${t}“ kennen wir leider noch nicht. Probier es mit einem anderen Wort, z. B. der Grundzutat.` : '';
    sug.innerHTML = hits.map((f, i) => `<li role="option" id="s${i}" aria-selected="${i === active}" data-name="${esc(f.name)}"><span class="dot ${f.light}" aria-hidden="true"></span>${mac(f.name)}${esc(f.name)}<small>${LIGHT[f.light]}</small></li>`).join('');
