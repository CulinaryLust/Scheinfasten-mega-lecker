    const zr = t.closest<HTMLElement>('[data-ozrm]');
    if (zr) { own().zw = own().zw.filter((z) => z.id !== zr.dataset.ozrm); renderOwn(); ownChanged(true); return; }
    const ld = t.closest<HTMLElement>('[data-oload]');
    if (ld) {
      const [k, i] = ld.dataset.oload!.split(':'); const m = saved[+i]; if (!m) return;
      const list = entriesOf(k);
      for (const en of m.items) list.push({ ...en });
