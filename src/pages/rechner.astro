  });
  omeals.addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement; if (!t.dataset.os) return;
    setTimeout(() => { const l = omeals.querySelector(`#osug-${t.dataset.os}`) as HTMLElement | null; if (l) l.hidden = true; t.setAttribute('aria-expanded', 'false'); }, 150);
  });
  omeals.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.ou) {
      const [k, i] = t.dataset.ou.split(':'); const en = entriesOf(k)[+i]; if (!en) return;
      const us = units(en); const from = us.find((u: any) => u[0] === en.unit) || us[0]; const to = us.find((u: any) => u[0] === t.value) || us[0];
      // Menge umrechnen, damit die Gramm gleich bleiben: 150 g werden zu 1 Becher, 1 Becher zu 150 g
      const g = +en.qty * from[2];
      en.unit = to[0]; en.qty = to[2] === 1 ? Math.round(g) : Math.max(0.5, Math.round(g / to[2] * 2) / 2);
      renderOwn(); ownChanged(true); return;
    }
    if (t.dataset.oportion) { const r0 = own().rec[t.dataset.oportion]; if (r0) r0.qty = +t.value; refreshSum(t.dataset.oportion); ownChanged(true); return; }
    if (t.dataset.oq) { ownChanged(true); }
  });
  omeals.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const om = t.closest<HTMLElement>('[data-om]');
    if (om) {
      // Nochmal antippen hebt die Wahl auf: dann planen wir die Mahlzeit
      const k = om.dataset.om!; const v = om.dataset.v!;
      own().mode[k] = own().mode[k] === v ? '' : v; own().fin[k] = false;
      if (k === 'bf') syncBf();
      renderOwn();
      if (own().mode[k] === 'selbst') (omeals.querySelector(`[data-os="${k}"]`) as HTMLInputElement | null)?.focus();
      ownChanged(true); return;
    }
    const rc = t.closest<HTMLElement>('[data-orec]');
    if (rc) { const [k, slug] = rc.dataset.orec!.split(':'); own().rec[k] = { slug, qty: portionFor(k, slug) }; renderOwn(); ownChanged(true); return; }
    const rx = t.closest<HTMLElement>('[data-orecx]');
    if (rx) { delete own().rec[rx.dataset.orecx!]; renderOwn(); ownChanged(true); return; }
    const rmore = t.closest<HTMLElement>('[data-oremore]');
    if (rmore) { recMore[rmore.dataset.oremore!] = true; const box = omeals.querySelector(`[data-orecbox="${rmore.dataset.oremore}"]`); if (box) box.innerHTML = recCards(rmore.dataset.oremore!); return; }
    const fin = t.closest<HTMLElement>('[data-ofin]');
    if (fin) { own().fin[fin.dataset.ofin!] = true; renderOwn(); save(); return; }
    const ed = t.closest<HTMLElement>('[data-oedit]');
    if (ed) { own().fin[ed.dataset.oedit!] = false; renderOwn(); save(); return; }
    const za = t.closest<HTMLElement>('[data-ozadd]');
    if (za) {
      const id = `z${Date.now().toString(36)}`;
      own().zw.push({ id, pos: +za.dataset.ozadd!, items: [] }); renderOwn();
      (omeals.querySelector(`[data-os="${id}"]`) as HTMLInputElement | null)?.focus();
