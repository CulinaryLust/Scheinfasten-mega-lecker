  const refreshSum = (k: string) => { const el = omeals.querySelector(`[data-osum="${k}"]`); if (el) el.innerHTML = sumHtml(k); };
  const syncBf = () => {
    // Der Profilwert „Mit Frühstück“ (auch im Planer genutzt) folgt dem Frühstücks-Schalter
    bfx.checked = !!own().mode.bf;
    try { const old = JSON.parse(localStorage.getItem('smlProfil') || 'null') || {}; localStorage.setItem('smlProfil', JSON.stringify({ ...old, bf: bfx.checked })); } catch {}
  };
  function addEntry(k: string, hit: any) {
    const base2 = hit.type === 'recipe' ? { type: 'recipe' as const, slug: hit.slug } : { type: 'food' as const, name: hit.name };
    const list = entriesOf(k);
    const same = list.find((e) => e.type === base2.type && (e.type === 'recipe' ? e.slug === (base2 as any).slug : e.name === (base2 as any).name));
    if (same) same.qty = +same.qty + (units(same).find((u: any) => u[0] === same.unit)?.[2] === 1 ? defaultAmount(base2).qty : 1);
    else list.push({ ...base2, ...defaultAmount(base2) });
    renderOwn();
    (omeals.querySelector(`[data-os="${k}"]`) as HTMLInputElement | null)?.focus();
