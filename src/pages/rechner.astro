    // Beim Eintragen zählt das Lebensmittel: „Avocado“ soll die Avocado sein, nicht die Kaltschale mit Avocado
    const tq = norm(inp.value);
    const pr = (h2: any) => (h2.type === 'food' && norm(h2.name).startsWith(tq) ? 0 : h2.type === 'recipe' && h2.top ? 1 : 2);
    const hs = osHits[k] = searchAll(inp.value, 8).map((h2: any, i: number) => [h2, i] as const).sort((a, b2) => pr(a[0]) - pr(b2[0]) || a[1] - b2[1]).map((x) => x[0]);
    osAct[k] = hs.length ? 0 : -1;
    list.innerHTML = hs.map((h2: any, i: number) => `<li role="option" id="os-${k}-${i}" aria-selected="${i === 0}" data-oi="${i}">${h2.type === 'recipe' ? `<span class="dot g" aria-hidden="true"></span>${esc(h2.label)}<small>Rezept, 1 Portion</small>` : `<span class="dot ${h2.light}" aria-hidden="true"></span>${mac(h2.name)}${esc(h2.label)}<small>${LIGHT[h2.light]}</small>`}</li>`).join('');
    list.hidden = !hs.length;
    inp.setAttribute('aria-expanded', String(!!hs.length));
    inp.setAttribute('aria-activedescendant', hs.length ? `os-${k}-0` : '');
  }
  omeals.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.os) { showOs(t); return; }
    if (t.dataset.orq) { const k = t.dataset.orq; recQuery[k] = t.value; const box = omeals.querySelector(`[data-orecbox="${k}"]`); if (box) box.innerHTML = recCards(k); return; }
    if (t.dataset.oq) {
      const [k, i] = t.dataset.oq.split(':'); const en = entriesOf(k)[+i]; if (!en) return;
      en.qty = Math.max(0, Math.min(5000, +t.value.replace(',', '.') || 0));
      refreshSum(k); ownChanged();
    }
  });
  omeals.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t.dataset.oload && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); t.click(); return; }
    if ((t as HTMLInputElement).dataset.oname && e.key === 'Enter') { e.preventDefault(); (omeals.querySelector(`[data-osv="${(t as HTMLInputElement).dataset.oname}"]`) as HTMLElement)?.click(); return; }
    if ((t as HTMLInputElement).dataset.orq && e.key === 'Enter') { e.preventDefault(); return; }
    const inp = t as HTMLInputElement; const k = inp.dataset.os; if (!k) return;
    const hs = osHits[k] || []; const list = omeals.querySelector(`#osug-${k}`) as HTMLElement;
    const markOs = () => { list.querySelectorAll('li').forEach((li, i) => li.setAttribute('aria-selected', String(i === osAct[k]))); inp.setAttribute('aria-activedescendant', `os-${k}-${osAct[k]}`); list.querySelector(`#os-${k}-${osAct[k]}`)?.scrollIntoView({ block: 'nearest' }); };
    if (e.key === 'ArrowDown' && hs.length) { e.preventDefault(); osAct[k] = (osAct[k] + 1) % hs.length; markOs(); }
    else if (e.key === 'ArrowUp' && hs.length) { e.preventDefault(); osAct[k] = (osAct[k] - 1 + hs.length) % hs.length; markOs(); }
    else if (e.key === 'Enter') { e.preventDefault(); if (osAct[k] >= 0 && hs[osAct[k]]) addEntry(k, hs[osAct[k]]); }
    else if (e.key === 'Escape') { list.hidden = true; inp.setAttribute('aria-expanded', 'false'); }
  });
  omeals.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-oi]'); if (!li) return;
    e.preventDefault();
    const k = li.closest('ul')!.id.replace('osug-', '');
