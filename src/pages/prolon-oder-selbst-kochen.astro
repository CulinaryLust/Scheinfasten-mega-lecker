---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import { PROLON_LINK, PROLON_PRICE, PROLON_CHECKED, pick } from '../data/affiliate.js';
import { u } from '../lib/url.js';
import { RECIPES } from '../lib/nutrition.js';
const recipeCount = RECIPES.filter((r) => ['main', 'snack', 'breakfast'].includes(r.slot)).length;
const rows = [
  ['Preis für 5 Tage', `${PROLON_PRICE} € laut Hersteller (Stand ${PROLON_CHECKED})`, 'Lebensmittel für etwa 25 bis 40 €, je nach Bio-Anteil (unsere Schätzung)'],
  ['Aufwand', 'Auspacken, aufwärmen, fertig', 'Einkaufen und täglich kochen, mit Vorkochen etwa 30 bis 45 Minuten am Tag'],
  ['Studienlage', 'Mit diesem Produkt wurden Prof. Dr. Longos Studien am Menschen gemacht', 'Gleiche Kalorien- und Nährstoffvorgaben, aber nicht in Studien getestet'],
  ['Geschmack und Abwechslung', 'Feste Auswahl an Suppen, Riegeln, Crackern, Oliven und Tees', `Frisch gekocht, ${recipeCount} Rezepte zur Auswahl, Zutaten nach Deinem Geschmack`],
  ['Anpassung an Dich', 'Eine Box für alle', 'Der Planer passt die Mengen an Größe, Gewicht und Geschlecht an'],
  ['Unverträglichkeiten', 'Zutaten fest vorgegeben', 'Du tauschst einzelne Zutaten im Rechner selbst aus'],
  ['Vitamine und Omega-3', 'Ergänzungspräparat liegt bei', 'Nicht enthalten, bei Bedarf ärztlich abklären'],
];
---
<Base title="ProLon-Alternative: selbst kochen oder Fertigbox?" active="wissen" description={`ProLon für ${PROLON_PRICE} € oder Scheinfasten selbst kochen? Ehrlicher Vergleich von Preis, Aufwand, Geschmack und Studienlage.`}>
  <div class="in page-head narrow">
    <p class="kicker">Vergleich</p>
    <h1>ProLon oder selbst kochen?</h1>
    <p class="lead">ProLon ist das Fertigpaket zum Scheinfasten, entwickelt von Prof. Dr. Valter Longo und verkauft von seiner Firma L-Nutra. Unsere Rezepte folgen denselben veröffentlichten Werten. Was passt besser zu Dir?</p>
  </div>
  <section class="band" style="padding-top:12px">
    <div class="in narrow stack">
      <div class="tw"><table>
        <thead><tr><th></th><th>ProLon</th><th>Selbst kochen</th></tr></thead>
        <tbody>{rows.map(([k, a, b]) => <tr><th scope="row">{k}</th><td data-l="ProLon">{a}</td><td data-l="Selbst kochen">{b}</td></tr>)}</tbody>
      </table></div>
      <div class="grid2">
        <div class="card">
          <h2 style="font-size:1.35rem">ProLon passt zu Dir, wenn</h2>
          <ul class="check">
            <li><Icon name="check" />Du keine Zeit oder Lust zum Kochen hast</li>
            <li><Icon name="check" />Du genau das Produkt aus den Studien willst</li>
            <li><Icon name="check" />Du unterwegs oder auf Reisen fastest</li>
          </ul>
          <p class="ad-row"><span class="ad">Anzeige</span></p>
          <a class="btn" href={PROLON_LINK} target="_blank" rel="sponsored nofollow noopener" data-goatcounter-click="partner-prolon" data-goatcounter-title="ProLon">Zu ProLon <Icon name="arrow" /></a>
        </div>
        <div class="card">
          <h2 style="font-size:1.35rem">Selbst kochen passt zu Dir, wenn</h2>
          <ul class="check">
            <li><Icon name="check" />Du gern kochst und frisch essen willst</li>
            <li><Icon name="check" />Du sparen oder öfter im Jahr fasten willst</li>
            <li><Icon name="check" />Du Zutaten selbst aussuchen oder tauschen musst</li>
          </ul>
          <a class="btn soft" href={u('planer/')}><Icon name="calendar" />Gratis-Plan erstellen</a>
        </div>
      </div>
      <p class="hint"><Icon name="heart" /><span>Egal welcher Weg: Wenn Du schwanger bist, stillst, Medikamente nimmst oder eine ernste Erkrankung hast, sprich vorher mit Deiner Ärztin oder Deinem Arzt. <a href={u('fuer-wen-nicht/')}>Für wen nicht?</a></span></p>
      <AffiliateBox items={pick('waage', 'dosen', 'tee')} title="Wenn Du selbst kochst" lead="Diese drei Dinge machen die Woche leichter." />
      <p class="muted small">Der Link zu ProLon ist ein Affiliate-Link. Wir sind kein Angebot von L-Nutra und werden von Prof. Dr. Longo weder geprüft noch unterstützt. <a href={u('transparenz/')}>Transparenz</a></p>
    </div>
  </section>
</Base>
<style>
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 18px; }
  .check { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .check li { display: flex; gap: 10px; align-items: flex-start; }
  .check :global(.i) { color: var(--green); flex: none; margin-top: 3px; }
  .card .btn { justify-self: start; }
  .ad-row { margin-top: 4px; }
  .ad { font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px; }
  th[scope="row"] { text-align: left; white-space: nowrap; text-transform: none; letter-spacing: 0; font-size: .93rem; color: var(--fg); }
  @media (max-width: 600px) {
    .tw thead { display: none; }
    .tw tr { display: grid; border-bottom: 1px solid var(--line); padding-block: 6px; }
    .tw th[scope="row"], .tw td { border: 0; padding-block: 4px; white-space: normal; }
    .tw td::before { content: attr(data-l); display: block; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  }
</style>
