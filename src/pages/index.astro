---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { RECIPES, PLAN } from '../lib/nutrition.js';
import { u } from '../lib/url.js';
const featured = ['kuerbissuppe', 'hummus-bowl', 'ofen-blumenkohl', 'zucchini-nudeln-pesto', 'rote-bete-carpaccio', 'thai-curry-bruehe'].map((s) => RECIPES.find((r) => r.slug === s));
const count = RECIPES.filter((r) => r.slot === 'main' || r.slot === 'snack').length;
---
<Base title="Start" active="start">
  <section class="hero">
    <img src={u('img/hero.jpg')} alt="" width="1800" height="1000" fetchpriority="high" />
    <div class="in">
      <p class="kicker">5 Tage Scheinfasten nach Prof. Dr. Valter Longo</p>
      <h1>Fasten, das richtig gut schmeckt.</h1>
      <p class="lead">Fünf Tage wenig Kalorien, aber jeden Tag ein echtes Essen. Unsere Rezepte halten die Vorgaben aus Longos Studien ein, und der Planer rechnet sie auf deinen Körper um.</p>
      <div class="ctas">
        <a class="btn" href={u('planer/')}><Icon name="calendar" />Meinen Plan erstellen</a>
        <a class="btn ghost" href={u('rezepte/')}>{count} Rezepte ansehen</a>
      </div>
    </div>
  </section>

  <div class="trust"><div class="in">
    <span><Icon name="book" />Nach den Studien von Prof. Dr. Valter Longo</span>
    <span><Icon name="kcal" />Jedes Rezept mit Nährwerten</span>
    <span><Icon name="leaf" />100 % pflanzlich</span>
    <span><Icon name="pot" />Frisch gekocht statt Fertigpaket</span>
  </div></div>

  <section class="band">
    <div class="in">
      <div class="head"><p class="kicker">In drei Schritten</p><h2>So einfach geht's</h2></div>
      <div class="grid3 steps">
        <div class="card"><span class="num">1</span><h3>Daten eingeben</h3><p class="muted">Geschlecht, Alter, Größe, Gewicht und Startdatum. Dauert eine Minute.</p></div>
        <div class="card"><span class="num">2</span><h3>Plan bekommen</h3><p class="muted">Für jeden Tag die Rezepte mit Grammangaben, Eiweiß, Fett und Kohlenhydraten, abgeglichen mit Longos Werten.</p></div>
        <div class="card"><span class="num">3</span><h3>Kochen und genießen</h3><p class="muted">Gericht nicht dein Fall? Tausch es. Der Planer passt die Portion an, damit alles im Rahmen bleibt.</p></div>
      </div>
      <div class="ctas" style="margin-top:26px"><a class="btn" href={u('planer/')}>Jetzt Plan erstellen <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="band tint">
    <div class="in split">
      <div class="stack">
        <p class="kicker">Was ist Scheinfasten?</p>
        <h2>Fünf Tage, die sich wie Fasten anfühlen sollen, ohne zu hungern</h2>
        <p>Scheinfasten heißt: fünf Tage lang wenig Kalorien, wenig Eiweiß und wenig Zucker, dafür Gemüse, Nüsse und Olivenöl. Entwickelt hat das Prinzip der Altersforscher <b>Prof. Dr. Valter Longo</b> an der University of Southern California.</p>
        <div class="days">
          <div><b>Tag 1</b><span>rund {PLAN.reference.day1.kcal.toLocaleString('de-DE')} kcal</span></div>
          <div><b>Tag 2 bis 5</b><span>rund {PLAN.reference.day2to5.kcal} kcal</span></div>
          <div><b>Tag 6</b><span>leichter Übergang</span></div>
        </div>
        <div class="ctas"><a class="btn soft" href={u('wissen/')}><Icon name="book" />Was die Forschung sagt</a></div>
      </div>
      <img class="rounded" src={u('img/oel.jpg')} alt="Olivenöl in einer Glasflasche neben Oliven" loading="lazy" width="1800" height="1000" />
    </div>
  </section>

  <section class="band">
    <div class="in">
      <div class="head"><p class="kicker">Beliebte Rezepte</p><h2>Darauf freust du dich</h2></div>
      <div class="grid">{featured.map((r) => <RecipeCard r={r} />)}</div>
      <div class="ctas" style="margin-top:26px"><a class="btn soft" href={u('rezepte/')}>Alle {count} Rezepte <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="band tint">
    <div class="in split">
      <img class="rounded" src={u('img/ebook.jpg')} alt="Grüne Gemüsesuppe mit Kräutern" loading="lazy" width="1800" height="1000" />
      <div class="stack">
        <p class="kicker">E-Book</p>
        <h2>Alles in einem PDF zum Ausdrucken</h2>
        <ul class="check">
          <li><Icon name="check" />Kompletter 5-Tage-Plan, jeder Tag durchgerechnet</li>
          <li><Icon name="check" />Alle Rezepte mit Schritt-für-Schritt-Anleitung</li>
          <li><Icon name="check" />Einkaufsliste und Vorkochplan</li>
        </ul>
        <p class="price">14,90 €</p>
        <div class="ctas"><a class="btn" href={u('ebook/')}>Zum E-Book</a></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="in">
      <div class="alert warn safety">
        <p><Icon name="shield" /> <b>Nicht für alle geeignet.</b> Schwangere, Stillende, Menschen unter 18 oder über 70 Jahren, mit Untergewicht, Essstörungen, Diabetes, Krebs oder anderen Erkrankungen sprechen vorher mit ihrer Ärztin oder ihrem Arzt.</p>
        <p><a href={u('fuer-wen-nicht/')}>Alle Hinweise lesen</a> · <a href={u('krebs/')}>Scheinfasten bei Krebs: Was man weiß</a></p>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero { position: relative; color: #fff; overflow: hidden; background: #24361d; }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,25,10,.85) 0%, rgba(15,25,10,.55) 55%, rgba(15,25,10,.12) 100%); }
  .hero .in { position: relative; z-index: 1; padding-block: clamp(60px, 11vw, 130px); display: grid; gap: 20px; }
  .hero h1 { max-width: 12ch; }
  .hero .lead { font-size: 1.18rem; max-width: 46ch; }
  .hero .kicker { color: var(--sun); }
  .trust { background: var(--green-d); color: #fff; }
  .trust .in { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 10px 24px; padding-block: 16px; font-weight: 600; font-size: .95rem; }
  .trust span { display: flex; gap: 8px; align-items: center; }
  .steps .num { width: 40px; height: 40px; border-radius: 50%; background: var(--tomato-soft); color: var(--tomato); font-family: var(--display); font-size: 1.3rem; display: grid; place-items: center; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: center; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
  .rounded { border-radius: 24px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .days { display: flex; gap: 10px; flex-wrap: wrap; }
  .days div { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 10px 14px; display: grid; }
  .days span { font-size: .88rem; color: var(--muted); }
  .check { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .check li { display: flex; gap: 10px; align-items: center; }
  .check :global(.i) { color: var(--green); }
  .price { font-family: var(--display); font-size: 2.4rem; }
  .safety p { display: flex; gap: 8px; align-items: flex-start; flex-wrap: wrap; }
</style>
