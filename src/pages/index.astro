---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RecipeCard from '../components/RecipeCard.astro';
import FastCompare from '../components/FastCompare.astro';
import AvoidList from '../components/AvoidList.astro';
import Effects from '../components/Effects.astro';
import { RECIPES } from '../lib/nutrition.js';
import { PROLON_PRICE } from '../data/affiliate.js';
import { u, webp } from '../lib/url.js';
import { SITE_NAME } from '../data/site.js';
const featured = ['kuerbissuppe', 'zucchini-nudeln-pesto', 'ofen-blumenkohl'].map((s) => RECIPES.find((r) => r.slug === s));
const count = RECIPES.filter((r) => ['main', 'snack', 'breakfast'].includes(r.slot)).length;
---
<Base title="Start" active="start" jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL(u(''), Astro.site).toString(), inLanguage: 'de-DE' }}>
  <section class="hero">
    <picture><source type="image/webp" srcset={webp('img/hero.jpg')} sizes="100vw" /><img src={u('img/hero.jpg')} alt="" width="1800" height="1000" fetchpriority="high" /></picture>
    <div class="in">
      <p class="kicker">5 Tage Scheinfasten nach Prof. Dr. Valter Longo</p>
      <h1>Fasten, das richtig gut schmeckt.</h1>
      <p class="lead">In einer Minute zu Deinem Plan: fünf Tage leckere Gerichte, auf das Gramm genau nach Prof. Dr. Longos Werten berechnet, mit Einkaufsliste. Kostenlos und ohne Anmeldung.</p>
      <ul class="hfx">
        <li class="eat"><a href="#unterschied"><Icon name="pot" />Fasten mit echtem Essen</a></li>
        <li class="hot"><Icon name="scale" />Auf das Gramm nach Prof. Dr. Longo</li>
        <li><Icon name="book" />Quelle zu jeder Zahl</li>
      </ul>
      <div class="ctas">
        <a class="btn" href={u('planer/')}><Icon name="calendar" />Gratis 5-Tage-Plan erstellen</a>
        <a class="btn ghost" href={u('rechner/')}>Zum Rechner</a>
      </div>
    </div>
  </section>

  <div class="trust"><div class="in">
    <span><Icon name="book" />Nach den Studien von Prof. Dr. Valter Longo</span>
    <span><Icon name="kcal" />Jedes Rezept mit Nährwerten</span>
    <span><Icon name="leaf" />100 % pflanzlich</span>
    <span><Icon name="pot" />Frisch gekocht statt Fertigpaket</span>
  </div></div>

  <FastCompare tint compact />

  <Effects compact />

  <AvoidList tint compact />

  <section class="band">
    <div class="in">
      <div class="head"><p class="kicker">So funktioniert's</p><h2>Zwei Wege durch Deine Fastenwoche</h2></div>
      <div class="ways">
        <article class="way main">
          <p class="wtag"><Icon name="calendar" />Weg 1: Dein fertiger 5-Tage-Plan</p>
          <ol class="wsteps">
            <li><span class="n">1</span><div><b>Kurz über Dich</b><span>Größe, Gewicht, Startdatum. Dauert eine Minute.</span></div></li>
            <li><span class="n">2</span><div><b>Plan ansehen</b><span>Jeden Tag Gerichte aus {count} Rezepten, mit Mengen passend zu Dir. Was Dir nicht schmeckt, tauschst Du.</span></div></li>
            <li><span class="n">3</span><div><b>Einkaufen und loskochen</b><span>Einkaufsliste für alle fünf Tage, auch für bis zu vier Personen.</span></div></li>
          </ol>
          <div class="ctas"><a class="btn" href={u('planer/')}>Plan erstellen <Icon name="arrow" /></a><a class="wlink" href={u('rezepte/')}>Erst Rezepte ansehen</a></div>
        </article>
        <article class="way">
          <p class="wtag"><Icon name="scale" />Weg 2: Deine eigenen Lebensmittel</p>
          <ol class="wsteps">
            <li><span class="n">1</span><div><b>Zutaten eingeben</b><span>Einfach eintippen, was im Kühlschrank liegt oder was Du schon gegessen hast.</span></div></li>
            <li><span class="n">2</span><div><b>Mengen und Kalorien sehen</b><span>Grammgenau nach Prof. Dr. Longo, mit Ampel für jedes Lebensmittel.</span></div></li>
            <li><span class="n">3</span><div><b>Passende Gerichte</b><span>Rezeptideen aus Deinen Zutaten und ein leckerer Tausch, wenn etwas nicht passt.</span></div></li>
          </ol>
          <div class="ctas"><a class="btn soft" href={u('rechner/')}>Zum Rechner <Icon name="arrow" /></a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="band tint">
    <div class="in">
      <div class="head"><p class="kicker">Beliebte Rezepte</p><h2>Darauf freust Du Dich</h2></div>
      <div class="grid">{featured.map((r) => <RecipeCard r={r} />)}</div>
      <div class="ctas" style="margin-top:26px"><a class="btn soft" href={u('rezepte/')}>Alle {count} Rezepte <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="band">
    <div class="in split">
      <picture><source type="image/webp" srcset={webp('img/ebook.jpg')} sizes="(max-width: 820px) 92vw, 560px" /><img class="rounded" src={u('img/ebook.jpg')} alt="Grüne Gemüsesuppe mit Kräutern" loading="lazy" width="1800" height="1000" /></picture>
      <div class="stack">
        <p class="kicker">Ehrlich verglichen</p>
        <h2>ProLon oder selbst kochen?</h2>
        <ul class="check">
          <li><Icon name="check" />Fertigbox für {PROLON_PRICE} € oder Lebensmittel für etwa 25 bis 40 €</li>
          <li><Icon name="check" />Was die Studien zeigen und was nicht</li>
          <li><Icon name="check" />Für wen sich welcher Weg lohnt</li>
        </ul>
        <div class="ctas"><a class="btn" href={u('prolon-oder-selbst-kochen/')}>Zum Vergleich</a><a class="btn soft" href={u('ausstattung/')}>Ausstattung</a></div>
      </div>
    </div>
    <div class="in"><p class="hint safety"><Icon name="heart" /><span><b>Gut zu wissen:</b> Wenn Du schwanger bist, stillst, unter 18 bist, Medikamente nimmst oder eine ernste Erkrankung hast, sprich vorher kurz mit Deiner Ärztin oder Deinem Arzt. <a href={u('fuer-wen-nicht/')}>Mehr dazu</a></span></p></div>
  </section>

</Base>
<style>
  .hero { position: relative; color: #fff; overflow: hidden; background: #24361d; }
  .hero > picture img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,25,10,.85) 0%, rgba(15,25,10,.55) 55%, rgba(15,25,10,.12) 100%); }
  .hero .in { position: relative; z-index: 1; padding-block: clamp(60px, 11vw, 130px); display: grid; gap: 20px; }
  .hero h1 { max-width: 12ch; }
  .hero .lead { font-size: 1.18rem; max-width: 46ch; }
  .hero .kicker { color: var(--sun); }
  .trust { background: var(--green-d); color: #fff; }
  .trust .in { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 10px 24px; padding-block: 16px; font-weight: 600; font-size: .95rem; }
  .trust span { display: flex; gap: 8px; align-items: center; }
  .ways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 820px) { .ways { grid-template-columns: 1fr; gap: 14px; } }
  .way { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(18px, 3vw, 26px); display: grid; gap: 16px; align-content: start; }
  .way.main { border: 2px solid var(--tomato); }
  .wtag { display: flex; gap: 8px; align-items: center; font-size: .8rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--tomato); }
  .wsteps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .wsteps li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: start; }
  .wsteps .n { width: 30px; height: 30px; border-radius: 9px; background: var(--tomato); color: var(--on-tomato); font: 800 .95rem/1 var(--body); display: grid; place-items: center; transform: rotate(-4deg); box-shadow: 0 3px 0 var(--tomato-d); }
  .wsteps div { display: grid; gap: 2px; }
  .wsteps b { font-size: 1.05rem; }
  .wsteps div span { color: var(--muted); font-size: .93rem; }
  .way .ctas { align-items: center; margin-top: 2px; }
  .wlink { font-weight: 700; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: center; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
  .rounded { border-radius: 24px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .check { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .check li { display: flex; gap: 10px; align-items: center; }
  .check :global(.i) { color: var(--green); }
  .safety { margin-top: 40px; }
  .safety p { display: flex; gap: 8px; align-items: flex-start; flex-wrap: wrap; }
  .hfx { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hfx li { display: inline-flex; gap: 6px; align-items: center; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.32); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); box-shadow: inset 0 1px 0 rgba(255,255,255,.35); border-radius: 999px; padding: 6px 12px; font-weight: 700; font-size: .92rem; }
  .hfx :global(.i) { color: var(--sun); }
  .hfx li.hot { background: var(--tomato); border-color: var(--tomato); }
  .hfx li.eat { background: var(--sun); border-color: var(--sun); }
  .hfx li.eat a { color: #24361d; text-decoration: none; display: inline-flex; gap: 6px; align-items: center; }
  .hfx li.eat :global(.i) { color: #24361d; }
  .hfx li.hot :global(.i) { color: #fff; }
</style>
