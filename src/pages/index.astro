---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RecipeCard from '../components/RecipeCard.astro';
import FastCompare from '../components/FastCompare.astro';
import AvoidList from '../components/AvoidList.astro';
import Effects from '../components/Effects.astro';
import { RECIPES } from '../lib/nutrition.js';
import { u } from '../lib/url.js';
const featured = ['kuerbissuppe', 'zucchini-nudeln-pesto', 'ofen-blumenkohl'].map((s) => RECIPES.find((r) => r.slug === s));
const count = RECIPES.filter((r) => r.slot === 'main' || r.slot === 'snack').length;
---
<Base title="Start" active="start">
  <section class="hero">
    <img src={u('img/hero.jpg')} alt="" width="1800" height="1000" fetchpriority="high" />
    <div class="in">
      <p class="kicker">5 Tage Scheinfasten nach Prof. Dr. Valter Longo</p>
      <h1>Fasten, das richtig gut schmeckt.</h1>
      <p class="lead">Sag uns, was im Kühlschrank liegt. Wir rechnen es auf das Gramm genau nach Longos Werten aus und machen leckere Gerichte daraus.</p>
      <ul class="hfx">
        <li class="eat"><a href="#unterschied"><Icon name="pot" />Fasten mit echtem Essen</a></li>
        <li class="hot"><Icon name="inflam" />Entzündungswerte runter</li>
        <li><Icon name="tape" />−4 cm Taille</li>
      </ul>
      <div class="ctas">
        <a class="btn" href={u('rechner/')}><Icon name="scale" />Zum Rechner</a>
        <a class="btn ghost" href={u('planer/')}>5-Tage-Plan erstellen</a>
      </div>
    </div>
  </section>

  <div class="trust"><div class="in">
    <span><Icon name="book" />Nach den Studien von Prof. Dr. Valter Longo</span>
    <span><Icon name="kcal" />Jedes Rezept mit Nährwerten</span>
    <span><Icon name="leaf" />100 % pflanzlich</span>
    <span><Icon name="pot" />Frisch gekocht statt Fertigpaket</span>
  </div></div>

  <FastCompare tint compact />

  <Effects compact />

  <AvoidList tint compact />

  <section class="band">
    <div class="in">
      <div class="head"><p class="kicker">In drei Schritten</p><h2>So einfach geht's</h2></div>
      <div class="grid3 steps">
        <div class="card"><span class="num">1</span><h3>Kurz über dich</h3><p class="muted">Größe, Gewicht, Fastentag. Dauert eine Minute.</p></div>
        <div class="card"><span class="num">2</span><h3>Zutaten eingeben</h3><p class="muted">Was liegt im Kühlschrank? Wir rechnen aus, wie viel davon in deinen Tag passt, genau nach Longo.</p></div>
        <div class="card"><span class="num">3</span><h3>Kochen und genießen</h3><p class="muted">Du bekommst passende Gerichte mit Grammangaben. Etwas passt nicht? Wir schlagen dir einen leckeren Tausch vor.</p></div>
      </div>
      <div class="ctas" style="margin-top:26px"><a class="btn" href={u('rechner/')}>Jetzt ausprobieren <Icon name="arrow" /></a><a class="btn soft" href={u('planer/')}>Lieber einen fertigen 5-Tage-Plan</a></div>
    </div>
  </section>

  <section class="band tint">
    <div class="in">
      <div class="head"><p class="kicker">Beliebte Rezepte</p><h2>Darauf freust du dich</h2></div>
      <div class="grid">{featured.map((r) => <RecipeCard r={r} />)}</div>
      <div class="ctas" style="margin-top:26px"><a class="btn soft" href={u('rezepte/')}>Alle {count} Rezepte <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="band">
    <div class="in split">
      <img class="rounded" src={u('img/ebook.jpg')} alt="Grüne Gemüsesuppe mit Kräutern" loading="lazy" width="1800" height="1000" />
      <div class="stack">
        <p class="kicker">E-Book</p>
        <h2>Alles in einem PDF zum Ausdrucken</h2>
        <ul class="check">
          <li><Icon name="check" />Kompletter 5-Tage-Plan, jeder Tag durchgerechnet</li>
          <li><Icon name="check" />Alle Rezepte mit Schritt-für-Schritt-Anleitung</li>
          <li><Icon name="check" />Einkaufsliste und Vorkochplan</li>
        </ul>
        <p class="price">14,90 €</p>
        <div class="ctas"><a class="btn" href={u('ebook/')}>Zum E-Book</a></div>
      </div>
    </div>
    <div class="in"><p class="hint safety"><Icon name="heart" /><span><b>Gut zu wissen:</b> Wenn du schwanger bist, stillst, unter 18 bist, Medikamente nimmst oder eine ernste Erkrankung hast, sprich vorher kurz mit deiner Ärztin oder deinem Arzt. <a href={u('fuer-wen-nicht/')}>Mehr dazu</a></span></p></div>
  </section>

</Base>
<style>
  .hero { position: relative; color: #fff; overflow: hidden; background: #24361d; }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,25,10,.85) 0%, rgba(15,25,10,.55) 55%, rgba(15,25,10,.12) 100%); }
  .hero .in { position: relative; z-index: 1; padding-block: clamp(60px, 11vw, 130px); display: grid; gap: 20px; }
  .hero h1 { max-width: 12ch; }
  .hero .lead { font-size: 1.18rem; max-width: 46ch; }
  .hero .kicker { color: var(--sun); }
  .trust { background: var(--green-d); color: #fff; }
  .trust .in { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 10px 24px; padding-block: 16px; font-weight: 600; font-size: .95rem; }
  .trust span { display: flex; gap: 8px; align-items: center; }
  .steps .num { width: 40px; height: 40px; border-radius: 50%; background: var(--tomato-soft); color: var(--tomato); font-family: var(--display); font-size: 1.3rem; display: grid; place-items: center; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: center; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
  .rounded { border-radius: 24px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .check { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .check li { display: flex; gap: 10px; align-items: center; }
  .check :global(.i) { color: var(--green); }
  .price { font-family: var(--display); font-size: 2.4rem; }
  .safety { margin-top: 40px; }
  .safety p { display: flex; gap: 8px; align-items: flex-start; flex-wrap: wrap; }
  .hfx { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hfx li { display: inline-flex; gap: 6px; align-items: center; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.3); backdrop-filter: blur(4px); border-radius: 999px; padding: 6px 12px; font-weight: 700; font-size: .92rem; }
  .hfx :global(.i) { color: var(--sun); }
  .hfx li.hot { background: var(--tomato); border-color: var(--tomato); }
  .hfx li.eat { background: var(--sun); border-color: var(--sun); }
  .hfx li.eat a { color: #24361d; text-decoration: none; display: inline-flex; gap: 6px; align-items: center; }
  .hfx li.eat :global(.i) { color: #24361d; }
  .hfx li.hot :global(.i) { color: #fff; }
</style>
